<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>OpenAI provider adapter for Tracon. Model catalog, IChatClient creation and OpenAI specific run options.</Description>
    <PackageTags>$(CommonPackageTags);openai;gpt;provider</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Tracon.Core/Tracon.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
  </ItemGroup>

  <!--
    Shared source. Tracon.Providers.Shared is NOT a package; the same
    files also compile into the other three provider adapters. Rationale and
    rules: src/Tracon.Providers.Shared/README.md.
  -->
  <ItemGroup Label="Shared provider source">
    <Compile Include="../Tracon.Providers.Shared/**/*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!--
    Shared source for the two packages built on the OpenAI client library
    (Tracon.OpenAI and Tracon.Azure). Not a package. Rules:
    src/Tracon.OpenAI.Shared/README.md.
  -->
  <ItemGroup Label="Shared OpenAI client source">
    <Compile Include="../Tracon.OpenAI.Shared/**/*.cs" LinkBase="OpenAIShared" />
  </ItemGroup>

</Project>
