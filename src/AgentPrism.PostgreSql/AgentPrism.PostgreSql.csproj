<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>PostgreSQL persistence layer for AgentPrism. Agent definitions, sessions, conversations, runs, and events are stored in a separate 'agentprism' schema. Ships with embedded SQL migrations.</Description>
    <PackageTags>$(CommonPackageTags);postgresql;postgres;npgsql;persistence</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentPrism.Core/AgentPrism.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup Label="Embedded SQL migrations (Phase 2)">
    <EmbeddedResource Include="Migrations/**/*.sql" />
  </ItemGroup>

  <!--
    Optional migration set (Phase 67): applied only when EnableKnowledge is
    turned on, because it needs the pgvector extension. Kept in a SEPARATE
    folder (and therefore a separate embedded-resource prefix) so
    MigrationDescriptor.Discover can select it independently of the core set.
  -->
  <ItemGroup Label="Optional 'knowledge' migration set (Phase 67)">
    <EmbeddedResource Include="MigrationsKnowledge/**/*.sql" />
  </ItemGroup>

  <!--
    Shared source (Phase 23). AgentPrism.Sql.Shared is NOT a package and has no
    csproj file of its own; its files compile directly here and into
    AgentPrism.SqlServer. This way store logic lives in one place without
    publishing a third NuGet package. Rationale: docs/KARARLAR.md, decision K-176.
  -->
  <ItemGroup Label="Shared SQL source (Phase 23)">
    <Compile Include="../AgentPrism.Sql.Shared/**/*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
