<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>AgentPrism icin PostgreSQL kalicilik katmani. Agent tanimlari, oturumlar, konusmalar, calistirmalar ve olaylar ayri bir 'agentprism' semasinda saklanir. Gomulu SQL migration'lari ile gelir.</Description>
    <PackageTags>$(CommonPackageTags);postgresql;postgres;npgsql;persistence</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentPrism.Core/AgentPrism.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup Label="Gomulu SQL migration'lari (Faz 2)">
    <EmbeddedResource Include="Migrations/**/*.sql" />
  </ItemGroup>

  <!--
    Paylasilan kaynak (Faz 23). AgentPrism.Sql.Shared bir paket DEGILDIR ve kendi
    csproj dosyasi yoktur; dosyalar buraya ve AgentPrism.SqlServer'a dogrudan
    derlenir. Boylece depo mantigi tek yerde yasar ama ucuncu bir NuGet paketi
    yayinlanmaz. Gerekce: docs/KARARLAR.md, karar K-176.
  -->
  <ItemGroup Label="Paylasilan SQL kaynagi (Faz 23)">
    <Compile Include="../AgentPrism.Sql.Shared/**/*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
