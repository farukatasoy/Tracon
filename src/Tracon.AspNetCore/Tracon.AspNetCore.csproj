<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Tracon HTTP layer. MapTracon connects the management API and the OpenAI-compatible run endpoints. Includes layered access protection: loopback by default, bearer token, ASP.NET Core authorization policy.</Description>
    <PackageTags>$(CommonPackageTags);aspnetcore;api;openai-compatible;responses</PackageTags>
    <!-- Minimal API delegate routing uses reflection; AOT cannot be promised. -->
    <TraconAotCompatible>false</TraconAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Tracon.Core/Tracon.Core.csproj" />
  </ItemGroup>

  <!--
    Phase 265: the two-node acceptance set drives the management API of two hosts that share a SQL database. It reuses
    the functional tests' request builders (the workflow save request among them), so it reaches the same internals.
  -->
  <ItemGroup Label="Internal visibility - two-node acceptance tests">
    <InternalsVisibleTo Include="Tracon.TwoNode.IntegrationTests" />
  </ItemGroup>

  <!--
    Tracon.UI registers the ITraconUiProvider that MapTracon serves the
    management UI through. The interface is a first-party plumbing seam: the
    asset list, caching and fallback rules belong to the one shipped
    implementation, and no guide or sample asks a consumer to write another.
    The end-to-end UI test host builds the same registration.
  -->
  <ItemGroup Label="Internal visibility - management UI package and its end-to-end tests">
    <InternalsVisibleTo Include="Tracon.UI" />
    <InternalsVisibleTo Include="Tracon.Ui.E2ETests" />
  </ItemGroup>

  <!--
    Phase 236: Tracon.AGUI is a second run surface. It shares the run turn (the gates, the agent resolution, the
    answer matching, the run options) with the management API through AgentTurnService instead of copying it, and
    it maps through the same role, API key and session ownership rules. Those are internal on purpose: no
    consumer is asked to write another surface, so the seam is not public.
  -->
  <ItemGroup Label="Internal visibility - AG-UI endpoint package">
    <InternalsVisibleTo Include="Tracon.AGUI" />
  </ItemGroup>

  <!--
    Phase 74: the OpenAPI document travels with the package that serves the
    endpoints it describes, and Tracon.AspNetCore.targets hands its path to
    the local reference file. No dependency is added - this is a static JSON
    file - so K-039 is untouched.

    The document is packed FROM ITS SOURCE under docs/openapi. A copy inside
    this project would be a second surface that can drift, and
    OpenApiSnapshotTests already pins the source against a running host.

    🚨 `Update` does NOT work here, and the failure is silent: the SDK's default
    None glob is applied only in the INNER (TFM-specific) builds, while `dotnet
    pack` collects package files in the OUTER cross-targeting build. Remove +
    Include is the working form. See Tracon.Core.csproj for the measurement.

    🚨 The file name is a contract: NuGet auto-imports only
    buildTransitive/<PackageId>.props and buildTransitive/<PackageId>.targets.
    A different name packs cleanly and is then never imported.
  -->
  <ItemGroup>
    <None Remove="buildTransitive/**" />
    <None Include="buildTransitive/Tracon.AspNetCore.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="../../docs/openapi/tracon.json" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

  <!--
    NOTE: These two packages are pre-release (preview / alpha).
    All of Tracon's pre-release MAF dependencies are deliberately
    consolidated into this single package. This keeps Tracon.Abstractions,
    .Core, .PostgreSql, and .OpenAI dependent only on GA packages. Rationale:
    docs/KARARLAR.md, decision K-008.
  -->
  <ItemGroup Label="Pre-release MAF dependencies">
    <PackageReference Include="Microsoft.Agents.AI.Hosting" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.OpenAI" />
    <!-- Phase 50: A2A exposure server. Rationale: Directory.Packages.props. -->
    <PackageReference Include="Microsoft.Agents.AI.Hosting.A2A" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AspNetCore" />
    <PackageReference Include="A2A.AspNetCore" />
  </ItemGroup>

  <!--
    MCP server (Phase 50). GA package; NOT in the pre-release group. Lives
    only here per K-057 — Tracon.Mcp (client) stays in `.Core`.
  -->
  <ItemGroup Label="Model Context Protocol - server">
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <!-- Phase 117: MCP Tasks extension. Net new transitive weight: zero (Directory.Packages.props). -->
    <PackageReference Include="ModelContextProtocol.Extensions.Tasks" />
  </ItemGroup>

</Project>
