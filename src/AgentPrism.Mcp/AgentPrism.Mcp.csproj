<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Model Context Protocol client for AgentPrism. It discovers tools from remote MCP servers and lists them with code-registered tools. It requires approval by default.</Description>
    <PackageTags>$(CommonPackageTags);mcp;model-context-protocol;tools</PackageTags>
    <!--
      MCP tool schemas resolve at run time and ModelContextProtocol.Core uses
      reflection for JSON serialization, so this package cannot promise AOT compatibility.
    -->
    <AgentPrismAotCompatible>false</AgentPrismAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentPrism.Core/AgentPrism.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" />
  </ItemGroup>

</Project>
