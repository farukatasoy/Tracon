<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>AgentPrism HTTP katmani. MapAgentPrism ile yonetim API'sini ve OpenAI uyumlu calistirma uclarini baglar. Katmanli erisim korumasi icerir: loopback varsayilan, bearer token, ASP.NET Core authorization policy.</Description>
    <PackageTags>$(CommonPackageTags);aspnetcore;api;openai-compatible;responses</PackageTags>
    <!-- Minimal API delege yonlendirmesi reflection kullanir; AOT vaadi verilemez. -->
    <AgentPrismAotCompatible>false</AgentPrismAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentPrism.Core/AgentPrism.Core.csproj" />
  </ItemGroup>

  <!--
    DIKKAT: Bu iki paket onsurumdur (preview / alpha).
    AgentPrism'in tum onsurum MAF bagimliligi bilerek bu tek pakette toplanmistir.
    Boylece AgentPrism.Abstractions, .Core, .PostgreSql ve .OpenAI yalnizca GA
    paketlere bagli kalir. Gerekce: docs/KARARLAR.md, karar K-008.
  -->
  <ItemGroup Label="Onsurum MAF bagimliliklari">
    <PackageReference Include="Microsoft.Agents.AI.Hosting" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.OpenAI" />
  </ItemGroup>

</Project>
