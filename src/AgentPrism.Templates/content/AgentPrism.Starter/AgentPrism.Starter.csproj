<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgentPrism.Starter</RootNamespace>
    <UserSecretsId>agentprism-starter-10000000-0000-0000-0000-000000000001</UserSecretsId>
    <!--
      🚨 InvariantGlobalization is NEVER enabled. `Microsoft.Data.SqlClient` does
      NOT SUPPORT Globalization Invariant Mode; this template offers the
      UseSqlServer option, and a project generated with that option would NEVER
      start (`SqlConnection.Open` throws a `NotSupportedException`). The template
      goes straight to the consumer; the defect would go straight there too.
      Measured (manual test MT-SQL-024).
      Rationale: docs/KARARLAR.md, decision K-392.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AgentPrism" Version="AGENTPRISM_TEMPLATE_PACKAGE_VERSION" />
<!--#if (UseSqlServer) -->
    <PackageReference Include="AgentPrism.SqlServer" Version="AGENTPRISM_TEMPLATE_PACKAGE_VERSION" />
<!--#endif -->
<!--#if (UseSqlite) -->
    <PackageReference Include="AgentPrism.Sqlite" Version="AGENTPRISM_TEMPLATE_PACKAGE_VERSION" />
<!--#endif -->
<!--#if (UseAnthropic) -->
    <PackageReference Include="AgentPrism.Anthropic" Version="AGENTPRISM_TEMPLATE_PACKAGE_VERSION" />
<!--#endif -->
<!--#if (UseGoogle) -->
    <PackageReference Include="AgentPrism.Google" Version="AGENTPRISM_TEMPLATE_PACKAGE_VERSION" />
<!--#endif -->
<!--#if (UseAzure) -->
    <PackageReference Include="AgentPrism.Azure" Version="AGENTPRISM_TEMPLATE_PACKAGE_VERSION" />
<!--#endif -->
  </ItemGroup>

</Project>
