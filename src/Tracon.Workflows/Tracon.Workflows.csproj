<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Workflow execution engine for Tracon. Agents from the catalog are chained together with the Sequential, Concurrent, Handoff, GroupChat, and Magentic patterns; every execution is recorded in the runs table and can be resumed from checkpoints.</Description>
    <PackageTags>$(CommonPackageTags);workflow;orchestration;multi-agent</PackageTags>
    <!--
      The Microsoft.Agents.AI.Workflows execution engine uses reflection
      (ReflectingExecutor, TypeId, PortableValue); no AOT guarantee can be made.
    -->
    <TraconAotCompatible>false</TraconAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Tracon.Core/Tracon.Core.csproj" />
    <!--
      OutputItemType=Analyzer does not propagate across a multi-hop
      ProjectReference chain: Core
      already references Tracon.Generators this way, but that reference is
      not transitive, so Workflows needs its own. A real (package) consumer is
      unaffected - the analyzer reaches them through analyzers/dotnet/cs/ in
      Core's nupkg, which IS transitive.
    -->
    <ProjectReference Include="../Tracon.Generators/Tracon.Generators.csproj"
                       PrivateAssets="all"
                       ReferenceOutputAssembly="false"
                       OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
  </ItemGroup>

  <!--
    The two-node acceptance set runs the workflow cancellation sweep on PostgreSQL and SQL Server. The sweep is the one the
    unit tests run in memory, and it drives the runner, its catalog and its compiler directly, to cancel a run at each of
    its awaited calls; none of them is a consumer seam. The default test-project names (the project's own name followed
    by .UnitTests or .IntegrationTests) do not cover a project that carries another name.
  -->
  <ItemGroup Label="Internal visibility - two-node acceptance tests">
    <InternalsVisibleTo Include="Tracon.TwoNode.IntegrationTests" />
  </ItemGroup>

</Project>
