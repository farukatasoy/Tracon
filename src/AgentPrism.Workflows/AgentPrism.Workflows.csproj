<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Workflow execution engine for AgentPrism. Agents from the catalog are chained together with the Sequential, Concurrent, Handoff, GroupChat, and Magentic patterns; every execution is recorded in the runs table and can be resumed from checkpoints.</Description>
    <PackageTags>$(CommonPackageTags);workflow;orchestration;multi-agent</PackageTags>
    <!--
      The Microsoft.Agents.AI.Workflows execution engine uses reflection
      (ReflectingExecutor, TypeId, PortableValue); no AOT guarantee can be made.
    -->
    <AgentPrismAotCompatible>false</AgentPrismAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentPrism.Core/AgentPrism.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <!-- So UseWorkflows() can bind AgentPrismWorkflowOptions to IConfiguration (K-402). -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>
