<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>AgentPrism meta package. A production-grade agent control plane built on Microsoft Agent Framework, with PostgreSQL support and an embedded management UI. This package brings in all AgentPrism components with a single reference.</Description>
    <PackageTags>$(CommonPackageTags);meta;all-in-one</PackageTags>
    <!-- The meta package carries no code; the build output is not packed, to avoid an empty assembly. -->
    <AgentPrismAotCompatible>false</AgentPrismAotCompatible>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="All AgentPrism components">
    <ProjectReference Include="../AgentPrism.AspNetCore/AgentPrism.AspNetCore.csproj" />
    <ProjectReference Include="../AgentPrism.Mcp/AgentPrism.Mcp.csproj" />
    <ProjectReference Include="../AgentPrism.OpenAI/AgentPrism.OpenAI.csproj" />
    <ProjectReference Include="../AgentPrism.PostgreSql/AgentPrism.PostgreSql.csproj" />
    <ProjectReference Include="../AgentPrism.UI/AgentPrism.UI.csproj" />
    <ProjectReference Include="../AgentPrism.Workflows/AgentPrism.Workflows.csproj" />
  </ItemGroup>

</Project>
