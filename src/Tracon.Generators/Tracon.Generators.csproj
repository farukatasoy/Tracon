<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The source generator loads into the compiler (csc); its target must be
    netstandard2.0 (Roslyn's own runtime requirement). The net8.0;net9.0;net10.0
    inherited from src/Directory.Build.props is DELIBERATELY overridden here.

    This project is NOT PACKED: it ships inside Tracon.Core's nupkg under
    analyzers/dotnet/cs/ (52.4). It is part of the slnx but `dotnet pack` skips it.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Clear the plural TargetFrameworks inherited from src/Directory.Build.props (K-263 pattern). -->
    <TargetFrameworks></TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- No consumer-facing API surface - it ships a diagnostic/generator, not a library. -->
    <TraconPublicApiTrackingEnabled>false</TraconPublicApiTrackingEnabled>
    <!-- Turn off IsAotCompatible through TraconAotCompatible, not DIRECTLY (K-006 pattern; Directory.Build.targets reads this). -->
    <TraconAotCompatible>false</TraconAotCompatible>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
    <Description>Build-time Roslyn source generator for Tracon [TraconTool]. Not packed; the DLL ships inside Tracon.Core's nupkg.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Label="Internal visibility - test project">
    <InternalsVisibleTo Include="Tracon.Generators.UnitTests" />
  </ItemGroup>

</Project>
