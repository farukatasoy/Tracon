<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>SQL Server persistence layer for Tracon. Agent definitions, sessions, conversations, runs, and events are stored in a separate 'tracon' schema. Ships with embedded SQL migrations. SQL Server 2019+ and Azure SQL.</Description>
    <PackageTags>$(CommonPackageTags);sqlserver;mssql;azure-sql;persistence</PackageTags>
  </PropertyGroup>

  <!--
    AOT status MEASURED (2026-08-04, Microsoft.Data.SqlClient 7.0.2, net10.0):
    a console application calling UseSqlServer() was published with
    `PublishAot=true` under
    `-p:TrimmerSingleWarn=false -p:SuppressTrimAnalysisWarnings=false`.
    Result: ZERO IL2xxx/IL3xxx warnings; a native binary was produced and ran
    (IRunStore was resolved from DI).

    The flag is nonetheless DELIBERATELY false: even though static analysis is
    clean, the query path against a LIVE server has not yet been verified
    under AOT (the SQL Server container could not be run on
    this machine at the time). SqlClient's Azure AD authentication providers
    also rely on reflection and are a path a consumer can use. The library
    only makes a promise once it can verify it; the flag can be turned on
    after live verification.

  -->
  <PropertyGroup Label="Trim / AOT">
    <TraconAotCompatible>false</TraconAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Tracon.Core/Tracon.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- CVE zorlamasi (Directory.Packages.props, SqlClient satirinin altindaki not). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup Label="Embedded SQL migrations">
    <EmbeddedResource Include="Migrations/**/*.sql" />
  </ItemGroup>

  <!--
    Optional migration set: applied only when EnableReadViews is
    turned on. A published view is a permanent data contract, so it is opt-in
    (same reasoning as PostgreSQL's "knowledge" set).
  -->
  <ItemGroup Label="Optional 'views' migration set">
    <EmbeddedResource Include="MigrationsViews/**/*.sql" />
  </ItemGroup>

  <!--
    Shared source. Tracon.Sql.Shared is NOT a package; the same
    files also compile into Tracon.PostgreSql.
  -->
  <ItemGroup Label="Shared SQL source">
    <Compile Include="../Tracon.Sql.Shared/**/*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!--
    Tracon.Sql.Shared.UnitTests checks the SQL text of the three
    providers side by side and cannot use the "$(MSBuildProjectName).UnitTests"
    convention below (that name belongs to a single provider). No Docker
    dependency: it never opens a connection, only builds a query-set object.
  -->
  <ItemGroup Label="Internal visibility - cross-provider SQL text tests">
    <InternalsVisibleTo Include="Tracon.Sql.Shared.UnitTests" />
  </ItemGroup>

</Project>
