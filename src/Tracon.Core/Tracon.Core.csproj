<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Tracon core runtime. Agent catalog, definition compiler, tool registry, run recording, and in-memory storage. Requires no database.</Description>
    <PackageTags>$(CommonPackageTags);runtime;catalog;harness</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Tracon.Abstractions/Tracon.Abstractions.csproj" />
    <!--
      Phase 52: tool source generator. ReferenceOutputAssembly=false - Generators.dll
      is NOT a NORMAL dependency of Core.dll; it loads only into the compiler
      as OutputItemType=Analyzer. PrivateAssets=all - this ProjectReference does
      NOT LEAK into the consumer's dependency graph (dotnet pack's .nuspec
      already does not convert ProjectReferences to PackageReferences;
      PrivateAssets here is defensive). Moving the DLL into the nupkg is done
      by the target below - 52.4, docs/KARARLAR.md K-TBD.
    -->
    <ProjectReference Include="../Tracon.Generators/Tracon.Generators.csproj"
                       PrivateAssets="all"
                       ReferenceOutputAssembly="false"
                       OutputItemType="Analyzer" />
  </ItemGroup>

  <!--
    Moves the generator DLL into the package's analyzers/dotnet/cs/ folder. Core
    targets MULTIPLE TFMs (net8/9/10); @(Analyzer) is populated only in the
    INNER (TFM-specific) build, and is EMPTY in the outer cross-targeting
    build (measured). This is why `BeforeTargets="_GetPackageFiles"` is NOT
    ENOUGH - the official solution is TargetsForTfmSpecificContentInPackage;
    the target reruns for EVERY inner build and is collected via
    TfmSpecificPackageFile.

    🚨 Even @(Analyzer) is INSUFFICIENT when packing with the noBuild flag
    (2026-08-10, measured: after packing with the noBuild flag,
    analyzers/dotnet/cs/ came out EMPTY, missing from the fourth of the
    preview.0.56-0.59 packages too). Reason: @(Analyzer) is populated by the
    ResolveReferences pass, and that pass depends on a BUILD; the noBuild flag
    does not run it. That is why the generator DLL's path is requested not
    VIA @(Analyzer) but directly from the Generators project's OWN
    GetTargetPath target. This target is NOT a build, it only returns the
    project's (already existing) output path, and it also works with the
    noBuild flag because the Generators project is already compiled with a
    normal build BEFORE Core in the verification chain.
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);TraconPackGeneratorAssembly</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!--
    The target is called for EVERY inner build (net8/9/10), but the generator
    DLL is INDEPENDENT of TFM; adding it three times gives NU5118 ("file
    already exists"). We guarantee uniqueness by pinning to a single TFM
    (net10.0, the highest one).
  -->
  <Target Name="TraconPackGeneratorAssembly" Condition="'$(TargetFramework)' == 'net10.0'">
    <MSBuild Projects="../Tracon.Generators/Tracon.Generators.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="TraconGeneratorAssemblyPath" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(TraconGeneratorAssemblyPath)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <!--
    Phase 73: the consumer-facing MSBuild target and the generated capability
    map. buildTransitive/ is what makes them flow through the Tracon meta
    package; build/ would stop at a direct reference.

    🚨 `Update` does NOT work here, and the failure is silent: the SDK's default
    None glob is applied only in the INNER (TFM-specific) builds, while `dotnet
    pack` collects package files in the OUTER cross-targeting build - measured,
    2 None items outside versus 7 inside. An Update there matches nothing and
    the files leave the package without a warning. Remove + Include is the
    working form: the Remove drops the globbed copy in the inner builds so the
    Include is not a duplicate item, and the Include is what the outer build
    sees. The same reason README.md is packed with an Include.
  -->
  <ItemGroup>
    <None Remove="buildTransitive/**" />
    <None Include="buildTransitive/Tracon.Core.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="buildTransitive/Tracon.AgentMap.md" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Harness" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <!--
      Phase 155: EvaluatorRunJudge binds to IEvaluator directly, so the
      reference is explicit rather than transitive through Microsoft.Agents.AI.
      Net transitive weight: 0 - the package is already in this graph.
      Microsoft.Extensions.AI.Evaluation.Quality is deliberately NOT referenced
      here; see Directory.Packages.props.
    -->
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />

    <!-- Phase 62, F-59 open question 1: explicit reference for pre-flight token counting. -->
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" />
    <!-- CVE zorlamasi (Directory.Packages.props, "Ic ucus token sayimi" grubu). -->
    <PackageReference Include="Microsoft.Bcl.Memory" />
  </ItemGroup>

</Project>
