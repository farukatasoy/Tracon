<Project>

  <!--
    Delivers the capability map that a coding agent reads, writes the pointer
    file that names the documentation on this machine, and feeds the two files
    TRC0401 and TRC0402 inspect.

    Opt-in by design, so that installing the package surprises nobody: with
    TraconWriteAgentsFile unset,
    this file writes nothing. `dotnet new tracon-api` sets the property, so a
    generated project gets the map without asking; an existing project turns it
    on deliberately.

    buildTransitive/, not build/: a consumer usually references the Tracon
    meta package, and a build/ asset does not flow across a transitive reference.
  -->

  <PropertyGroup>
    <TraconAgentMapFile>$(MSBuildThisFileDirectory)Tracon.AgentMap.md</TraconAgentMapFile>

    <!--
      The repository root, not the project directory: an agent reads AGENTS.md
      from the root of the repository it was started in. A normal clone is found
      through .git/config; in a worktree or a submodule .git is a FILE, which the
      first probe cannot see, so the second one looks for it directly.
    -->
    <_TraconRepositoryRoot Condition="'$(_TraconRepositoryRoot)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), '.git/config'))</_TraconRepositoryRoot>
    <_TraconRepositoryRoot Condition="'$(_TraconRepositoryRoot)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), '.git'))</_TraconRepositoryRoot>

    <_TraconAgentsFileRoot>$(_TraconRepositoryRoot)</_TraconAgentsFileRoot>
    <_TraconAgentsFileRoot Condition="'$(_TraconAgentsFileRoot)' == ''">$(MSBuildProjectDirectory)</_TraconAgentsFileRoot>

    <_TraconAgentsFile>$([MSBuild]::NormalizePath('$(_TraconAgentsFileRoot)', 'AGENTS.md'))</_TraconAgentsFile>
    <!--
      Beside the PROJECT, not at the repository root - unlike AGENTS.md.
      Measured: a repository that splits a web host from a worker gives each
      project a DIFFERENT set of Tracon packages, and one shared file can
      only hold one of those answers. Whichever project built last won, the web
      host lost its HTTP document, and the file changed on every build. One file
      per project is correct by construction: no race, no merge, and
      WriteOnlyWhenDifferent means what it says. The map names the location.
    -->
    <_TraconLocalReferenceFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'Tracon.LocalReference.md'))</_TraconLocalReferenceFile>

    <!--
      The gate skill `tracon agent-skill` writes. The build never writes this
      one - a directory tree cannot honour "never overwrite" the way a single
      file can, and the content is the consumer's to edit. The build only reads
      it back, so TRC0403 can say when the revision it was stamped with is no
      longer the installed one. At the repository root, like AGENTS.md, because
      that is where the harness looks for it.
    -->
    <_TraconGateSkillFile>$([MSBuild]::NormalizePath('$(_TraconAgentsFileRoot)', '.claude', 'skills', 'tracon', 'SKILL.md'))</_TraconGateSkillFile>

    <!--
      The map names every entry point; it explains none of them. The next
      question a coding agent asks - "how is this called?" - is already
      answered on this machine: every Tracon package carries its XML
      documentation into the NuGet cache. What is missing is the pointer, and
      the pointer has to be generated because the paths are machine-specific.

      One switch turns on both files, so opting in does not get harder.
      The second property exists only for a consumer who wants one and not the
      other.
    -->
    <TraconWriteLocalReference Condition="'$(TraconWriteLocalReference)' == ''">$(TraconWriteAgentsFile)</TraconWriteLocalReference>
  </PropertyGroup>

  <!--
    One switch for the whole usage family. The diagnostics are warnings because
    an Info diagnostic never appears in `dotnet build` output (measured), and a
    diagnostic a coding agent cannot read is not a diagnostic. The cost is that
    TRC0101 and TRC0102 cannot see a registration that lives in another
    assembly; a consumer whose composition root is split sets this property
    instead of writing one .editorconfig entry per diagnostic.
  -->
  <PropertyGroup Condition="'$(TraconUsageDiagnostics)' == 'false'">
    <NoWarn>$(NoWarn);TRC0101;TRC0102;TRC0201;TRC0301;TRC0302;TRC0401;TRC0402;TRC0403;TRC0501;TRC0502</NoWarn>
  </PropertyGroup>

  <!--
    TRC0401 compares the revision marker of the two files, and TRC0402 asks a
    hand-written AGENTS.md to name the local reference. An analyzer must not read
    from disk (RS1035), so they arrive as additional files. This happens whether
    or not the property is set: a consumer who turned the property on once and
    off again still has a file that can go stale, and a consumer who never turned
    it on still has instructions that can leave the map unfindable.
  -->
  <ItemGroup Condition="Exists('$(TraconAgentMapFile)') And (Exists('$(_TraconAgentsFile)') Or Exists('$(_TraconGateSkillFile)'))">
    <AdditionalFiles Include="$(TraconAgentMapFile)" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(_TraconAgentsFile)') And Exists('$(TraconAgentMapFile)')">
    <AdditionalFiles Include="$(_TraconAgentsFile)" />
  </ItemGroup>

  <!--
    TRC0403 compares the gate skill's stamp with the installed map. Included
    on the same terms as AGENTS.md above and for the same reason: a consumer
    who ran the tool once has a file that can go stale whether or not any
    property is set today. The map is added by the group above rather than
    here, so a project that has both files does not list it twice.
  -->
  <ItemGroup Condition="Exists('$(_TraconGateSkillFile)') And Exists('$(TraconAgentMapFile)')">
    <AdditionalFiles Include="$(_TraconGateSkillFile)" />
  </ItemGroup>

  <!--
    TRC0402 asks AGENTS.md to name the local reference file, so it may only ask
    while that file is actually written. Without this the diagnostic would fire
    on a consumer who opted into nothing - the package would stop being silent
    on install - and the line it asks for would name a file that never appears.
    A dead pointer is worse than no pointer.
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="TraconWriteLocalReference" />
  </ItemGroup>

  <Target Name="TraconWriteAgentsFile"
          AfterTargets="Build"
          Condition="'$(TraconWriteAgentsFile)' == 'true' And Exists('$(TraconAgentMapFile)')">

    <Message Condition="'$(_TraconRepositoryRoot)' == ''"
             Importance="high"
             Text="Tracon: no repository root was found above '$(MSBuildProjectDirectory)'. AGENTS.md is written next to the project instead." />

    <!--
      An existing file is NEVER overwritten. The consumer may have edited it, and
      losing those edits on a routine build would be worse than a stale map;
      TRC0401 reports staleness and names the two steps that refresh it. The
      condition also makes a parallel build harmless: whichever project runs
      first writes, and the rest find the file already there.
    -->
    <!--
      ContinueOnError: this file is a convenience, and a convenience must never
      fail a build. A read-only repository root - an ordinary CI mount - would
      otherwise stop the build with MSB3021, and the template turns the property
      on for every generated project. The same flag covers the narrow race where
      two parallel projects both pass the Exists check.
    -->
    <Copy SourceFiles="$(TraconAgentMapFile)"
          DestinationFiles="$(_TraconAgentsFile)"
          Condition="!Exists('$(_TraconAgentsFile)')"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <!--
    Writes the pointer file. Regenerated on every build, so it can never go
    stale and needs no staleness diagnostic; it is machine-specific, so it is
    never committed and the first line says so.

    A separate file, not a section of AGENTS.md: AGENTS.md is never overwritten
    because the consumer may have edited it, which makes it the wrong place for
    content that changes with every restore. The map points at this file by
    name.
  -->
  <Target Name="TraconWriteLocalReference"
          AfterTargets="Build"
          Condition="'$(TraconWriteLocalReference)' == 'true'">

    <!--
      NuGetPackageId is empty for a ProjectReference, so a repository that
      builds Tracon from source produces no file at all - the paths it would
      write do not exist there. The metadata is wrapped because a filter over
      @(ReferencePath) also visits framework references, whose metadata is
      empty.
    -->
    <ItemGroup>
      <_TraconPackageReference Include="@(ReferencePath)"
                                   Condition="$([System.String]::Copy('%(ReferencePath.NuGetPackageId)').StartsWith('Tracon'))" />
    </ItemGroup>

    <!--
      %0A ends a line with a blank line after it. The documentation file sits
      beside the assembly with the same name, which is what the transform
      builds; a transform emits exactly one item per source item, so a path
      containing a semicolon cannot split a line (measured).

      No version header: the path already carries the version it was restored
      from, and a single header line could not state one honestly when a project
      resolves two Tracon packages at different versions.

      MSBuild trims leading whitespace from an Include value, so an indented
      code block cannot be written here - the recipe below is fenced instead.
    -->
    <ItemGroup Condition="'@(_TraconPackageReference)' != ''">
      <_TraconLocalReferenceLine Include="&lt;!-- Tracon local reference - regenerated on every build - machine-specific - do not commit --&gt;" />
      <_TraconLocalReferenceLine Include="# Tracon local reference%0A" />
      <_TraconLocalReferenceLine Include="Generated by the Tracon build for $(MSBuildProjectFile). The paths are" />
      <_TraconLocalReferenceLine Include="specific to this machine, and each one carries the version it was restored" />
      <_TraconLocalReferenceLine Include="from. Add this file to .gitignore.%0A" />

      <!--
        First, and deliberately: the first question a coding agent asks is what
        exists, and only the second is how it is called. The map is not copied
        here - it is a file in the package, and a copy could disagree with the
        one TRC0401 compares against.
      -->
      <_TraconLocalReferenceLine Include="## Capability map - read this first%0A"
                                     Condition="Exists('$(TraconAgentMapFile)')" />
      <_TraconLocalReferenceLine Include="- $(TraconAgentMapFile)%0A"
                                     Condition="Exists('$(TraconAgentMapFile)')" />
      <_TraconLocalReferenceLine Include="Every capability Tracon ships, with the call that turns it on. Read it"
                                     Condition="Exists('$(TraconAgentMapFile)')" />
      <_TraconLocalReferenceLine Include="before you write agent, run, tool, or evaluation code by hand.%0A"
                                     Condition="Exists('$(TraconAgentMapFile)')" />

      <_TraconLocalReferenceLine Include="## API documentation, one file per referenced package%0A" />
      <_TraconLocalReferenceLine Include="@(_TraconPackageReference->'- %(NuGetPackageId): %(RootDir)%(Directory)%(Filename).xml')" />

      <_TraconLocalReferenceLine Include="%0A## HTTP API document%0A"
                                     Condition="'$(TraconOpenApiDocumentFile)' != ''" />
      <_TraconLocalReferenceLine Include="- $(TraconOpenApiDocumentFile)"
                                     Condition="'$(TraconOpenApiDocumentFile)' != ''" />

      <_TraconLocalReferenceLine Include="%0A## How to read them%0A" />
      <_TraconLocalReferenceLine Include="Each file above is XML documentation: one `&lt;member&gt;` element per public" />
      <_TraconLocalReferenceLine Include="member, carrying its summary and its parameters. Every registration entry" />
      <_TraconLocalReferenceLine Include="point - every `Add*`, `Use*`, and `Map*` that turns a capability on - also" />
      <_TraconLocalReferenceLine Include="carries a worked `&lt;example&gt;`. Find the exact member name first, then read" />
      <_TraconLocalReferenceLine Include="the member:%0A" />
      <_TraconLocalReferenceLine Include="```bash" />
      <_TraconLocalReferenceLine Include="grep -o 'name=&quot;M:Tracon[^&quot;]*Tenant[^&quot;]*&quot;' &lt;api-doc&gt;" />
      <_TraconLocalReferenceLine Include="grep -A 12 'AddToolApprovalPolicy' &lt;api-doc&gt;" />
      <_TraconLocalReferenceLine Include="```%0A" />
      <_TraconLocalReferenceLine Include="A generic member carries an arity suffix in its name (``AddContentGuard``1``)," />
      <_TraconLocalReferenceLine Include="so search for the name without the suffix." />
    </ItemGroup>

    <!--
      Overwrite because the file is generated in full; WriteOnlyWhenDifferent
      because touching an unchanged file stirs up git and file watchers for
      nothing - and with one file per project, nothing else writes it, so an
      unchanged restore leaves it alone; ContinueOnError because a convenience
      file must never fail a build - a read-only source tree is an ordinary CI
      mount.
    -->
    <WriteLinesToFile File="$(_TraconLocalReferenceFile)"
                      Lines="@(_TraconLocalReferenceLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      ContinueOnError="WarnAndContinue"
                      Condition="'@(_TraconLocalReferenceLine)' != ''" />
  </Target>

</Project>
