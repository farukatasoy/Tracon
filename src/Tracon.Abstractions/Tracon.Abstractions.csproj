<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Tracon contracts and abstractions. Agent definition, catalog, run record and storage interfaces. Not bound to a concrete provider or database.</Description>
    <PackageTags>$(CommonPackageTags);abstractions;contracts</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>

  <ItemGroup Label="Internal visibility - Core reads the ProviderSettingsValidationException marker; both Core and Workflows read StateSchemaGenerations">
    <InternalsVisibleTo Include="Tracon.Core" />
    <InternalsVisibleTo Include="Tracon.Workflows" />
  </ItemGroup>

  <!--
    Helpers that other Tracon packages call from their own implementation, and
    that no consumer names: the SQL stores read the session state bag keys and
    the schema-ready gate, the ASP.NET Core endpoints and the MCP host read the
    same gate and SafeErrorText. Each was public only so that a sibling package
    could reach it; an evidence pass over the public surface found no site page,
    sample, template, or seam document that asks a consumer to use one. A
    third-party store or host needs none of them - the seams it implements are
    the public interfaces in this package.
  -->
  <ItemGroup Label="Internal visibility - first-party hosts and stores">
    <InternalsVisibleTo Include="Tracon.AspNetCore" />
    <InternalsVisibleTo Include="Tracon.Mcp" />
    <InternalsVisibleTo Include="Tracon.PostgreSql" />
    <InternalsVisibleTo Include="Tracon.SqlServer" />
    <InternalsVisibleTo Include="Tracon.Sqlite" />
  </ItemGroup>

  <ItemGroup Label="Internal visibility - test projects that exercise these helpers through a sibling package">
    <InternalsVisibleTo Include="Tracon.Core.UnitTests" />
    <InternalsVisibleTo Include="Tracon.Mcp.UnitTests" />
    <InternalsVisibleTo Include="Tracon.Workflows.UnitTests" />
  </ItemGroup>

  <!--
    The four shipped provider adapters THROW the same marker. Their factories
    validate configuration by hand (an empty model name, a thinking budget out
    of range, an unrecognized safety threshold), and ProviderFailureNormalizer
    masks everything a factory raises EXCEPT this marker - it cannot otherwise
    tell Tracon's own validation apart from a raw SDK failure, which is what
    the masking exists for.

    The marker stays internal rather than becoming public API: its whole value
    is that it cannot be forged, and only first-party adapters are on this
    list. A third-party adapter reaches the same outcome through
    ModelProviderSettings.Validate, which raises it on their behalf.
  -->
  <ItemGroup Label="Internal visibility - shipped provider adapters">
    <InternalsVisibleTo Include="Tracon.Anthropic" />
    <InternalsVisibleTo Include="Tracon.Azure" />
    <InternalsVisibleTo Include="Tracon.Google" />
    <InternalsVisibleTo Include="Tracon.OpenAI" />
  </ItemGroup>

</Project>
