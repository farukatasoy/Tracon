<Project>

  <!--
    Delivers the capability map that a coding agent reads, and feeds the two
    files APG0401 compares.

    Opt-in by design, so that installing the package surprises nobody: with
    AgentPrismWriteAgentsFile unset,
    this file writes nothing. `dotnet new agentprism-api` sets the property, so a
    generated project gets the map without asking; an existing project turns it
    on deliberately.

    buildTransitive/, not build/: a consumer usually references the AgentPrism
    meta package, and a build/ asset does not flow across a transitive reference.
  -->

  <PropertyGroup>
    <AgentPrismAgentMapFile>$(MSBuildThisFileDirectory)AgentPrism.AgentMap.md</AgentPrismAgentMapFile>

    <!--
      The repository root, not the project directory: an agent reads AGENTS.md
      from the root of the repository it was started in. A normal clone is found
      through .git/config; in a worktree or a submodule .git is a FILE, which the
      first probe cannot see, so the second one looks for it directly.
    -->
    <_AgentPrismRepositoryRoot Condition="'$(_AgentPrismRepositoryRoot)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), '.git/config'))</_AgentPrismRepositoryRoot>
    <_AgentPrismRepositoryRoot Condition="'$(_AgentPrismRepositoryRoot)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), '.git'))</_AgentPrismRepositoryRoot>

    <_AgentPrismAgentsFileRoot>$(_AgentPrismRepositoryRoot)</_AgentPrismAgentsFileRoot>
    <_AgentPrismAgentsFileRoot Condition="'$(_AgentPrismAgentsFileRoot)' == ''">$(MSBuildProjectDirectory)</_AgentPrismAgentsFileRoot>

    <_AgentPrismAgentsFile>$([MSBuild]::NormalizePath('$(_AgentPrismAgentsFileRoot)', 'AGENTS.md'))</_AgentPrismAgentsFile>
    <!--
      Beside the PROJECT, not at the repository root - unlike AGENTS.md.
      Measured: a repository that splits a web host from a worker gives each
      project a DIFFERENT set of AgentPrism packages, and one shared file can
      only hold one of those answers. Whichever project built last won, the web
      host lost its HTTP document, and the file changed on every build. One file
      per project is correct by construction: no race, no merge, and
      WriteOnlyWhenDifferent means what it says. The map names the location.
    -->
    <_AgentPrismLocalReferenceFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'AgentPrism.LocalReference.md'))</_AgentPrismLocalReferenceFile>

    <!--
      The map names every entry point; it explains none of them. The next
      question a coding agent asks - "how is this called?" - is already
      answered on this machine: every AgentPrism package carries its XML
      documentation into the NuGet cache. What is missing is the pointer, and
      the pointer has to be generated because the paths are machine-specific.

      One switch turns on both files, so opting in does not get harder.
      The second property exists only for a consumer who wants one and not the
      other.
    -->
    <AgentPrismWriteLocalReference Condition="'$(AgentPrismWriteLocalReference)' == ''">$(AgentPrismWriteAgentsFile)</AgentPrismWriteLocalReference>
  </PropertyGroup>

  <!--
    One switch for the whole usage family. The diagnostics are warnings because
    an Info diagnostic never appears in `dotnet build` output (measured), and a
    diagnostic a coding agent cannot read is not a diagnostic. The cost is that
    APG0101 and APG0102 cannot see a registration that lives in another
    assembly; a consumer whose composition root is split sets this property
    instead of writing six .editorconfig entries.
  -->
  <PropertyGroup Condition="'$(AgentPrismUsageDiagnostics)' == 'false'">
    <NoWarn>$(NoWarn);APG0101;APG0102;APG0201;APG0301;APG0302;APG0401</NoWarn>
  </PropertyGroup>

  <!--
    APG0401 compares the revision marker of the two files. An analyzer must not
    read from disk (RS1035), so both arrive as additional files. This happens
    whether or not the property is set: a consumer who turned the property on
    once and off again still has a file that can go stale. A hand-written
    AGENTS.md carries no marker and is never reported.
  -->
  <ItemGroup Condition="Exists('$(_AgentPrismAgentsFile)') And Exists('$(AgentPrismAgentMapFile)')">
    <AdditionalFiles Include="$(_AgentPrismAgentsFile)" />
    <AdditionalFiles Include="$(AgentPrismAgentMapFile)" />
  </ItemGroup>

  <Target Name="AgentPrismWriteAgentsFile"
          AfterTargets="Build"
          Condition="'$(AgentPrismWriteAgentsFile)' == 'true' And Exists('$(AgentPrismAgentMapFile)')">

    <Message Condition="'$(_AgentPrismRepositoryRoot)' == ''"
             Importance="high"
             Text="AgentPrism: no repository root was found above '$(MSBuildProjectDirectory)'. AGENTS.md is written next to the project instead." />

    <!--
      An existing file is NEVER overwritten. The consumer may have edited it, and
      losing those edits on a routine build would be worse than a stale map;
      APG0401 reports staleness and names the two steps that refresh it. The
      condition also makes a parallel build harmless: whichever project runs
      first writes, and the rest find the file already there.
    -->
    <!--
      ContinueOnError: this file is a convenience, and a convenience must never
      fail a build. A read-only repository root - an ordinary CI mount - would
      otherwise stop the build with MSB3021, and the template turns the property
      on for every generated project. The same flag covers the narrow race where
      two parallel projects both pass the Exists check.
    -->
    <Copy SourceFiles="$(AgentPrismAgentMapFile)"
          DestinationFiles="$(_AgentPrismAgentsFile)"
          Condition="!Exists('$(_AgentPrismAgentsFile)')"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <!--
    Writes the pointer file. Regenerated on every build, so it can never go
    stale and needs no staleness diagnostic; it is machine-specific, so it is
    never committed and the first line says so.

    A separate file, not a section of AGENTS.md: AGENTS.md is never overwritten
    because the consumer may have edited it, which makes it the wrong place for
    content that changes with every restore. The map points at this file by
    name.
  -->
  <Target Name="AgentPrismWriteLocalReference"
          AfterTargets="Build"
          Condition="'$(AgentPrismWriteLocalReference)' == 'true'">

    <!--
      NuGetPackageId is empty for a ProjectReference, so a repository that
      builds AgentPrism from source produces no file at all - the paths it would
      write do not exist there. The metadata is wrapped because a filter over
      @(ReferencePath) also visits framework references, whose metadata is
      empty.
    -->
    <ItemGroup>
      <_AgentPrismPackageReference Include="@(ReferencePath)"
                                   Condition="$([System.String]::Copy('%(ReferencePath.NuGetPackageId)').StartsWith('AgentPrism'))" />
    </ItemGroup>

    <!--
      %0A ends a line with a blank line after it. The documentation file sits
      beside the assembly with the same name, which is what the transform
      builds; a transform emits exactly one item per source item, so a path
      containing a semicolon cannot split a line (measured).

      No version header: the path already carries the version it was restored
      from, and a single header line could not state one honestly when a project
      resolves two AgentPrism packages at different versions.

      MSBuild trims leading whitespace from an Include value, so an indented
      code block cannot be written here - the recipe below is fenced instead.
    -->
    <ItemGroup Condition="'@(_AgentPrismPackageReference)' != ''">
      <_AgentPrismLocalReferenceLine Include="&lt;!-- AgentPrism local reference - regenerated on every build - machine-specific - do not commit --&gt;" />
      <_AgentPrismLocalReferenceLine Include="# AgentPrism local reference%0A" />
      <_AgentPrismLocalReferenceLine Include="Generated by the AgentPrism build for $(MSBuildProjectFile). The paths are" />
      <_AgentPrismLocalReferenceLine Include="specific to this machine, and each one carries the version it was restored" />
      <_AgentPrismLocalReferenceLine Include="from. Add this file to .gitignore.%0A" />
      <_AgentPrismLocalReferenceLine Include="## API documentation, one file per referenced package%0A" />
      <_AgentPrismLocalReferenceLine Include="@(_AgentPrismPackageReference->'- %(NuGetPackageId): %(RootDir)%(Directory)%(Filename).xml')" />

      <_AgentPrismLocalReferenceLine Include="%0A## HTTP API document%0A"
                                     Condition="'$(AgentPrismOpenApiDocumentFile)' != ''" />
      <_AgentPrismLocalReferenceLine Include="- $(AgentPrismOpenApiDocumentFile)"
                                     Condition="'$(AgentPrismOpenApiDocumentFile)' != ''" />

      <_AgentPrismLocalReferenceLine Include="%0A## How to read them%0A" />
      <_AgentPrismLocalReferenceLine Include="Each file above is XML documentation: one `&lt;member&gt;` element per public" />
      <_AgentPrismLocalReferenceLine Include="member, carrying its summary and its parameters. Every registration entry" />
      <_AgentPrismLocalReferenceLine Include="point - every `Add*`, `Use*`, and `Map*` that turns a capability on - also" />
      <_AgentPrismLocalReferenceLine Include="carries a worked `&lt;example&gt;`. Find the exact member name first, then read" />
      <_AgentPrismLocalReferenceLine Include="the member:%0A" />
      <_AgentPrismLocalReferenceLine Include="```bash" />
      <_AgentPrismLocalReferenceLine Include="grep -o 'name=&quot;M:AgentPrism[^&quot;]*Tenant[^&quot;]*&quot;' &lt;api-doc&gt;" />
      <_AgentPrismLocalReferenceLine Include="grep -A 12 'AddToolApprovalPolicy' &lt;api-doc&gt;" />
      <_AgentPrismLocalReferenceLine Include="```%0A" />
      <_AgentPrismLocalReferenceLine Include="A generic member carries an arity suffix in its name (``AddContentGuard``1``)," />
      <_AgentPrismLocalReferenceLine Include="so search for the name without the suffix." />
    </ItemGroup>

    <!--
      Overwrite because the file is generated in full; WriteOnlyWhenDifferent
      because touching an unchanged file stirs up git and file watchers for
      nothing - and with one file per project, nothing else writes it, so an
      unchanged restore leaves it alone; ContinueOnError because a convenience
      file must never fail a build - a read-only source tree is an ordinary CI
      mount.
    -->
    <WriteLinesToFile File="$(_AgentPrismLocalReferenceFile)"
                      Lines="@(_AgentPrismLocalReferenceLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      ContinueOnError="WarnAndContinue"
                      Condition="'@(_AgentPrismLocalReferenceLine)' != ''" />
  </Target>

</Project>
