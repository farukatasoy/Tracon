<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>AgentPrism cekirdek calisma zamani. Agent katalogu, tanim derleyicisi, tool kayit defteri, calistirma kaydi ve bellek ici depolama. Veritabani gerektirmez.</Description>
    <PackageTags>$(CommonPackageTags);runtime;catalog;harness</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentPrism.Abstractions/AgentPrism.Abstractions.csproj" />
    <!--
      Faz 52: tool kaynak ureteci. ReferenceOutputAssembly=false - Generators.dll
      Core.dll'in NORMAL bir bagimliligi degildir, yalniz derleyiciye
      OutputItemType=Analyzer olarak yuklenir. PrivateAssets=all - tuketicinin
      bagimlilik grafigine bu ProjectReference SIZMAZ (dotnet pack .nuspec'i
      ProjectReference'lari PackageReference'a cevirmez zaten; PrivateAssets
      burada savunma amaclidir). DLL'in nupkg'ye tasinmasi asagidaki hedefle
      yapilir - 52.4, docs/KARARLAR.md K-yeni.
    -->
    <ProjectReference Include="../AgentPrism.Generators/AgentPrism.Generators.csproj"
                       PrivateAssets="all"
                       ReferenceOutputAssembly="false"
                       OutputItemType="Analyzer" />
  </ItemGroup>

  <!--
    Ureteç DLL'ini paketin analyzers/dotnet/cs/ klasorune tasir. Core UC TFM
    hedefler (net8/9/10); @(Analyzer) yalniz INNER (TFM'e ozgu) derlemede
    doludur, disaridaki capraz-hedefleme derlemesinde BOSTUR (olculdu). Bu
    yuzden `BeforeTargets="_GetPackageFiles"` YETMEZ - resmi cozum
    TargetsForTfmSpecificContentInPackage'dir; hedef HER inner build icin
    tekrar calisir ve TfmSpecificPackageFile ile toplanir. Ureteç DLL'i
    TFM'den BAGIMSIZ oldugu icin (netstandard2.0) uc kez eklenmesi zararsizdir;
    NuGet ayni PackagePath+icerigi tekillestirir. `dotnet pack -o /tmp/apk`
    sonrasi `unzip -l` ile dogrulanir (docs/52-KAYNAK-URETECI.md, dogrulama
    komutu 4).
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AgentPrismPackGeneratorAssembly</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!--
    Hedef HER inner build (net8/9/10) icin cagrilir ama ureteç DLL'i TFM'den
    BAGIMSIZDIR; uc kez eklemek NU5118 verir ("dosya zaten var"). Tek bir TFM'e
    (en yuksek olan net10.0) sabitleyerek tekilligi garanti ederiz.
  -->
  <Target Name="AgentPrismPackGeneratorAssembly" Condition="'$(TargetFramework)' == 'net10.0'">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(Analyzer)"
                               Condition="'%(Analyzer.Filename)' == 'AgentPrism.Generators'"
                               PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Harness" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
  </ItemGroup>

</Project>
