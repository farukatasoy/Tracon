<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>AgentPrism core runtime. Agent catalog, definition compiler, tool registry, run recording, and in-memory storage. Requires no database.</Description>
    <PackageTags>$(CommonPackageTags);runtime;catalog;harness</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentPrism.Abstractions/AgentPrism.Abstractions.csproj" />
    <!--
      Phase 52: tool source generator. ReferenceOutputAssembly=false - Generators.dll
      is NOT a NORMAL dependency of Core.dll; it loads only into the compiler
      as OutputItemType=Analyzer. PrivateAssets=all - this ProjectReference does
      NOT LEAK into the consumer's dependency graph (dotnet pack's .nuspec
      already does not convert ProjectReferences to PackageReferences;
      PrivateAssets here is defensive). Moving the DLL into the nupkg is done
      by the target below - 52.4, docs/KARARLAR.md K-TBD.
    -->
    <ProjectReference Include="../AgentPrism.Generators/AgentPrism.Generators.csproj"
                       PrivateAssets="all"
                       ReferenceOutputAssembly="false"
                       OutputItemType="Analyzer" />
  </ItemGroup>

  <!--
    Moves the generator DLL into the package's analyzers/dotnet/cs/ folder. Core
    targets MULTIPLE TFMs (net8/9/10); @(Analyzer) is populated only in the
    INNER (TFM-specific) build, and is EMPTY in the outer cross-targeting
    build (measured). This is why `BeforeTargets="_GetPackageFiles"` is NOT
    ENOUGH - the official solution is TargetsForTfmSpecificContentInPackage;
    the target reruns for EVERY inner build and is collected via
    TfmSpecificPackageFile.

    🚨 Even @(Analyzer) is INSUFFICIENT when packing with the noBuild flag
    (2026-08-10, measured: after packing with the noBuild flag,
    analyzers/dotnet/cs/ came out EMPTY, missing from the fourth of the
    preview.0.56-0.59 packages too). Reason: @(Analyzer) is populated by the
    ResolveReferences pass, and that pass depends on a BUILD; the noBuild flag
    does not run it. That is why the generator DLL's path is requested not
    VIA @(Analyzer) but directly from the Generators project's OWN
    GetTargetPath target. This target is NOT a build, it only returns the
    project's (already existing) output path, and it also works with the
    noBuild flag because the Generators project is already compiled with a
    normal build BEFORE Core in the verification chain.
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AgentPrismPackGeneratorAssembly</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!--
    The target is called for EVERY inner build (net8/9/10), but the generator
    DLL is INDEPENDENT of TFM; adding it three times gives NU5118 ("file
    already exists"). We guarantee uniqueness by pinning to a single TFM
    (net10.0, the highest one).
  -->
  <Target Name="AgentPrismPackGeneratorAssembly" Condition="'$(TargetFramework)' == 'net10.0'">
    <MSBuild Projects="../AgentPrism.Generators/AgentPrism.Generators.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="AgentPrismGeneratorAssemblyPath" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(AgentPrismGeneratorAssemblyPath)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Harness" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
  </ItemGroup>

</Project>
