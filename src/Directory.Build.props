<Project>

  <!-- Load the root Directory.Build.props first. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Every project under src/ is a publishable NuGet package.
    Shared packaging metadata is defined here; each project only gives its own
    <Description> and <PackageTags> values in its own csproj file.
  -->

  <PropertyGroup Label="Target framework">
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <!--
    Trim and AOT compatibility.
    On by default, so we get a library that works in trimmed and native AOT
    applications. ASP.NET Core minimal API routing and the embedded UI's asset
    scanning inherently use reflection, so Tracon.AspNetCore and
    Tracon.UI disable it in their own csproj files by writing
    TraconAotCompatible=false.
    Rationale: docs/KARARLAR.md, decision K-006.
  -->
  <!--
    NOTE: IsAotCompatible is NOT assigned here. This file loads BEFORE the
    csproj body; the <TraconAotCompatible>false</...> value written in the
    csproj has not been read yet, and IsAotCompatible would stay true
    irreversibly. The derivation happens in Directory.Build.targets, AFTER the
    csproj is read.
  -->
  <PropertyGroup Label="Trim / AOT">
    <TraconAotCompatible Condition=" '$(TraconAotCompatible)' == '' ">true</TraconAotCompatible>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!--
      PolyForm Small Business 1.0.0 is not OSI approved, so it cannot be named in
      <PackageLicenseExpression> - NuGet accepts only its own allow list there.
      <PackageLicenseFile> embeds the text in the package instead, which also
      means the licence needs no URL to resolve while the repository is private.
    -->
    <!--
      🚨 The matrix lives HERE and not in the three csproj files, because the
      <None Include="...$(PackageLicenseFile)"> item below is in this same file:
      an ItemGroup is evaluated in file order, before any csproj body runs, so a
      csproj-level override would set the nuspec correctly and still pack the
      WRONG file. Resolving the matrix above the ItemGroup keeps the two in step.
      Three packages are MIT so that a third party can write and test an
      extension, and own the code `dotnet new` generates, without a commercial
      licence. Everything that actually runs an agent is PolyForm.
    -->
    <TraconMitLicensed Condition=" '$(MSBuildProjectName)' == 'Tracon.Abstractions'
                                    Or '$(MSBuildProjectName)' == 'Tracon.Testing.Contracts.Xunit'
                                    Or '$(MSBuildProjectName)' == 'Tracon.Templates' ">true</TraconMitLicensed>
    <PackageLicenseFile Condition=" '$(TraconMitLicensed)' == 'true' ">LICENSE-MIT.md</PackageLicenseFile>
    <PackageLicenseFile Condition=" '$(PackageLicenseFile)' == '' ">LICENSE.md</PackageLicenseFile>
    <PackageRequireLicenseAcceptance Condition=" '$(TraconMitLicensed)' == 'true' ">false</PackageRequireLicenseAcceptance>
    <PackageRequireLicenseAcceptance Condition=" '$(PackageRequireLicenseAcceptance)' == '' ">true</PackageRequireLicenseAcceptance>
    <Authors>Faruk Atasoy</Authors>
    <!-- Copyright stays with the author; Atanova is the entity that licenses and invoices. -->
    <Company>Atanova</Company>
    <Product>Tracon</Product>
    <Copyright>Copyright (c) Faruk Atasoy</Copyright>
    <!--
      🚨 Measured (HTTP 404, anonymous): the GitHub repository is private, so any
      github.com URL shipped in package metadata is a dead link for every
      consumer. The two fields a person actually clicks on nuget.org - the
      project website and the release notes - therefore point at the public
      documentation site, which is the only public surface this product has.
      RepositoryUrl stays on the real repository on purpose: it is provenance
      that tooling reads, not a link offered to a reader, and the packing gate
      requires a <repository commit="..."/> element. The consequence is written
      down rather than hidden - Source Link cannot resolve sources for a third
      party while the repository is private.
    -->
    <PackageProjectUrl>https://tracon.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/farukatasoy/Tracon</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!--
      Package validation on every `dotnet pack`, in strict mode: a library
      package has the SAME public surface in net8.0, net9.0 and net10.0. A
      member that exists in one target only fails the pack.
      The check against the previous PUBLISHED version runs only in the
      release rehearsal (`scripts/kapi.py yayin`): it restores the baseline
      packages into an isolated cache and passes TraconPackageBaselineRoot,
      which Directory.Build.targets turns into PackageValidationBaselinePath.
      No other pack reaches the network for a baseline. Strict mode against the
      baseline (EnableStrictModeForBaselineValidation) stays off: it would also
      fail an ADDED member, and the preview surface may grow.
      Rationale: docs/KARARLAR.md, K-864 (breaking-change gate) and K-865 (strict mode).
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <EnableStrictModeForCompatibleTfms>true</EnableStrictModeForCompatibleTfms>
    <EnableStrictModeForCompatibleFrameworksInPackage>true</EnableStrictModeForCompatibleFrameworksInPackage>
    <!-- Shared tags; projects use $(CommonPackageTags) inside PackageTags. -->
    <CommonPackageTags>tracon;ai;agents;microsoft-agent-framework;llm;dotnet</CommonPackageTags>
  </PropertyGroup>

  <PropertyGroup Label="Versioning (MinVer - from git tag)">
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerAutoIncrement>minor</MinVerAutoIncrement>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <!--
    🚨 Measured, not guessed: a <PropertyGroup> that is a direct child of
    <Project> is evaluated once, up front, before ANY target runs - including
    MinVer's own target, which is what actually computes $(Version). Writing
    <PackageReleaseNotes>...v$(Version).../PackageReleaseNotes> in a plain
    PropertyGroup here captured $(Version) EMPTY every time, producing
    ".../blob/v/CHANGELOG.md" in every packed .nuspec. A <PropertyGroup>
    nested INSIDE a <Target>, by contrast, evaluates when that target RUNS
    (execution phase), by which point MinVer has already set $(Version) - the
    same props-vs-targets ordering the AOT compatibility note above describes,
    but here evaluation-phase-vs-execution-phase rather than props-vs-csproj.
    BeforeTargets="GenerateNuspec" is the last point `dotnet pack` accepts a
    property change before the .nuspec is written.
  -->
  <Target Name="TraconSetPackageReleaseNotes" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <!--
        Anchored to the version, not embedded release-note text: 20 packages
        share one version stream, so inlining the same text 20 times would
        drift. The target is the documentation site's release-notes page, which
        is generated from the root CHANGELOG.md - a github.com URL would 404
        for every consumer while the repository is private. The `v<version>`
        anchor is written explicitly by that generator, because a heading slug
        would drop the dots from a version like `1.0.0-preview.1`. The page
        exists only after the site is rebuilt and deployed for the version
        being tagged; the metadata gate validates the URL's SHAPE and that it
        carries the resolved version, not its reachability (K-604 keeps the
        gate network-free).
      -->
      <PackageReleaseNotes>https://tracon.dev/reference/changelog/#v$(Version)</PackageReleaseNotes>
    </PropertyGroup>
  </Target>

  <!--
    Every Tracon package ships on one version line (docs/KARARLAR.md, K-602), so
    a sibling dependency is written as an EXACT range on this package's own
    version: [1.0.0-preview.3], not NuGet's default lower bound. With a lower
    bound, upgrading ONE Tracon package restores a mixed graph with zero
    warnings, and the process fails later at run time with a
    MissingMethodException in whichever sibling still calls a member the other
    release removed.

    `dotnet pack` turns each ProjectReference into a dependency whose range is
    the referenced project's ProjectVersion metadata, read by the SDK's
    _GetProjectReferenceVersions target (a DependsOnTargets of GenerateNuspec,
    so it has already run when a BeforeTargets hook of GenerateNuspec runs).
    There is no public property for this range; the item is SDK-private.

    🚨 If the SDK renames _ProjectReferencesWithVersions, this target silently
    edits nothing: the ranges fall back to lower bounds and the build stays
    green. The only gate that notices is
    tests/Tracon.Package.Tests ReleaseArtifactTests.EverySiblingDependencyIsExactAndMatchesOwnVersion.
    A version that is already an exact range (starts with '[') is left as it is,
    so the target stays idempotent if the SDK ever pins the range itself.
  -->
  <Target Name="TraconPinSiblingDependencies" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition=" '%(_ProjectReferencesWithVersions.ProjectVersion)' != ''
                                                  And !$([System.String]::Copy('%(_ProjectReferencesWithVersions.ProjectVersion)').StartsWith('[')) ">
        <ProjectVersion>[%(_ProjectReferencesWithVersions.ProjectVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

  <!--
    🚨 <None Update=...> is a silent no-op in a cross-targeted project: the
    SDK's default None glob applies only in the INNER (TFM-specific) builds,
    while `dotnet pack` collects package files in the OUTER cross-targeting
    build. Include is the working form - this is why README.md is packed the
    same way. Verify with: unzip -l <nupkg> | grep icon.png (all 20 packages).
    Rationale: docs/hafiza/paketleme-ve-dagitim.md.
  -->
  <ItemGroup Label="Package files">
    <None Include="README.md" Pack="true" PackagePath="\" Visible="true" />
    <None Include="$(RepositoryRootPath)assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
    <!--
      The licence file the package declares, and only that one: a package must
      never carry both, or the file inside it stops answering which terms apply.
    -->
    <None Include="$(RepositoryRootPath)$(PackageLicenseFile)" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    Public API tracking applies to every src/ project by default. Four
    projects opt out by setting TraconPublicApiTrackingEnabled=false in
    their own csproj: Tracon.Generators and Tracon.Templates (neither
    ships a consumer-facing API surface - Generators' "API" is its
    diagnostic/source output, Templates' is `dotnet new` content), and
    Tracon.Client and Tracon.Cli (their surface is generated from the
    OpenAPI document, which already has its own drift gate). Rationale: docs/KARARLAR.md.
    This is the ONLY public API tracking switch (K-421, K-424). A phase that
    changes the surface produces a PublicAPI.Unshipped.txt diff;
    PublicAPI.Shipped.txt stays empty through the preview line and is filled
    once, at 1.0.0 GA (K-603).
  -->
  <PropertyGroup Label="Public API takibi katilimi">
    <TraconPublicApiTrackingEnabled Condition=" '$(TraconPublicApiTrackingEnabled)' == '' ">true</TraconPublicApiTrackingEnabled>
  </PropertyGroup>

  <ItemGroup Label="Extra analyzers in publishable packages">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Condition=" '$(TraconPublicApiTrackingEnabled)' == 'true' " PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="MinVer" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup Label="Internal visibility - test projects">
    <InternalsVisibleTo Include="$(MSBuildProjectName).UnitTests" />
    <InternalsVisibleTo Include="$(MSBuildProjectName).IntegrationTests" />
    <InternalsVisibleTo Include="$(MSBuildProjectName).FunctionalTests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!--
    The three storage providers override ~34 store contracts each. They do that
    through TraconDefaultRegistrationExtensions, which must tell Tracon's own
    default apart from a registration the consuming application made - see
    Tracon.Core/Diagnostics/TraconDefaultRegistrations.cs.

    It stays INTERNAL rather than becoming public API: writing a STORE is a
    shipped seam and needs nothing from it (an ordinary AddSingleton is the
    documented step, guides/write-your-own-store), while writing a storage
    PROVIDER is not a shipped seam.
  -->
  <ItemGroup Label="Internal visibility - storage providers" Condition=" '$(MSBuildProjectName)' == 'Tracon.Core' ">
    <InternalsVisibleTo Include="Tracon.PostgreSql" />
    <InternalsVisibleTo Include="Tracon.SqlServer" />
    <InternalsVisibleTo Include="Tracon.Sqlite" />
  </ItemGroup>

  <!--
    TenantChatClientCacheKey is shared by the four shipped provider adapters and
    is INTERNAL rather than public API: the string it returns begins with the
    tenant's PLAINTEXT credential. Inside Tracon it never leaves an in-process
    dictionary, but a public helper that hands back a secret invites the one
    debugging move that turns it into a leak - logging the key on a cache miss.
    K-059 keeps secrets out of files and out of the database; this keeps them
    out of the public surface too.

    A third-party provider adapter does not need it. What the shipped
    ModelProviderCredentialContract requires is the same-instance guarantee,
    not this particular key.
  -->
  <ItemGroup Label="Internal visibility - provider adapters" Condition=" '$(MSBuildProjectName)' == 'Tracon.Core' ">
    <InternalsVisibleTo Include="Tracon.Anthropic" />
    <InternalsVisibleTo Include="Tracon.Azure" />
    <InternalsVisibleTo Include="Tracon.Google" />
    <InternalsVisibleTo Include="Tracon.OpenAI" />
  </ItemGroup>

</Project>
