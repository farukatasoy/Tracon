<Project>

  <!-- Load the root Directory.Build.props first. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Every project under src/ is a publishable NuGet package.
    Shared packaging metadata is defined here; each project only gives its own
    <Description> and <PackageTags> values in its own csproj file.
  -->

  <PropertyGroup Label="Target framework">
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <!--
    Trim and AOT compatibility.
    On by default, so we get a library that works in trimmed and native AOT
    applications. ASP.NET Core minimal API routing and the embedded UI's asset
    scanning inherently use reflection, so AgentPrism.AspNetCore and
    AgentPrism.UI disable it in their own csproj files by writing
    AgentPrismAotCompatible=false.
    Rationale: docs/KARARLAR.md, decision K-006.
  -->
  <!--
    NOTE: IsAotCompatible is NOT assigned here. This file loads BEFORE the
    csproj body; the <AgentPrismAotCompatible>false</...> value written in the
    csproj has not been read yet, and IsAotCompatible would stay true
    irreversibly. The derivation happens in Directory.Build.targets, AFTER the
    csproj is read.
  -->
  <PropertyGroup Label="Trim / AOT">
    <AgentPrismAotCompatible Condition=" '$(AgentPrismAotCompatible)' == '' ">true</AgentPrismAotCompatible>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Authors>Faruk Atasoy</Authors>
    <Company>Intelera</Company>
    <Product>AgentPrism</Product>
    <Copyright>Copyright (c) Faruk Atasoy</Copyright>
    <PackageProjectUrl>https://github.com/farukatasoy/AgentPrism</PackageProjectUrl>
    <RepositoryUrl>https://github.com/farukatasoy/AgentPrism</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Shared tags; projects use $(CommonPackageTags) inside PackageTags. -->
    <CommonPackageTags>agentprism;ai;agents;microsoft-agent-framework;llm;dotnet</CommonPackageTags>
  </PropertyGroup>

  <PropertyGroup Label="Versioning (MinVer - from git tag)">
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerAutoIncrement>minor</MinVerAutoIncrement>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup Label="Package files">
    <None Include="README.md" Pack="true" PackagePath="\" Visible="true" />
  </ItemGroup>

  <ItemGroup Label="Extra analyzers in publishable packages">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="MinVer" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup Label="Internal visibility - test projects">
    <InternalsVisibleTo Include="$(MSBuildProjectName).UnitTests" />
    <InternalsVisibleTo Include="$(MSBuildProjectName).IntegrationTests" />
    <InternalsVisibleTo Include="$(MSBuildProjectName).FunctionalTests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
