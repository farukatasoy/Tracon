<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>SQLite persistence layer for Tracon. Single-file setup: for demos, embedded scenarios, and testing with real SQL behavior. Ships with embedded SQL migrations. Single-writer; not for use in a multi-instance deployment.</Description>
    <PackageTags>$(CommonPackageTags);sqlite;persistence;embedded</PackageTags>
  </PropertyGroup>

  <!--
    AOT status NOT MEASURED (opening). SQLitePCLRaw carries a native
    library; this usually affects publish behavior. The flag stays on the
    safe side until measured.;
  -->
  <PropertyGroup Label="Trim / AOT">
    <TraconAotCompatible>false</TraconAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Tracon.Core/Tracon.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup Label="Embedded SQL migrations">
    <EmbeddedResource Include="Migrations/**/*.sql" />
  </ItemGroup>

  <!--
    Optional migration set: applied only when EnableReadViews is
    turned on. A published view is a permanent data contract, so it is opt-in
    (same reasoning as PostgreSQL's "knowledge" set).
  -->
  <ItemGroup Label="Optional 'views' migration set">
    <EmbeddedResource Include="MigrationsViews/**/*.sql" />
  </ItemGroup>

  <!--
    Shared source. Tracon.Sql.Shared is NOT a package; the same
    files also compile into Tracon.PostgreSql and Tracon.SqlServer.
  -->
  <ItemGroup Label="Shared SQL source">
    <Compile Include="../Tracon.Sql.Shared/**/*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!--
    Tracon.Sql.Shared.UnitTests checks the SQL text of the three
    providers side by side and cannot use the "$(MSBuildProjectName).UnitTests"
    convention below (that name belongs to a single provider). No Docker
    dependency: it never opens a connection, only builds a query-set object.
  -->
  <ItemGroup Label="Internal visibility - cross-provider SQL text tests">
    <InternalsVisibleTo Include="Tracon.Sql.Shared.UnitTests" />
  </ItemGroup>

  <!--
    Tracon.Benchmarks constructs SqlRunStore directly, the same
    way the SQLite integration tests do (SqliteTestContext) - the internal
    plumbing types (SqlStoreContext, SqliteDialect, SqliteDataSource) have no
    public DI-free construction path.
  -->
  <ItemGroup Label="Internal visibility - allocation benchmarks">
    <InternalsVisibleTo Include="Tracon.Benchmarks" />
  </ItemGroup>

</Project>
