<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Azure OpenAI provider adapter for Tracon. Deployment-based model resolution, authentication with an API key or Microsoft Entra identity, model catalog, and health checks.</Description>
    <PackageTags>$(CommonPackageTags);azure;azure-openai;entra;provider</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Tracon.Core/Tracon.Core.csproj" />
  </ItemGroup>

  <!--
    Azure OpenAI's v1 API is the OpenAI wire protocol under {endpoint}/openai/v1/
: POST {endpoint}/openai/v1/chat/completions with the deployment
    name in the body's `model` field. The plain OpenAI SDK therefore talks to it
    directly; `Azure.AI.OpenAI` (stable line frozen at 2.1.0, December 2024)
    is not used. Message mapping, streaming, tool calls, and usage counters all
    come from the OpenAI SDK's own code; Tracon writes none of them.

    Azure.Core is written directly because it appears in the public API (see
    Directory.Packages.props).
  -->
  <ItemGroup>
    <PackageReference Include="OpenAI" />
    <PackageReference Include="Azure.Core" />
    <!-- The ChatClient -> IChatClient adapter (`AsIChatClient`) comes from this package. -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
  </ItemGroup>

  <!--
    Shared source. Tracon.Providers.Shared is NOT a package; the same
    files also compile into the other three provider adapters. Rationale and
    rules: src/Tracon.Providers.Shared/README.md.
  -->
  <ItemGroup Label="Shared provider source">
    <Compile Include="../Tracon.Providers.Shared/**/*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!--
    Shared source for the two packages built on the OpenAI client library
    (Tracon.OpenAI and Tracon.Azure). Not a package. Rules:
    src/Tracon.OpenAI.Shared/README.md.
  -->
  <ItemGroup Label="Shared OpenAI client source">
    <Compile Include="../Tracon.OpenAI.Shared/**/*.cs" LinkBase="OpenAIShared" />
  </ItemGroup>

</Project>
