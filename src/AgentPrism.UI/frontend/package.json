{
  "name": "agentprism-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Embedded management console for AgentPrism. Built into AgentPrism.UI as embedded resources.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vitest run && vite build && node scripts/postbuild.mjs && vite build --config vite.embed.config.ts && node scripts/postbuild-embed.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentprism/client": "file:../../../packages/agentprism-client",
    "@tanstack/react-query": "^5.102.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  }
}
