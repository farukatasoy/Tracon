<Project>

  <!--
    Frontend build chain.

    The Vite output is written into wwwroot/ and embedded in the assembly as an
    EmbeddedResource. wwwroot/ is not kept in the source tree (.gitignore); the
    only source of truth is the frontend/ folder.

    The steps are incremental. `npm ci` does not run if package-lock.json has
    not changed; `npm run build` does not run if the frontend sources have not
    changed. The stamp files live under BaseIntermediateOutputPath - that is
    independent of the target framework, so this package, which builds for
    three target frameworks, runs npm only once.
  -->

  <PropertyGroup>
    <AgentPrismNpmInstallStamp>$(BaseIntermediateOutputPath)agentprism-npm-install.stamp</AgentPrismNpmInstallStamp>
    <AgentPrismFrontendStamp>$(BaseIntermediateOutputPath)agentprism-frontend.stamp</AgentPrismFrontendStamp>
    <AgentPrismShellFile>$(AgentPrismFrontendOutput)/index.html</AgentPrismShellFile>

    <!--
      @agentprism/client (Phase 84). The frontend consumes it as a repo-local
      `file:` dependency (docs/arsiv/fazlar/84-TYPESCRIPT-ISTEMCISI-VE-NPM.md, section
      84.8) — it must be BUILT (tsc -> dist/) before the frontend's own
      `npm run build`, because the frontend imports its TYPES, and a `file:`
      dependency's `dist/` is not produced by `npm ci` on its own.
    -->
    <AgentPrismClientPackageRoot>$(RepositoryRootPath)packages/agentprism-client</AgentPrismClientPackageRoot>
    <AgentPrismClientNpmInstallStamp>$(BaseIntermediateOutputPath)agentprism-client-npm-install.stamp</AgentPrismClientNpmInstallStamp>
    <AgentPrismClientBuildStamp>$(BaseIntermediateOutputPath)agentprism-client-build.stamp</AgentPrismClientBuildStamp>
  </PropertyGroup>

  <ItemGroup Condition=" '$(AgentPrismFrontendEnabled)' == 'true' ">
    <!--
      Inputs that trigger the build. node_modules is DELIBERATELY excluded: its
      content is determined by package-lock.json, and scanning tens of thousands
      of files on every build would make the incremental check itself expensive.
    -->
    <AgentPrismFrontendInput Include="$(AgentPrismFrontendRoot)/src/**/*" />
    <AgentPrismFrontendInput Include="$(AgentPrismFrontendRoot)/scripts/**/*" />
    <AgentPrismFrontendInput Include="$(AgentPrismFrontendRoot)/index.html" />
    <AgentPrismFrontendInput Include="$(AgentPrismFrontendRoot)/package.json" />
    <AgentPrismFrontendInput Include="$(AgentPrismFrontendRoot)/package-lock.json" />
    <AgentPrismFrontendInput Include="$(AgentPrismFrontendRoot)/tsconfig.json" />
    <AgentPrismFrontendInput Include="$(AgentPrismFrontendRoot)/vite.config.ts" />

    <AgentPrismClientInput Include="$(AgentPrismClientPackageRoot)/src/**/*" />
    <AgentPrismClientInput Include="$(AgentPrismClientPackageRoot)/package.json" />
    <AgentPrismClientInput Include="$(AgentPrismClientPackageRoot)/package-lock.json" />
    <AgentPrismClientInput Include="$(AgentPrismClientPackageRoot)/tsconfig.json" />
  </ItemGroup>

  <!--
    Whether Node.js is present. If not, the build does not stop: if a
    previously produced wwwroot/ exists, the package is still complete. If not,
    a warning is issued and it turns into an error at the `pack` stage - a
    package with an empty UI cannot be published.
  -->
  <Target Name="AgentPrismDetectNode" Condition=" '$(AgentPrismFrontendEnabled)' == 'true' ">
    <Exec Command="npm --version"
          WorkingDirectory="$(AgentPrismFrontendRoot)"
          ContinueOnError="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="AgentPrismNpmExitCode" />
    </Exec>

    <PropertyGroup>
      <AgentPrismNodeAvailable Condition=" '$(AgentPrismNpmExitCode)' == '0' ">true</AgentPrismNodeAvailable>
      <AgentPrismNodeAvailable Condition=" '$(AgentPrismNpmExitCode)' != '0' ">false</AgentPrismNodeAvailable>
    </PropertyGroup>

  </Target>

  <Target Name="AgentPrismNpmInstall"
          Condition=" '$(AgentPrismFrontendEnabled)' == 'true' AND '$(AgentPrismNodeAvailable)' == 'true' "
          Inputs="$(AgentPrismFrontendRoot)/package-lock.json"
          Outputs="$(AgentPrismNpmInstallStamp)">
    <Message Importance="high" Text="AgentPrism.UI: installing dependencies (npm ci)" />

    <!--
      `npm ci` is used, not `npm install`: it matches the lock file exactly and
      does not modify it. A silent lock file update during the build would
      break the deterministic build promise.
    -->
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(AgentPrismFrontendRoot)" />

    <Touch Files="$(AgentPrismNpmInstallStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="AgentPrismClientNpmInstall"
          Condition=" '$(AgentPrismFrontendEnabled)' == 'true' AND '$(AgentPrismNodeAvailable)' == 'true' "
          Inputs="$(AgentPrismClientPackageRoot)/package-lock.json"
          Outputs="$(AgentPrismClientNpmInstallStamp)">
    <Message Importance="high" Text="AgentPrism.UI: installing @agentprism/client dependencies (npm ci)" />

    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(AgentPrismClientPackageRoot)" />

    <Touch Files="$(AgentPrismClientNpmInstallStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="AgentPrismBuildClientPackage"
          Condition=" '$(AgentPrismFrontendEnabled)' == 'true' AND '$(AgentPrismNodeAvailable)' == 'true' "
          DependsOnTargets="AgentPrismClientNpmInstall"
          Inputs="@(AgentPrismClientInput)"
          Outputs="$(AgentPrismClientBuildStamp)">
    <Message Importance="high" Text="AgentPrism.UI: building @agentprism/client (npm run build)" />

    <!--
      Not `npm run generate`: src/schema.ts is committed, and generating it is
      a development step run by hand when docs/openapi/agentprism.json
      changes (section 84.2) — `dotnet build` must not depend on network
      access to the OpenAPI-typescript generator. Only `tsc` runs here.
    -->
    <Exec Command="npm run build" WorkingDirectory="$(AgentPrismClientPackageRoot)" />

    <Touch Files="$(AgentPrismClientBuildStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="AgentPrismBuildFrontend"
          Condition=" '$(AgentPrismFrontendEnabled)' == 'true' AND '$(AgentPrismNodeAvailable)' == 'true' "
          Inputs="@(AgentPrismFrontendInput)"
          Outputs="$(AgentPrismFrontendStamp)">
    <Message Importance="high" Text="AgentPrism.UI: building the UI (npm run build)" />

    <!--
      This command runs type checking, the Vite build, Brotli compression, and
      the bundle budget gate together. If the budget is exceeded, the command
      fails and the .NET build breaks too - the gate is not CI-specific.
    -->
    <Exec Command="npm run build" WorkingDirectory="$(AgentPrismFrontendRoot)" />

    <Touch Files="$(AgentPrismFrontendStamp)" AlwaysCreate="true" />
  </Target>

  <!--
    Adds the produced assets as embedded resources.

    Runs before AssignTargetPaths; resource names are fixed after that point.
    The logical name is given the "AgentPrism.UI.wwwroot/" prefix, so the
    directory structure can be restored at runtime.
  -->
  <!--
    In a multi-targeted project, the inner builds (net8.0 / net9.0 / net10.0)
    run in PARALLEL. The frontend build writes into a single wwwroot/
    directory, and Vite clears that directory first; if the three inner builds
    start at the same time, they delete each other's files. Measured:
    "ENOENT: no such file or directory, unlink .../index-*.js".

    That is why the chain runs in the OUTER build, BEFORE the inner builds are
    dispatched. The inner builds find the stamp up to date and skip the step.
    When building with a single target (e.g., -f net10.0) there is no outer
    build; in that case, the aggregate target below runs the chain itself.
  -->
  <Target Name="AgentPrismFrontendOuterBuild"
          BeforeTargets="DispatchToInnerBuilds"
          DependsOnTargets="AgentPrismDetectNode;AgentPrismNpmInstall;AgentPrismBuildClientPackage;AgentPrismBuildFrontend"
          Condition=" '$(AgentPrismFrontendEnabled)' == 'true' " />

  <!--
    WARNING: The chain is set up here with DependsOnTargets, not between the
    targets themselves. MSBuild evaluates a target's Condition BEFORE
    DependsOnTargets; if the dependency chain were set up on that target
    instead, AgentPrismNpmInstall's condition (on the as-yet-empty
    AgentPrismNodeAvailable) would evaluate false, and AgentPrismDetectNode
    would never run. Measured: the UI was silently not being built.
  -->
  <Target Name="AgentPrismCollectFrontendAssets"
          DependsOnTargets="AgentPrismDetectNode;AgentPrismNpmInstall;AgentPrismBuildClientPackage;AgentPrismBuildFrontend"
          BeforeTargets="AssignTargetPaths"
          Condition=" '$(AgentPrismFrontendEnabled)' == 'true' ">
    <ItemGroup>
      <AgentPrismFrontendAsset Include="$(AgentPrismFrontendOutput)/**/*" />

      <EmbeddedResource Include="@(AgentPrismFrontendAsset)"
                        LogicalName="AgentPrism.UI.wwwroot/%(AgentPrismFrontendAsset.RecursiveDir)%(AgentPrismFrontendAsset.Filename)%(AgentPrismFrontendAsset.Extension)" />
    </ItemGroup>

    <Warning Condition=" '@(AgentPrismFrontendAsset)' == '' AND '$(AgentPrismNodeAvailable)' != 'true' "
             Code="AGENTPRISM0002"
             Text="AgentPrism.UI: Node.js was not found and there are no previously built UI assets. The package will be built without a UI; MapAgentPrism will not bind the UI routes. Install Node.js 20.19+ or skip this project with -p:AgentPrismFrontendEnabled=false." />
  </Target>

  <!--
    A package with an empty UI cannot be published. A warning is enough at
    build time; the same condition is an error at the pack stage, because
    that point is already the publish path.
  -->
  <Target Name="AgentPrismValidateFrontendAssets"
          BeforeTargets="GenerateNuspec"
          Condition=" '$(AgentPrismFrontendEnabled)' == 'true' ">
    <Error Condition="!Exists('$(AgentPrismShellFile)')"
           Code="AGENTPRISM0003"
           Text="AgentPrism.UI: UI assets were not produced ($(AgentPrismShellFile) does not exist). A package with an empty UI cannot be published. Install Node.js 20.19+ and rebuild." />
  </Target>

</Project>
