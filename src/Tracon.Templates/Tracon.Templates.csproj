<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      TargetFrameworks (PLURAL) is left EMPTY: src/Directory.Build.props assigns
      it "net8.0;net9.0;net10.0". TargetFramework (SINGULAR) is enough for
      `dotnet build`, but `dotnet pack`'s cross-targeting path reads the PLURAL
      value; leaving it empty pins the template to a single TFM (it doesn't
      compile anyway, so a TFM has no meaning here).
    -->
    <TargetFrameworks></TargetFrameworks>
    <Description>The `dotnet new tracon-api` template. Generates a working Tracon control plane: Program.cs, a sample tool, an empty appsettings.json placeholder, a README.</Description>
    <PackageTags>$(CommonPackageTags);template;dotnet-new</PackageTags>
    <PackageType>Template</PackageType>
    <TemplateAffinityPackageId>Tracon</TemplateAffinityPackageId>
    <!--
      The template package is NOT a library: it does not compile, it only
      carries content. IncludeBuildOutput=false + the NU5128 suppression is the
      SAME pattern as the meta package (Tracon.csproj) - see the K-007 note
      in docs/KARARLAR.md and src/Tracon/Tracon.csproj.
    -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- No consumer-facing API surface - it ships `dotnet new` content, not a library. -->
    <TraconPublicApiTrackingEnabled>false</TraconPublicApiTrackingEnabled>
    <!--
      🚨 IncludeSymbols=false is MANDATORY. src/Directory.Build.props assigns
      IncludeSymbols=true + snupkg (a separate symbol package is produced for
      every package). This project has no compiled .dll/.pdb; the symbol
      package stays EMPTY and NuGet.Build.Tasks.Pack rejects it with NU5017
      ("neither dependencies nor content") - the build FAILS even though the
      MAIN package is correctly populated. Measured: the <files> list in the
      nuspec was correct, the error came only from the symbol package.
    -->
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!--
      The template package has no dependencies at all and never enters the
      consumer's dependency graph (37.1). An AOT promise is meaningless too -
      it doesn't compile.
    -->
    <TraconAotCompatible>false</TraconAotCompatible>
    <!--
      The .cs files under content/ must NOT be included in THIS project's own
      compilation - they are source files for the project to be generated, not
      source for the template package. The SDK's default globbing is disabled;
      content is added explicitly below as <None>.
    -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <!--
      The SDK's default globbing EXCLUDES folders (.template.config) and files
      (.gitignore) that start with a dot. Without NoDefaultExcludes, the
      template's definition file never enters the package and `dotnet new
      install` silently installs a non-functional package (see
      docs/hafiza/build-ve-analyzer.md - same class as the "duplicate files"
      trap: silent poisoning).
    -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- Packed from a stamped copy; see TraconStampTemplateVersionDefault below. -->
    <_TraconTemplateConfigRelative>content/Tracon.Starter/.template.config/template.json</_TraconTemplateConfigRelative>
  </PropertyGroup>

  <!--
    <None Pack="true" PackagePath="..."> - the official NuGet pattern
    (learn.microsoft.com/nuget/reference/msbuild-targets#packagepath).
    %(RecursiveDir) in the "content/**/*" pattern gives everything AFTER
    "content/"; starting PackagePath explicitly with "content/" produces the
    correct SINGLE-LAYER result (ContentTargetFolders is NOT USED - it never
    applies when an explicit PackagePath is present; adding it produces
    "content/content/..." - measured).
  -->
  <ItemGroup>
    <None Include="content/**/*"
          Exclude="content/**/bin/**;content/**/obj/**;$(_TraconTemplateConfigRelative)"
          Pack="true"
          PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    🚨 WriteLinesToFile cannot write this file. Its Lines parameter is an item
    list, and MSBuild normalizes an item spec's path separators: every `\"` in
    the JSON came out as `/"` and the packed template.json was no longer valid
    JSON. Measured - the pack succeeded and the damage was only visible by
    parsing the file inside the .nupkg. A string parameter goes through
    untouched.
  -->
  <UsingTask TaskName="TraconWriteTextFile"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$([System.IO.Path]::Combine($(MSBuildToolsPath),'Microsoft.Build.Tasks.Core.dll'))">
    <ParameterGroup>
      <Path ParameterType="System.String" Required="true" />
      <Text ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(Path));
        System.IO.File.WriteAllText(Path, Text);
      </Code>
    </Task>
  </UsingTask>

  <!--
    🚨 The generated project's package version defaults to THIS package's own
    version, stamped in here at pack time.

    It used to default to the wildcard "*-*". Measured on a real machine: the
    generated project resolved a STALE 0.0.0-preview.0.789 that was already in
    the global NuGet cache, not the version the template itself came from. A
    wildcard reads "newest", but restore answers "newest ALREADY KNOWN", and a
    first run then silently mixes a current template with an old runtime.

    MinVer supplies $(Version) from the git tag, so it cannot be written into
    the source file - it differs per build. The file is copied into obj/ with
    the placeholder replaced, and THAT copy is packed. The Error below makes
    the step fail closed: if the placeholder is ever renamed in template.json
    the build stops, rather than shipping a template whose default version is
    the literal placeholder.
  -->
  <Target Name="TraconStampTemplateVersionDefault"
          BeforeTargets="_GetPackageFiles"
          DependsOnTargets="MinVer">
    <PropertyGroup>
      <_TraconTemplateConfigSource>$(MSBuildProjectDirectory)/$(_TraconTemplateConfigRelative)</_TraconTemplateConfigSource>
      <_TraconTemplateConfigStamped>$(IntermediateOutputPath)template.json</_TraconTemplateConfigStamped>
      <_TraconTemplateConfigText>$([System.IO.File]::ReadAllText('$(_TraconTemplateConfigSource)'))</_TraconTemplateConfigText>
      <_TraconTemplateConfigStampedText>$(_TraconTemplateConfigText.Replace('TRACON_TEMPLATE_DEFAULT_VERSION', '$(Version)'))</_TraconTemplateConfigStampedText>
    </PropertyGroup>

    <Error Condition=" '$(_TraconTemplateConfigStampedText)' == '$(_TraconTemplateConfigText)' "
           Text="TRACON_TEMPLATE_DEFAULT_VERSION not found in $(_TraconTemplateConfigRelative); the generated project would carry the placeholder as its package version." />

    <TraconWriteTextFile Path="$(_TraconTemplateConfigStamped)" Text="$(_TraconTemplateConfigStampedText)" />

    <ItemGroup>
      <None Include="$(_TraconTemplateConfigStamped)" Pack="true" PackagePath="$(_TraconTemplateConfigRelative)" />
    </ItemGroup>
  </Target>

</Project>
