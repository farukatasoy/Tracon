<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tracon.Starter</RootNamespace>
    <UserSecretsId>tracon-starter-10000000-0000-0000-0000-000000000001</UserSecretsId>
    <!--
      Writes AGENTS.md at the repository root on the first build, so a coding
      agent working in this project starts from the Tracon capability map.
      An existing AGENTS.md is never overwritten. Remove this line to opt out.
    -->
    <TraconWriteAgentsFile>true</TraconWriteAgentsFile>
    <!--
      InvariantGlobalization is NEVER enabled. `Microsoft.Data.SqlClient` does
      NOT SUPPORT Globalization Invariant Mode; this template offers the
      UseSqlServer option, and a project generated with that option would NEVER
      start (`SqlConnection.Open` throws a `NotSupportedException`). The template
      goes straight to the consumer; the defect would go straight there too.
      Measured against a real SQL Server.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tracon" Version="TRACON_TEMPLATE_PACKAGE_VERSION" />
<!--#if (UseSqlServer) -->
    <PackageReference Include="Tracon.SqlServer" Version="TRACON_TEMPLATE_PACKAGE_VERSION" />
<!--#endif -->
<!--#if (UseSqlite) -->
    <PackageReference Include="Tracon.Sqlite" Version="TRACON_TEMPLATE_PACKAGE_VERSION" />
<!--#endif -->
<!--#if (UseAnthropic) -->
    <PackageReference Include="Tracon.Anthropic" Version="TRACON_TEMPLATE_PACKAGE_VERSION" />
<!--#endif -->
<!--#if (UseGoogle) -->
    <PackageReference Include="Tracon.Google" Version="TRACON_TEMPLATE_PACKAGE_VERSION" />
<!--#endif -->
<!--#if (UseAzure) -->
    <PackageReference Include="Tracon.Azure" Version="TRACON_TEMPLATE_PACKAGE_VERSION" />
<!--#endif -->
  </ItemGroup>

</Project>
