{
  "name": "tracon-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Embedded management console for Tracon. Built into Tracon.UI as embedded resources.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-tokens.mjs && tsc --noEmit && vitest run && vite build && node scripts/postbuild.mjs && vite build --config vite.embed.config.ts && node scripts/postbuild-embed.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tracon/client": "file:../../../packages/tracon-client",
    "@tanstack/react-query": "^5.90.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
