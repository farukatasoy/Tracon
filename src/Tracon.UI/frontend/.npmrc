# Fail `npm ci` at once, with npm's own message, when Node.js is older than the
# console's tools allow (jsdom 30: ^22.22.2 || ^24.15.0 || >=26). Without this a
# contributor on Node 20 gets 36 "Failed to start forks worker" errors from Vitest
# and no sentence about the Node.js version.
engine-strict=true
