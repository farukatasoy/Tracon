<Project>

  <!--
    Frontend build chain.

    The Vite output is written into wwwroot/ and embedded in the assembly as an
    EmbeddedResource. wwwroot/ is not kept in the source tree (.gitignore); the
    only source of truth is the frontend/ folder.

    The steps are incremental. `npm ci` does not run if package-lock.json has
    not changed; `npm run build` does not run if the frontend sources have not
    changed. The stamps of those steps live under BaseIntermediateOutputPath,
    which is independent of the target framework: the work behind them is done
    once for the whole build, no matter how many frameworks this package
    builds for. A shared stamp does NOT make them exclusive on its own - it
    turns fresh only after the step finishes - so exclusivity is arranged
    separately, see TraconFrontendInnerBuild.
  -->

  <PropertyGroup>
    <TraconNpmInstallStamp>$(BaseIntermediateOutputPath)tracon-npm-install.stamp</TraconNpmInstallStamp>
    <TraconNodeDetectionStamp>$(BaseIntermediateOutputPath)tracon-node-detection.stamp</TraconNodeDetectionStamp>
    <TraconFrontendStamp>$(BaseIntermediateOutputPath)tracon-frontend.stamp</TraconFrontendStamp>
    <!--
      PER TARGET FRAMEWORK, unlike every stamp above it. The chain those guard
      runs once for the whole build; collecting the assets is work each inner
      build has to do for ITSELF, because it adds the EmbeddedResource items of
      that one assembly. Under the shared path the first inner build to finish
      made the stamp fresh and the other two skipped the target - and an
      assembly whose collection was skipped before it ever saw wwwroot/ ships
      with no UI at all.
    -->
    <TraconFrontendAssetsStamp>$(IntermediateOutputPath)tracon-frontend-assets.stamp</TraconFrontendAssetsStamp>
    <TraconShellFile>$(TraconFrontendOutput)/index.html</TraconShellFile>

    <!--
      @tracon/client (Phase 84). The frontend consumes it as a repo-local
      `file:` dependency (docs/arsiv/fazlar/84-TYPESCRIPT-ISTEMCISI-VE-NPM.md, section
      84.8) — it must be BUILT (tsc -> dist/) before the frontend's own
      `npm run build`, because the frontend imports its TYPES, and a `file:`
      dependency's `dist/` is not produced by `npm ci` on its own.
    -->
    <TraconClientPackageRoot>$(RepositoryRootPath)packages/tracon-client</TraconClientPackageRoot>
    <TraconClientNpmInstallStamp>$(BaseIntermediateOutputPath)tracon-client-npm-install.stamp</TraconClientNpmInstallStamp>
    <TraconClientBuildStamp>$(BaseIntermediateOutputPath)tracon-client-build.stamp</TraconClientBuildStamp>

    <!--
      The node probe writes a stamp that every instance shares, so only the
      TFM-less instance runs it; an inner build READS the file the chain it
      just waited for has written. See TraconFrontendInnerBuild.
    -->
    <TraconNodeProbeDependsOn Condition=" '$(TargetFramework)' == '' ">TraconDetectNode</TraconNodeProbeDependsOn>
  </PropertyGroup>

  <ItemGroup Condition=" '$(TraconFrontendEnabled)' == 'true' ">
    <!--
      Inputs that trigger the build. node_modules is DELIBERATELY excluded: its
      content is determined by package-lock.json, and scanning tens of thousands
      of files on every build would make the incremental check itself expensive.
    -->
    <TraconFrontendInput Include="$(TraconFrontendRoot)/src/**/*" />
    <TraconFrontendInput Include="$(TraconFrontendRoot)/scripts/**/*" />
    <TraconFrontendInput Include="$(TraconFrontendRoot)/index.html" />
    <TraconFrontendInput Include="$(TraconFrontendRoot)/package.json" />
    <TraconFrontendInput Include="$(TraconFrontendRoot)/package-lock.json" />
    <TraconFrontendInput Include="$(TraconFrontendRoot)/tsconfig.json" />
    <TraconFrontendInput Include="$(TraconFrontendRoot)/vite.config.ts" />

    <TraconClientInput Include="$(TraconClientPackageRoot)/src/**/*" />
    <TraconClientInput Include="$(TraconClientPackageRoot)/package.json" />
    <TraconClientInput Include="$(TraconClientPackageRoot)/package-lock.json" />
    <TraconClientInput Include="$(TraconClientPackageRoot)/tsconfig.json" />
  </ItemGroup>

  <!--
    Keep embedded resources available when the collection target is
    incremental-skipped. The target refreshes this item group after a
    frontend build when the frontend stamp is newer.
  -->
  <ItemGroup Condition=" '$(TraconFrontendEnabled)' == 'true' AND Exists('$(TraconFrontendOutput)') ">
    <TraconFrontendAsset Include="$(TraconFrontendOutput)/**/*" />
    <EmbeddedResource Include="@(TraconFrontendAsset)"
                      LogicalName="Tracon.UI.wwwroot/%(TraconFrontendAsset.RecursiveDir)%(TraconFrontendAsset.Filename)%(TraconFrontendAsset.Extension)" />
  </ItemGroup>

  <!--
    Whether Node.js is present. If not, the build does not stop: if a
    previously produced wwwroot/ exists, the package is still complete. If not,
    a warning is issued and it turns into an error at the `pack` stage - a
    package with an empty UI cannot be published.
  -->
  <Target Name="TraconDetectNode"
          Condition=" '$(TraconFrontendEnabled)' == 'true' "
          Inputs="@(TraconFrontendInput);@(TraconClientInput)"
          Outputs="$(TraconNodeDetectionStamp)">
    <Exec Command="npm --version"
          WorkingDirectory="$(TraconFrontendRoot)"
          ContinueOnError="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="TraconNpmExitCode" />
    </Exec>

    <PropertyGroup>
      <TraconNodeAvailable Condition=" '$(TraconNpmExitCode)' == '0' ">true</TraconNodeAvailable>
      <TraconNodeAvailable Condition=" '$(TraconNpmExitCode)' != '0' ">false</TraconNodeAvailable>
    </PropertyGroup>

    <WriteLinesToFile File="$(TraconNodeDetectionStamp)"
                      Lines="$(TraconNodeAvailable)"
                      Overwrite="true"
                      Encoding="UTF-8" />

  </Target>

  <!--
    A skipped target does not restore MSBuild properties. Read the result of
    the incremental node probe before any dependent target evaluates its
    Condition; otherwise a hot build would silently treat Node.js as absent.
  -->
  <Target Name="TraconReadNodeAvailability"
          DependsOnTargets="$(TraconNodeProbeDependsOn)"
          Condition=" '$(TraconFrontendEnabled)' == 'true' AND Exists('$(TraconNodeDetectionStamp)') ">
    <ReadLinesFromFile File="$(TraconNodeDetectionStamp)">
      <Output TaskParameter="Lines" ItemName="TraconNodeAvailabilityLine" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <TraconNodeAvailable Condition=" '@(TraconNodeAvailabilityLine)' == 'true' ">true</TraconNodeAvailable>
      <TraconNodeAvailable Condition=" '@(TraconNodeAvailabilityLine)' != 'true' ">false</TraconNodeAvailable>
    </PropertyGroup>
  </Target>

  <Target Name="TraconNpmInstall"
          Condition=" '$(TraconFrontendEnabled)' == 'true' AND '$(TraconNodeAvailable)' == 'true' "
          Inputs="$(TraconFrontendRoot)/package-lock.json"
          Outputs="$(TraconNpmInstallStamp)">
    <Message Importance="high" Text="Tracon.UI: installing dependencies (npm ci)" />

    <!--
      `npm ci` is used, not `npm install`: it matches the lock file exactly and
      does not modify it. A silent lock file update during the build would
      break the deterministic build promise.
    -->
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(TraconFrontendRoot)" />

    <Touch Files="$(TraconNpmInstallStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="TraconClientNpmInstall"
          Condition=" '$(TraconFrontendEnabled)' == 'true' AND '$(TraconNodeAvailable)' == 'true' "
          Inputs="$(TraconClientPackageRoot)/package-lock.json"
          Outputs="$(TraconClientNpmInstallStamp)">
    <Message Importance="high" Text="Tracon.UI: installing @tracon/client dependencies (npm ci)" />

    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(TraconClientPackageRoot)" />

    <Touch Files="$(TraconClientNpmInstallStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="TraconBuildClientPackage"
          Condition=" '$(TraconFrontendEnabled)' == 'true' AND '$(TraconNodeAvailable)' == 'true' "
          DependsOnTargets="TraconClientNpmInstall"
          Inputs="@(TraconClientInput)"
          Outputs="$(TraconClientBuildStamp)">
    <Message Importance="high" Text="Tracon.UI: building @tracon/client (npm run build)" />

    <!--
      Not `npm run generate`: src/schema.ts is committed, and generating it is
      a development step run by hand when docs/openapi/tracon.json
      changes (section 84.2) — `dotnet build` must not depend on network
      access to the OpenAPI-typescript generator. Only `tsc` runs here.
    -->
    <Exec Command="npm run build" WorkingDirectory="$(TraconClientPackageRoot)" />

    <Touch Files="$(TraconClientBuildStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="TraconBuildFrontend"
          Condition=" '$(TraconFrontendEnabled)' == 'true' AND '$(TraconNodeAvailable)' == 'true' "
          Inputs="@(TraconFrontendInput)"
          Outputs="$(TraconFrontendStamp)">
    <Message Importance="high" Text="Tracon.UI: building the UI (npm run build)" />

    <!--
      This command runs type checking, the Vite build, Brotli compression, and
      the bundle budget gate together. If the budget is exceeded, the command
      fails and the .NET build breaks too - the gate is not CI-specific.
    -->
    <Exec Command="npm run build" WorkingDirectory="$(TraconFrontendRoot)" />

    <Touch Files="$(TraconFrontendStamp)" AlwaysCreate="true" />
  </Target>

  <!--
    The whole frontend chain, named once. npm, the client build and Vite all
    write into directories that every instance of this project shares
    (frontend/node_modules, packages/tracon-client/dist, wwwroot/), so this
    chain must run EXACTLY ONCE per build, no matter how many instances want
    its output.

    WARNING: the order is expressed with DependsOnTargets HERE, not between the
    targets themselves. MSBuild evaluates a target's Condition BEFORE its
    DependsOnTargets; with the dependencies declared on the targets instead,
    TraconNpmInstall's condition (on the as-yet-empty
    TraconNodeAvailable) would evaluate false and TraconDetectNode
    would never run. Measured: the UI was silently not being built.
  -->
  <Target Name="TraconFrontendChain"
          DependsOnTargets="TraconDetectNode;TraconReadNodeAvailability;TraconNpmInstall;TraconBuildClientPackage;TraconBuildFrontend"
          Condition=" '$(TraconFrontendEnabled)' == 'true' " />

  <!--
    Runs the chain before the inner builds are dispatched, so the work is done
    once and early.
  -->
  <Target Name="TraconFrontendOuterBuild"
          BeforeTargets="DispatchToInnerBuilds"
          DependsOnTargets="TraconFrontendChain"
          Condition=" '$(TraconFrontendEnabled)' == 'true' " />

  <!--
    An inner build NEVER runs the chain itself: it asks the single instance
    that carries no TargetFramework to run it, and blocks until that is done.

    A stamp file alone cannot make the chain exclusive. The stamp only turns
    fresh AFTER the chain finishes, while an inner build starts as soon as
    something else asks for it - and every project that references this one
    (the Tracon meta package for each of its three frameworks, the E2E and
    generator test projects) asks for an inner build directly, scheduled
    independently of the outer build. Measured (2026-09-09, cold stamp,
    `dotnet build Tracon.slnx`): FOUR instances - [], net8.0, net9.0,
    net10.0 - entered `npm ci` within two seconds of each other and stayed
    inside together. On Windows that ends the build:
    "npm error ENOTEMPTY: directory not empty, rmdir ...\node_modules\react-refresh"
    - one process was extracting into the directory the other was deleting.

    Handing the work to one instance makes MSBuild itself the lock: a target
    runs at most once per (project, global properties) pair, and a second
    request for it waits for the first to finish instead of running beside it.
    RemoveProperties strips TargetFramework, which is what tells the two apart.
  -->
  <Target Name="TraconFrontendInnerBuild"
          Condition=" '$(TraconFrontendEnabled)' == 'true' AND '$(TargetFramework)' != '' ">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="TraconFrontendChain"
             RemoveProperties="TargetFramework" />
  </Target>

  <!--
    Adds the produced assets as embedded resources.

    Runs before AssignTargetPaths; resource names are fixed after that point.
    The logical name is given the "Tracon.UI.wwwroot/" prefix, so the
    directory structure can be restored at runtime.
  -->
  <Target Name="TraconCollectFrontendAssets"
          DependsOnTargets="TraconFrontendInnerBuild;TraconReadNodeAvailability"
          BeforeTargets="AssignTargetPaths"
          Condition=" '$(TraconFrontendEnabled)' == 'true' "
          Inputs="$(TraconFrontendStamp);$(TraconClientBuildStamp);$(TraconFrontendOutput)/index.html;@(TraconFrontendAsset)"
          Outputs="$(TraconFrontendAssetsStamp)">
    <ItemGroup>
      <!--
        Evaluation sees the previous asset set. Refresh it after a frontend
        build so a changed Vite hash is embedded on a single-TFM build too.
      -->
      <EmbeddedResource Remove="@(TraconFrontendAsset)" />
      <TraconFrontendAsset Remove="@(TraconFrontendAsset)" />
      <TraconFrontendAsset Include="$(TraconFrontendOutput)/**/*" />

      <EmbeddedResource Include="@(TraconFrontendAsset)"
                        LogicalName="Tracon.UI.wwwroot/%(TraconFrontendAsset.RecursiveDir)%(TraconFrontendAsset.Filename)%(TraconFrontendAsset.Extension)" />
    </ItemGroup>

    <Touch Files="$(TraconFrontendAssetsStamp)" AlwaysCreate="true" />

    <Warning Condition=" '@(TraconFrontendAsset)' == '' AND '$(TraconNodeAvailable)' != 'true' "
             Code="TRACON0002"
             Text="Tracon.UI: Node.js was not found and there are no previously built UI assets. The package will be built without a UI; MapTracon will not bind the UI routes. Install Node.js 20.19+ or skip this project with -p:TraconFrontendEnabled=false." />
  </Target>

  <!--
    A package with an empty UI cannot be published. A warning is enough at
    build time; the same condition is an error at the pack stage, because
    that point is already the publish path.
  -->
  <Target Name="TraconValidateFrontendAssets"
          BeforeTargets="GenerateNuspec"
          Condition=" '$(TraconFrontendEnabled)' == 'true' ">
    <Error Condition="!Exists('$(TraconShellFile)')"
           Code="TRACON0003"
           Text="Tracon.UI: UI assets were not produced ($(TraconShellFile) does not exist). A package with an empty UI cannot be published. Install Node.js 20.19+ and rebuild." />
  </Target>

</Project>
