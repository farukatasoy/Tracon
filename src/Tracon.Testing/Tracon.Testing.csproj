<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Test helpers for Tracon: a non-networked model provider, an in-memory host fixture, and assertions on run records. Binds to no test framework (xunit, NUnit, MSTest).</Description>
    <PackageTags>$(CommonPackageTags);testing;fixtures;mocks</PackageTags>
    <!--
      The TFM set is inherited from src/Directory.Build.props and is NOT narrowed
      here: the test package follows the same net8.0/net9.0/net10.0 matrix as the
      runtime packages. A consumer whose production app runs on .NET 8 LTS must be
      able to test it. See decision K-270.
      The one hosting dependency that forced this package to net10.0 until then
      (Microsoft.AspNetCore.TestHost) is resolved per TFM in the ItemGroup below.
    -->
    <!--
      The test package does not run in production: FakeModelProvider.CallsTool
      reads anonymous-type properties through reflection, and
      TraconTestHost's JSON (de)serialization carries no source-generator
      context. No AOT promise is made.
    -->
    <TraconAotCompatible>false</TraconAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Tracon.Core/Tracon.Core.csproj" />
    <!--
      The type a consumer will want most is the in-memory host fixture
      (TraconTestHost), and it requires Tracon.AspNetCore, which
      builds the endpoints. K-008 applies here: AspNetCore is the only
      package that can carry prerelease MAF packages; since Testing
      depends on it, it inherits those dependencies TRANSITIVELY.
      Acceptable — the test package is not in the production graph
      anyway. Rationale: docs/arsiv/fazlar/39-TEST-PAKETI.md, section 39.1.
    -->
    <ProjectReference Include="../Tracon.AspNetCore/Tracon.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The in-memory host is built on TestServer (not
      Microsoft.AspNetCore.Mvc.Testing - K-007: WebApplicationFactory<T>
      requires an entry-point assembly and locks the consumer into a hosting
      model. TestHost, in contrast, is an official, stable Microsoft package
      that pulls in no other dependency.
    -->
    <!--
      🚨 ONE version per TFM. The hosting package version maps one-to-one to the
      framework version (10.0.x restores ONLY on net10.0 — NU1202 elsewhere), so a
      single central version cannot cover the matrix. net10.0 takes the central
      version from Directory.Packages.props; net8.0/net9.0 take VersionOverride,
      which is the documented CPM escape for exactly this case.
      The three values are the SAME servicing wave (published 2026-07-14) — keep
      them in step when the central 10.0.x value moves.
    -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Condition=" '$(TargetFramework)' == 'net8.0' " VersionOverride="8.0.29" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Condition=" '$(TargetFramework)' == 'net9.0' " VersionOverride="9.0.18" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Condition=" '$(TargetFramework)' == 'net10.0' " />
  </ItemGroup>

  <!--
    NO test framework package is taken (xunit, NUnit, MSTest, Shouldly,
    FluentAssertions). The package works regardless of which framework the
    consumer uses; when an assertion fails it throws its own
    TraconAssertionException, and every framework counts that as a
    failure. Rationale: section 39.2.
  -->

</Project>
