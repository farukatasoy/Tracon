<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Tracon meta package without a store. A production-oriented agent control plane built on Microsoft Agent Framework, with an embedded management UI. One reference brings the common set: runtime, HTTP API, the OpenAI provider, workflows, MCP, and the embedded management UI. Storage engines and other providers are separate packages.</Description>
    <PackageTags>$(CommonPackageTags);meta;all-in-one</PackageTags>
    <!-- The meta package carries no code; the build output is not packed, to avoid an empty assembly. -->
    <TraconAotCompatible>false</TraconAotCompatible>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!--
      🚨 IncludeSymbols=false, for the same reason as Tracon.Templates.
      src/Directory.Build.props assigns IncludeSymbols=true + snupkg, so every
      package gets a symbol package. This one has no compiled .dll/.pdb
      (IncludeBuildOutput=false above), so the .snupkg carries ONLY metadata.
      Measured 2026-09-15: 4 entries, 0 PDB - _rels/.rels, the nuspec,
      [Content_Types].xml and the psmdcp. Unlike Tracon.Templates this does not
      fail the build with NU5017 (the nuspec still lists dependencies), so it
      shipped silently. A symbol package with no symbols is noise on the
      NuGet.org symbol server; the main .nupkg is unaffected.
    -->
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <!--
    An empty lib/<tfm>/_._ marker per target framework. Without a framework-specific
    asset a package with dependency groups only counts as compatible with EVERY
    framework: a project on a framework the family does not ship restored this
    package without NU1202, received no dependency at all, and failed later at
    compile time. The marker makes NuGet refuse that project at restore, and it
    matches each dependency group to a lib/ folder.
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);TraconPackFrameworkMarker</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="TraconPackFrameworkMarker">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)_._" PackagePath="lib/$(TargetFramework)" />
    </ItemGroup>
  </Target>

  <ItemGroup Label="Tracon components in the meta package (no storage engine)">
    <ProjectReference Include="../Tracon.AspNetCore/Tracon.AspNetCore.csproj" />
    <ProjectReference Include="../Tracon.Mcp/Tracon.Mcp.csproj" />
    <ProjectReference Include="../Tracon.OpenAI/Tracon.OpenAI.csproj" />
    <ProjectReference Include="../Tracon.UI/Tracon.UI.csproj" />
    <ProjectReference Include="../Tracon.Workflows/Tracon.Workflows.csproj" />
  </ItemGroup>

</Project>
