<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>SQLite persistence layer for AgentPrism. Single-file setup: for demos, embedded scenarios, and testing with real SQL behavior. Ships with embedded SQL migrations. Single-writer; not for use in a multi-instance deployment.</Description>
    <PackageTags>$(CommonPackageTags);sqlite;persistence;embedded</PackageTags>
  </PropertyGroup>

  <!--
    AOT status NOT MEASURED (Phase 24 opening). SQLitePCLRaw carries a native
    library; this usually affects publish behavior. The flag stays on the
    safe side until measured. Rationale: docs/KARARLAR.md, decision K-190;
    status table MIMARI.md section 9.
  -->
  <PropertyGroup Label="Trim / AOT">
    <AgentPrismAotCompatible>false</AgentPrismAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentPrism.Core/AgentPrism.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!--
      CVE pinning (see Directory.Packages.props). Since transitive pinning is
      off (K-007), a version is forced with a single deliberate PackageReference.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup Label="Embedded SQL migrations (Phase 24)">
    <EmbeddedResource Include="Migrations/**/*.sql" />
  </ItemGroup>

  <!--
    Shared source (Phase 23). AgentPrism.Sql.Shared is NOT a package; the same
    files also compile into AgentPrism.PostgreSql and AgentPrism.SqlServer.
    Rationale: K-176.
  -->
  <ItemGroup Label="Shared SQL source (Phase 23)">
    <Compile Include="../AgentPrism.Sql.Shared/**/*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!--
    AgentPrism.Sql.Shared.UnitTests (phase 94) checks the SQL text of the three
    providers side by side and cannot use the "$(MSBuildProjectName).UnitTests"
    convention below (that name belongs to a single provider). No Docker
    dependency: it never opens a connection, only builds a query-set object.
  -->
  <ItemGroup Label="Internal visibility - cross-provider SQL text tests (phase 94)">
    <InternalsVisibleTo Include="AgentPrism.Sql.Shared.UnitTests" />
  </ItemGroup>

</Project>
