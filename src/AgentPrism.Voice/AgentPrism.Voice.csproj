<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>AgentPrism icin ses tool'lari. Metinden ses (TTS) ve sesten metin (STT); uretilen ses ek deposunda yasar. Saglayici soyutlamasi ElevenLabs uygulamasiyla birlikte gelir.</Description>
    <PackageTags>$(CommonPackageTags);voice;speech;tts;stt;elevenlabs</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentPrism.Core/AgentPrism.Core.csproj" />
  </ItemGroup>

  <!--
    HICBIR NuGet paketi alinmaz. Kullanilan yuzey uc HTTP ucundan ibarettir
    (/v1/text-to-speech, /v1/speech-to-text, /v2/voices) ve JSON sozlesmesi
    basittir; ham HttpClient + System.Text.Json kaynak ureteci ile paket AOT
    uyumlu kalir.

    Bir topluluk SDK'si bakim ve surum riskini tuketiciye tasirdi (K-007) ve
    Faz 27 bir SDK'nin merkezi surum yonetimi altinda calisma aninda SESSIZCE
    kirilabildigini olcerek gosterdi (K-211).
  -->

</Project>
