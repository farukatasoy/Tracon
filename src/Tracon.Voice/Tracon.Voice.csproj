<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Voice tools for Tracon. Text-to-speech (TTS) and speech-to-text (STT); generated audio lives in the attachment store. The provider abstraction ships with an ElevenLabs implementation.</Description>
    <PackageTags>$(CommonPackageTags);voice;speech;tts;stt;elevenlabs</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Tracon.Core/Tracon.Core.csproj" />
  </ItemGroup>

  <!--
    NO NuGet package is taken on. The surface used is only three HTTP
    endpoints (/v1/text-to-speech, /v1/speech-to-text, /v2/voices) and the
    JSON contract is simple; raw HttpClient + System.Text.Json source
    generation keeps the package AOT compatible.

    A community SDK would carry maintenance and version risk to the consumer
    (K-007), and Phase 27 measured that an SDK can break SILENTLY at run time
    under centralized version management (K-211).
  -->

</Project>
