{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {
        "NODE_EXTRA_CA_CERTS": "/opt/homebrew/etc/ca-certificates/cert.pem"
      }
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "env": {
        "NODE_EXTRA_CA_CERTS": "/opt/homebrew/etc/ca-certificates/cert.pem"
      }
    }
  }
}