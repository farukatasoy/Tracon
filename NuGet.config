<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Yalnizca nuget.org kullanilir. clear, makine genelindeki kaynaklari devre disi birakir;
    boylece her gelistiricide ve CI'da ayni paketler cozulur.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
