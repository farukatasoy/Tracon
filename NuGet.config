<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Only nuget.org is used. `clear` disables the machine-wide sources,
    so every developer and CI resolve the same packages.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
