{
  "name": "@tracon/client",
  "version": "0.0.0",
  "description": "Typed TypeScript client for the Tracon management API, generated from its OpenAPI document.",
  "license": "PolyForm-Small-Business-1.0.0",
  "type": "module",
  "homepage": "https://tracon.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farukatasoy/Tracon.git",
    "directory": "packages/tracon-client"
  },
  "bugs": {
    "url": "https://github.com/farukatasoy/Tracon/issues"
  },
  "keywords": [
    "ai-agents",
    "microsoft-agent-framework",
    "openapi",
    "tracon"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
