<Project>

  <!--
    Kok seviyesi ortak hedefler. Props dosyasindan SONRA, proje dosyasindan sonra yuklenir.
    Bu yuzden projelerin belirledigi ozelliklere gore kosul yazabiliriz.
  -->

  <!--
    Paket dogrulama Faz 7'de acilir. O zamana kadar yayinlanmis bir taban surum
    olmadigi icin PackageValidationBaselineVersion cozulmez ve build kirilir.
  -->
  <PropertyGroup Condition=" '$(IsPackable)' == 'true' AND '$(EnablePackageValidationGate)' == 'true' ">
    <EnablePackageValidation>true</EnablePackageValidation>
    <EnableStrictModeForCompatibleTfms>true</EnableStrictModeForCompatibleTfms>
    <EnableStrictModeForCompatibleFrameworksInPackage>true</EnableStrictModeForCompatibleFrameworksInPackage>
  </PropertyGroup>

  <!--
    Yayinlanabilir her paket icin Public API takip dosyalari. Analyzer bu dosyalari
    AdditionalFiles olarak bekler. EnablePublicApiTracking false iken analyzer
    yuklu kalir ama tanilar NoWarn ile susturulur (bkz. Directory.Build.props).
  -->
  <ItemGroup Condition=" '$(IsPackable)' == 'true' ">
    <AdditionalFiles Include="PublicAPI.Shipped.txt" Condition="Exists('PublicAPI.Shipped.txt')" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" Condition="Exists('PublicAPI.Unshipped.txt')" />
    <AdditionalFiles Include="BannedSymbols.txt" Condition="Exists('BannedSymbols.txt')" />
  </ItemGroup>

  <!--
    Yayinlanabilir paketlerde README.md zorunludur. NuGet.org paket sayfasinda
    gorunur ve eksikse NU5039 uyarisi build'i kirar. Bu hedef eksikligi
    anlasilir bir mesajla erken yakalar.
  -->
  <Target Name="AgentPrismValidatePackageReadme" BeforeTargets="GenerateNuspec" Condition=" '$(IsPackable)' == 'true' ">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/README.md')"
           Code="AGENTPRISM0001"
           Text="Yayinlanabilir paket '$(MSBuildProjectName)' icin README.md eksik. NuGet paket sayfasinda gorunecek bir README.md dosyasi ekleyin." />
  </Target>

</Project>
