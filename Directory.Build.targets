<Project>

  <!--
    Root-level shared targets. Loaded AFTER the props file and AFTER the project file,
    so conditions can depend on properties the projects set.
  -->

  <!--
    Trim / AOT flag. This derivation is deliberately in targets: src/Directory.Build.props
    is loaded before the csproj body, so assigning IsAotCompatible there would not see a
    csproj's <TraconAotCompatible>false</...> choice and the flag would stay true with
    no way back. Measured: Tracon.AspNetCore produced IL2026/IL3050 for minimal API
    routing even though it set false.
  -->
  <PropertyGroup Condition=" '$(TraconAotCompatible)' == 'true' ">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    Baseline validation - release package only. `scripts/gate.py release` and the
    `scripts/gate.py pack` of the CI build job restore the packages of the last published
    version into an ISOLATED cache, using the same pack builder, and pass three properties:
    TraconPackageBaselineRoot, TraconPackageBaselineVersion, TraconApiCompatReportDir.
    When the root is empty nothing is derived; a day-to-day pack reads no baseline from
    the network.

    The derivation is here DELIBERATELY: the condition looks at the csproj body
    (IncludeBuildOutput, PackAsTool, TraconPackageFirstRelease), while
    src/Directory.Build.props is loaded before the body. The package id is
    $(MSBuildProjectName): the repository convention is project name = package id.

    Because PackageValidationBaselinePath is set, the SDK adds no PackageDownload;
    the baseline is NOT read from the developer's cache.

    🚨 The report path is always set TOGETHER with the flag and derived from the project
    name. If the path stayed empty, the SDK would write the report into the source tree
    (CompatibilitySuppressions.xml) and every later pack would read it as a suppression
    input - the break would be hidden for good. The generation flag also turns strict
    errors into a file; the gate counts any entry that does not carry
    IsBaselineSuppression as an error (scripts/breaking_changes.py).
  -->
  <PropertyGroup Condition=" '$(TraconPackageBaselineRoot)' != '' AND '$(TraconPackageBaselineVersion)' != '' AND '$(TraconApiCompatReportDir)' != '' AND '$(IsPackable)' == 'true' AND '$(IncludeBuildOutput)' != 'false' AND '$(PackAsTool)' != 'true' AND '$(TraconPackageFirstRelease)' != 'true' ">
    <_TraconPackageBaselineId>$(MSBuildProjectName.ToLowerInvariant())</_TraconPackageBaselineId>
    <_TraconPackageBaselineVersion>$(TraconPackageBaselineVersion.ToLowerInvariant())</_TraconPackageBaselineVersion>
    <PackageValidationBaselinePath>$([MSBuild]::NormalizePath('$(TraconPackageBaselineRoot)', '$(_TraconPackageBaselineId)', '$(_TraconPackageBaselineVersion)', '$(_TraconPackageBaselineId).$(_TraconPackageBaselineVersion).nupkg'))</PackageValidationBaselinePath>
    <ApiCompatGenerateSuppressionFile>true</ApiCompatGenerateSuppressionFile>
    <ApiCompatSuppressionOutputFile>$([MSBuild]::NormalizePath('$(TraconApiCompatReportDir)', '$(MSBuildProjectName).xml'))</ApiCompatSuppressionOutputFile>
  </PropertyGroup>

  <!--
    The three properties come together. If only the root were given and the report
    directory forgotten, the derivation would be skipped silently and pack would
    return "green" with no baseline.
  -->
  <Target Name="TraconValidatePackageBaselineInputs" BeforeTargets="GenerateNuspec"
          Condition=" '$(IsPackable)' == 'true' AND '$(TraconPackageBaselineRoot)' != '' ">
    <Error Condition=" '$(TraconPackageBaselineVersion)' == '' OR '$(TraconApiCompatReportDir)' == '' "
           Code="TRACON0007"
           Text="TraconPackageBaselineRoot was set for package '$(MSBuildProjectName)' without TraconPackageBaselineVersion and TraconApiCompatReportDir. The three properties come together; scripts/gate.py release passes all of them." />
  </Target>

  <!--
    Public API tracking files for every packable package. The analyzer expects these
    files as AdditionalFiles; the analyzer itself is added in src/Directory.Build.props
    through TraconPublicApiTrackingEnabled (switch off per project).
  -->
  <ItemGroup Condition=" '$(IsPackable)' == 'true' ">
    <AdditionalFiles Include="PublicAPI.Shipped.txt" Condition="Exists('PublicAPI.Shipped.txt')" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" Condition="Exists('PublicAPI.Unshipped.txt')" />
    <AdditionalFiles Include="BannedSymbols.txt" Condition="Exists('BannedSymbols.txt')" />
  </ItemGroup>

  <!--
    A README.md is mandatory in packable packages. NuGet.org shows it on the package
    page, and if it is missing, the NU5039 warning breaks the build. This target catches
    the omission early with a clear message.
  -->
  <Target Name="TraconValidatePackageReadme" BeforeTargets="GenerateNuspec" Condition=" '$(IsPackable)' == 'true' ">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/README.md')"
           Code="TRACON0001"
           Text="The package '$(MSBuildProjectName)' has no README.md. NuGet.org shows the README.md on the package page. Add a README.md file to the project folder." />
  </Target>

  <!--
    A <id, version> pair must name ONE
    artifact. MinVer derives the version from git height alone (src/Directory.Build.props,
    "Versioning" label) - the WORKING TREE'S state is not an input to it, so a
    commit-less edit and a clean tree can pack to the SAME version with
    DIFFERENT content. This gate closes that gap at the only point `dotnet pack`
    accepts one: right before the .nuspec is written.

    Runs BeforeTargets="GenerateNuspec", exactly like TraconValidatePackageReadme
    above - GenerateNuspec is part of the `Pack` target chain only, so a plain
    `dotnet build`/`dotnet test` invocation never reaches this target and is
    never blocked by it.

    A source tree with no git (a source tarball) or a machine without a `git`
    executable is deliberately NOT an error here: `scripts/gate.py release` is the
    primary defense and performs its own git check; this MSBuild gate is the
    SECOND line, not the only one.

    TraconSkipCleanWorkingTreeCheck bypasses this entire target regardless
    of git state. It exists ONLY for Tracon's own iteration-loop tooling -
    `scripts/gate.py close`'s pack step and the `dotnet pack` calls inside
    Tracon.Package.Tests' ReleaseArtifactFixture/TemplateFixture - which
    validate the PACKAGING CONTRACT (README, icon, template installability) during
    normal development and are never the source of a published artifact (without
    this, the closing gate could never pass on an uncommitted tree, and every local
    test run would first need a commit).
    A real release candidate NEVER sets this property: `scripts/gate.py release`
    (the release rehearsal) and `scripts/gate.py pack` - the build job's
    pack whose files a `v*` tag actually publishes - both leave it
    unset, so THEY stay fully gated.
  -->
  <Target Name="TraconValidateCleanWorkingTree" BeforeTargets="GenerateNuspec"
          Condition=" '$(IsPackable)' == 'true' AND '$(TraconSkipCleanWorkingTreeCheck)' != 'true' ">
    <Exec Command="git rev-parse --is-inside-work-tree"
          ContinueOnError="WarnAndContinue"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="TraconGitProbeExitCode" />
    </Exec>

    <PropertyGroup Condition=" '$(TraconGitProbeExitCode)' == '0' ">
      <TraconInsideGitWorkTree>true</TraconInsideGitWorkTree>
    </PropertyGroup>

    <!--
      No path is passed to `git status`: run from anywhere inside the repo, it
      reports the WHOLE working tree, not just $(MSBuildProjectDirectory) - a
      commit-less edit to a shared file like this one must block every package,
      not only the one whose directory happens to contain the edit.
      The porcelain flag intentionally is NOT paired with -uno: an untracked
      file is just as unaccountable as a modified tracked one, and the SDK's default
      `Compile` glob (`**/*.cs`) can silently pull an untracked .cs file INTO
      the packed assembly.
    -->
    <Exec Condition=" '$(TraconInsideGitWorkTree)' == 'true' "
          Command="git status --porcelain"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" ItemName="TraconGitStatusLine" />
    </Exec>

    <!--
      The dirty ENTRIES travel with the error. Without them the message says only
      "something changed", repeated once per packable project, and a failure on a
      machine the reader cannot inspect (a CI runner) is undiagnosable: the
      `git status` output above is deliberately low-importance, so it never
      reaches the log. This carries the gate's evidence.
    -->
    <PropertyGroup Condition=" '$(TraconInsideGitWorkTree)' == 'true' AND '@(TraconGitStatusLine->Count())' != '0' ">
      <TraconWorkingTreeDirty>true</TraconWorkingTreeDirty>
      <TraconDirtyEntries>@(TraconGitStatusLine, ' | ')</TraconDirtyEntries>
    </PropertyGroup>

    <Error Condition=" '$(TraconWorkingTreeDirty)' == 'true' AND '$(TraconAllowDirtyPack)' != 'true' "
           Code="TRACON0004"
           Text="Working tree is not clean ('git status --porcelain' reported changes) for package '$(MSBuildProjectName)'. A packed artifact whose content cannot be traced back to a commit has no provenance; commit or stash first. Reported entries: $(TraconDirtyEntries). For local experimentation only, set TraconAllowDirtyPack=true together with an explicit MinVerVersionOverride carrying 'dirty' (e.g. 0.0.0-dirty.&lt;name&gt;) - never in CI." />

    <Error Condition=" '$(TraconWorkingTreeDirty)' == 'true' AND '$(TraconAllowDirtyPack)' == 'true' AND ( '$(ContinuousIntegrationBuild)' == 'true' OR '$(CI)' == 'true' ) "
           Code="TRACON0005"
           Text="TraconAllowDirtyPack=true was set in a CI build (ContinuousIntegrationBuild=true or CI=true). A dirty pack has no provenance and must never leave a developer's machine." />

    <Error Condition=" '$(TraconWorkingTreeDirty)' == 'true' AND '$(TraconAllowDirtyPack)' == 'true' AND '$(ContinuousIntegrationBuild)' != 'true' AND '$(CI)' != 'true' AND !$(MinVerVersionOverride.Contains('dirty')) "
           Code="TRACON0006"
           Text="TraconAllowDirtyPack=true requires an explicit MinVerVersionOverride that carries 'dirty' (e.g. 0.0.0-dirty.&lt;name&gt;). A dirty artifact must sort BELOW every clean release version, and it must never be produced by MinVer's own automatic derivation - that is exactly how a dirty pack once masqueraded as a clean one." />
  </Target>

</Project>
