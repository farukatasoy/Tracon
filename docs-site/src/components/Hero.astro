---
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
import HeldTape from './landing/HeldTape.astro';
const home = Astro.locals.starlightRoute.id === '';
---
{home ? <section class="lx-hero" aria-labelledby="_top" data-tile>
  <div class="lx-hero-copy">
    <p class="section-label">Tracon / Approach control for your agents</p>
    <h1 id="_top">The .NET <span>control plane</span> for Microsoft Agent Framework.</h1>
    <p class="lx-lede">A package family that runs inside your own ASP.NET Core host. MAF runs your agents. Tracon records them, scopes them to a tenant, and governs what they may call.</p>
    <div class="lx-install"><span class="lx-install-label" aria-hidden="true">Install</span><code id="lx-install-cmd">dotnet add package Tracon <span>--prerelease</span></code><button type="button" class="lx-copy" data-copy="lx-install-cmd" hidden>Copy<span class="sr-only"> the install command</span></button><span class="sr-only" role="status" data-copy-status> </span></div>
    <div class="lx-actions"><a class="lx-primary" href="/getting-started/">Get started <span aria-hidden="true">→</span></a><a class="lx-text-action" href="/capabilities/">Capability map <span aria-hidden="true">→</span></a></div>
    <p class="lx-status">Production-oriented preview packages are on <a href="https://www.nuget.org/packages/Tracon">NuGet</a> and <a href="https://www.npmjs.com/package/@tracon/client">npm</a>. No stable version yet. <a href="https://github.com/farukatasoy/Tracon">Source on GitHub<span aria-hidden="true"> ↗</span></a></p>
  </div>
  <HeldTape />
</section> : <DefaultHero />}
