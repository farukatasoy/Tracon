---
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
const home = Astro.locals.starlightRoute.id === '';
---
{home ? <section class="approach-hero" aria-labelledby="_top">
  <div class="hero-copy">
    <p class="section-label">Tracon / Approach control for your agents</p>
    <h1 id="_top">The .NET <span>control plane</span> for Microsoft Agent Framework.</h1>
    <p class="hero-description">A package family that runs inside your own ASP.NET Core host. MAF runs your agents. Tracon records them, scopes them to a tenant, and governs what they may call.</p>
    <div class="hero-actions">
      <a class="primary-action" href="/getting-started/">What Tracon is <span aria-hidden="true">↗</span></a>
      <a class="text-action" href="/capabilities/">Capability map <span aria-hidden="true">→</span></a>
    </div>
    <p class="release-status">In development. Not yet published to NuGet or npm.</p>
  </div>
  <figure class="hero-figure console-shot">
    <div class="scope-rings" aria-hidden="true"><i></i><i></i><i></i><b></b></div>
    <img class="shot-light" src="/screenshots/dashboard-light.png" alt="The Tracon console showing recorded runs, token use, and recent activity" width="2880" height="1800" loading="eager" decoding="async" fetchpriority="high" />
    <img class="shot-dark" src="/screenshots/dashboard.png" alt="The Tracon console showing recorded runs, token use, and recent activity" width="2880" height="1800" loading="lazy" decoding="async" />
    <figcaption>The embedded console, captured from a local sample with seeded runs.</figcaption>
  </figure>
</section> : <DefaultHero />}
