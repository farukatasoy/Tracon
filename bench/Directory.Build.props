<Project>

  <!-- Load the root Directory.Build.props first. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    A measurement project, not a package and not a test project.

    NOT under tests/: tests/Directory.Build.props sets IsTestProject=true, which
    makes `dotnet test` try to run every project under tests/ - a BenchmarkDotNet
    project is not a test project and has no [Fact]s for it to find. That same
    file also force-adds xunit.v3/NSubstitute/Shouldly to every project under
    tests/, none of which this project wants. Rationale: docs/116-PERFORMANS-TAHSIS-KAPISI.md, 116.3.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Suppress the warning NuGet emits for non-packable projects when `dotnet pack` runs on the solution. -->
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
    <!-- XML documentation is noise here; nothing requires it. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
