{
  "name": "sweep",
  "description": "Three scenarios across four concurrency steps, empty and full database, three repeats.",
  "scenarios": [
    "buffered",
    "streaming",
    "queued"
  ],
  "scenarioGrouping": "separate",
  "concurrency": [
    1,
    8,
    32,
    64
  ],
  "seedShapes": [
    "empty",
    "full"
  ],
  "repeats": 3,
  "warmupSeconds": 15,
  "measureSeconds": 60,
  "runsPerTenant": 0,
  "workload": {
    "requestBytes": 1024,
    "modelDelayMilliseconds": 1000,
    "outputChunks": 20,
    "outputChunkCharacters": 256,
    "toolResultBytes": 1024,
    "toolCall": true
  },
  "limits": {
    "maxInFlight": 128,
    "hostRssBytes": 4294967296,
    "driverRssBytes": 1073741824,
    "databaseBytes": 5368709120,
    "minimumFreeDiskBytes": 10737418240,
    "maxRequestSamples": 200000
  },
  "requestTimeoutSeconds": 120,
  "drainTimeoutSeconds": 300,
  "maxConcurrentJobs": 8,
  "maxPoolSize": 100,
  "resourceSampleIntervalSeconds": 1,
  "seedRuns": 10000
}
