  ],
  "seedShapes": [
    "empty"
  ],
  "repeats": 1,
  "warmupSeconds": 30,
  "measureSeconds": 0,
  "runsPerTenant": 0,
  "tenantRamp": {
    "tenantPrefix": "ramp-",
    "stages": [
      { "tenants": 2, "runsPerNewTenant": 3, "holdSeconds": 75 },
      { "tenants": 20, "runsPerNewTenant": 2, "holdSeconds": 75 },
      { "tenants": 200, "runsPerNewTenant": 2, "holdSeconds": 75 }
    ],
    "idleSeconds": 20,
    "collectIntervalSeconds": 5,
    "bucketSeconds": 5,
    "tenantTag": false
  },
  "workload": {
