    "toolCall": true
  },
  "limits": {
    "maxInFlight": 128,
    "hostRssBytes": 1610612736,
    "driverRssBytes": 1073741824,
    "databaseBytes": 2147483648,
    "minimumFreeDiskBytes": 10737418240,
    "maxRequestSamples": 200000
  },
  "requestTimeoutSeconds": 120,
  "drainTimeoutSeconds": 120,
  "maxConcurrentJobs": 8,
  "maxPoolSize": 100,
  "resourceSampleIntervalSeconds": 1,
  "seedRuns": 0
}
