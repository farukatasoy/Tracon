{
  "name": "tenant-ramp-short",
  "description": "A five-minute tenant ramp (2, 20, 200 tenants) that proves the footprint apparatus can see growth: it is a development profile, not a measurement. Its plateaus are too short to rule out a slow leak, and the report says how slow a leak it could not have seen.",
  "scenarios": [
    "buffered",
    "streaming",
    "queued"
  ],
  "scenarioGrouping": "mixed",
  "concurrency": [
