<Project>

  <!--
    Central Package Management.
    Versions are defined only here. Projects write <PackageReference Include="..." />
    without a Version, so version drift cannot happen.

    Microsoft Agent Framework version note:
      GA     -> Microsoft.Agents.AI, .Abstractions, .OpenAI, .Workflows, .Harness
      preview-> Microsoft.Agents.AI.Hosting
      alpha  -> Microsoft.Agents.AI.Hosting.OpenAI
    Preview/alpha dependencies are collected only in Tracon.AspNetCore.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- All MAF GA packages move on the same version. -->
    <MicrosoftAgentsAIVersion>1.26.0</MicrosoftAgentsAIVersion>
    <!--
      MEAI 10.11.0 requires System.Text.Json >= 10.0.13 (measured 2026-10-16:
      nuspec); staying on 10.0.11 gives NU1605 (package downgrade) and breaks
      restore under TreatWarningsAsErrors. This line is a REQUIRED consequence of
      the MEAI upgrade, not a separate choice.
    -->
    <MicrosoftExtensionsVersion>10.0.14</MicrosoftExtensionsVersion>
  </PropertyGroup>

  <ItemGroup Label="Microsoft Agent Framework - GA">
    <PackageVersion Include="Microsoft.Agents.AI" Version="$(MicrosoftAgentsAIVersion)" />
    <PackageVersion Include="Microsoft.Agents.AI.Abstractions" Version="$(MicrosoftAgentsAIVersion)" />
    <PackageVersion Include="Microsoft.Agents.AI.Harness" Version="$(MicrosoftAgentsAIVersion)" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="$(MicrosoftAgentsAIVersion)" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="$(MicrosoftAgentsAIVersion)" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions.AI evaluation - GA">
    <!--
      A new package needs a justification. This is not an ADDITION; it makes an
      existing transitive dependency EXPLICIT. `Microsoft.Extensions.AI.Evaluation`
      10.11.0 is ALREADY in the Tracon.Core/AspNetCore/Cli graphs; `Microsoft.Agents.AI`
      1.26.0 brings it with a 10.10.0 lower bound (measured 2026-10-28: nuspec).
      The `IEvaluator` bridge (EvaluatorRunJudge) binds to that interface DIRECTLY, so
      relying on a transitive reference is fragile - MAF may drop it one day.
      Net transitive weight: 0.

      `Microsoft.Extensions.AI.Evaluation.Quality` (the calibrated evaluator catalog)
      deliberately enters NO shipped package; only the test and sample projects
      reference it. A consumer who wants the catalog adds it and wires it with
      `AddEvaluatorJudge`. Whoever does not use it sees no growth in the graph.
    -->
    <PackageVersion Include="Microsoft.Extensions.AI.Evaluation" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Evaluation.Quality" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup Label="Microsoft Agent Framework - prerelease (Tracon.AspNetCore only)">
    <!--
      A prerelease upstream range is EXACT ([x]). An open lower bound
      (`>= x`) let a consumer's upgrade restore without a warning and fail at run
      time: a published Tracon.AspNetCore 1.0.0-preview.2 running with Hosting
      1.22.0-preview found no `Microsoft.Agents.AI.Hosting.AgentSessionStore` (it moved
      to another assembly with no forwarder). With an exact range NuGet reports the same
      situation at restore (NU1608 direct, NU1107 transitive). Stable third-party
      packages stay on a lower bound. Guards: ReleaseArtifactTests.
      EveryPrereleaseThirdPartyDependencyIsExact and `gate.py release`. An upgrade
      changes these five lines TOGETHER.
    -->
    <PackageVersion Include="Microsoft.Agents.AI.Hosting" Version="[1.26.0-preview.261023.1]" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.OpenAI" Version="[1.26.0-alpha.261023.1]" />
    <!--
      The A2A server that exposes Tracon. Same version line
      (1.26.0-preview.261023.1), Tracon.AspNetCore only.
      `Microsoft.Agents.AI.Hosting.AspNetCore` is needed too: `AddA2AServer` only
      REGISTERS, and the HTTP endpoint is exposed by the `MapA2A`/`MapHttpA2A`
      extensions of `A2A.AspNetCore`. Measured incremental cost: A2A, A2A.AspNetCore,
      Microsoft.Agents.AI.Hosting.A2A, Microsoft.Agents.AI.Hosting.AspNetCore
      (4 packages, all the same SDK family; no foreign dependency).
    -->
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.A2A" Version="[1.26.0-preview.261023.1]" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.AspNetCore" Version="[1.26.0-preview.261023.1]" />
    <PackageVersion Include="A2A.AspNetCore" Version="[1.0.0-preview3]" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions.AI">
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
  </ItemGroup>

  <!--
    Explicit PackageReference for pre-flight token counting. Until now
    `Microsoft.ML.Tokenizers` was only a transitive dependency of MAF and was not
    called directly; here Tracon is the CALLER, so trusting the transitive version
    would break the build if the upstream package drops it.
  -->
  <ItemGroup Label="Pre-flight token counting">
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions - hosting and DI">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <!--
      No shipped package depends on this line - the Tracon libraries make do with
      Hosting.Abstractions. The full generic host is used by two consumers:
      tests/Tracon.WorkerHarness (the worker KILLED by the two-process failure proof)
      and samples/Tracon.Samples.ExtensionAotSmoke (starts a real host under Native
      AOT; the package-family alignment check runs there).
    -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>

  <!--
    Provider SDKs. All three are OFFICIAL first-party packages; no community package
    was used. All three carry their own `AsIChatClient` adapter, so Tracon writes no
    message mapping, streaming or tool-call code.

    The transitive weight of Google.GenAI was accepted knowingly: Newtonsoft.Json,
    System.Management and System.CodeDom arrive through Google.Apis.Auth. The
    dependency is only in the Tracon.Google package; a consumer that does not use
    Gemini gets none of them.
  -->
  <ItemGroup Label="Providers">
    <PackageVersion Include="Anthropic" Version="13.3.0" />
    <PackageVersion Include="Google.GenAI" Version="1.27.0" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <!--
      Azure OpenAI. Tracon.Azure talks to the resource's v1
      endpoint ({endpoint}/openai/v1/) through the plain OpenAI SDK; the Azure
      SDK `Azure.AI.OpenAI` is no longer used (its stable line stopped at 2.1.0 in
      December 2024, built against OpenAI 2.1.0, and its request extensions threw
      MissingMethodException against the OpenAI version in use).

      Azure.Core is written directly because Tracon.Azure's PUBLIC API carries
      Azure.Core.TokenCredential (credential factory); a transitive
      dependency's type in the public surface would be fragile. TokenCredential
      is an AuthenticationTokenProvider, so System.ClientModel's BearerTokenPolicy
      wraps it without Azure.Identity or Azure.AI.OpenAI.
    -->
    <PackageVersion Include="Azure.Core" Version="1.64.0" />
  </ItemGroup>

  <ItemGroup Label="Data access">
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!--
      Vector store connectors for the sample host and the tests only. No shipped package
      references one: the vector store is the host's own registration. CommunityToolkit.VectorData.* is
      the maintained line of Microsoft.Extensions.VectorData connectors (1.0 GA, built against
      Microsoft.Extensions.VectorData.Abstractions 10.8). 🚨 The Microsoft.SemanticKernel.Connectors.*
      line (1.74.0-preview, the latest) is NOT usable here: every one of them calls
      VectorSearchOptions.OldFilter, which Abstractions 10.7 removed, and declares 10.1.0 as its floor, so
      NuGet raises no warning and a search fails with MissingMethodException at run time (measured on the
      sample host, 2026-10-22).
    -->
    <PackageVersion Include="CommunityToolkit.VectorData.PgVector" Version="1.0.1" />
    <PackageVersion Include="CommunityToolkit.VectorData.InMemory" Version="1.0.1" />
    <!--
      SQL Server driver. NOT marked for trimming/AOT; therefore
      Tracon.SqlServer sets TraconAotCompatible=false.
    -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!--
      CVE enforcement. Every SqlClient release (7.0.2 through 7.1.1, measured
      2026-10-14) pulls a System.Security.Cryptography.Pkcs with open advisories:
      net8.0 8.0.1, net9.0/net10.0 9.0.13 and 9.0.18 (GHSA-846f-f764-76mx high,
      GHSA-2fmv-rv2c-59x7 medium). Re-measured 2026-10-16, 2026-10-28 and 2026-10-31
      (SqlClient 7.1.1, still the latest; an empty project, NuGetAudit): net8.0 8.0.1,
      net9.0/net10.0 9.0.18, and both warnings stand (NU1902 + NU1903). The platform
      patch 10.0.14 does not affect this package; 10.0.13 stays as the patched floor.
      Upgrading SqlClient does not close this.
      CentralPackageTransitivePinningEnabled is off, so the version is forced with a
      direct PackageReference in Tracon.SqlServer; this takes precedence over
      SqlClient's version in the consumer's graph as well. The packages target only
      net10.0, so one line is enough. The version follows the target framework: a new
      framework gets its own patched version (the old net8.0/net9.0 lines were 8.0.2
      and 9.0.21; 10.0.13 would have brought Microsoft.Bcl.Cryptography and
      System.Formats.Asn1 to them as well). When SqlClient pulls a patched version
      itself, this line is removed.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!--
      SQLite driver. SQLitePCLRaw carries a native library; the AOT/publish
      effect is measured.
      The SQLitePCLRaw version is a dependency of Microsoft.Data.Sqlite (10.0.14 ->
      2.1.13, no open advisory); the old CVE pins are gone.
    -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <!--
    The optional EF Core dimension of samples/Tracon.Embedded - it shows that two
    connection planes meet on the SAME NpgsqlDataSource
    (docs-site/src/content/docs/guides/ef-core.md). Tracon does not use EF Core;
    this dependency lives only under samples/ and enters no shipped package.
    Same version series as Npgsql 10.0.3.
  -->
  <ItemGroup Label="Sample-only: EF Core">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!--
    The optional Redis cache of samples/Tracon.Api - the two-process run of
    `Tracon:Mcp:OAuthTokenStore = DistributedCache` needs an `IDistributedCache`
    shared between processes. Tracon does not depend on Redis; this dependency
    lives only under samples/ and enters no shipped package.
  -->
  <ItemGroup Label="Sample-only: Redis distributed cache">
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.9" />
  </ItemGroup>

  <!--
    Conditional OTLP export of samples/Tracon.AppHost (Aspire) and samples/Tracon.Api.
    These packages live only under samples/ and enter the graph of no shipped package;
    Tracon exposes its own `ActivitySource` and `Meter` names, and the consumer's
    application chooses the export (docs-site guides/observability.md).
    The `Aspire.AppHost.Sdk` version lives in the csproj's `Sdk=` attribute (13.6.5);
    it must match the hosting package here.
  -->
  <ItemGroup Label="Sample-only: Aspire and OpenTelemetry">
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
  </ItemGroup>

  <!--
    MCP client. `.Core`, NOT `ModelContextProtocol`: the full package also pulls
    Microsoft.Extensions.Hosting.Abstractions and Caching.Abstractions, which are for
    server hosting, and Tracon.Mcp is only a client.
    `.Core` dependencies (2.2.0 nuspec, measured 2026-08-21): Microsoft.Extensions.AI.Abstractions
    10.8.3, Logging.Abstractions 10.0.10, System.IO.Pipelines, System.Net.ServerSentEvents.
    The two versioned ones are FLOORS; our pins (10.11.0 and 10.0.14) are higher, so
    NuGet picks ours and no extra package arrives.
  -->
  <ItemGroup Label="Model Context Protocol">
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.3.0" />
    <!--
      The MCP server that exposes Tracon. The `.Core` note above no longer covers
      everything: Tracon is not only a client now. This package enters only
      Tracon.AspNetCore; Tracon.Mcp (the client) stays on `.Core`. Measured (2026-08-07):
      13 transitive packages, all from the Microsoft.Extensions.* family. Re-read at
      2.2.0 (2026-08-21): `.AspNetCore` pulls `ModelContextProtocol` [2.2.0] with a
      fixed version, which pulls `.Core` [2.2.0] + Caching.Abstractions 10.0.10 +
      Hosting.Abstractions 10.0.10. No foreign dependency.
      2.3.0 (2026-10-21): same package list, only the floor versions rose; the
      Tracon.Mcp graph is 32 packages on net10.0 (38/38 on net9.0/net8.0 that day),
      unchanged. API diff: +1 member (`McpClientOptions.TimeProvider`), 0 removals.
    -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <!--
      MCP Tasks extension (2026-07-28 spec). Enters only Tracon.AspNetCore.
      Measured (2026-08-26, real restore, net10.0, clean project): + ModelContextProtocol.AspNetCore
      -> 13 packages, + this package -> 14 packages. Net new transitive packages: ZERO -
      all twelve transitive packages are already in the graph through .AspNetCore.
      Tracon.Mcp (the client) never sees this package, so the boundary holds.
    -->
    <PackageVersion Include="ModelContextProtocol.Extensions.Tasks" Version="2.3.0" />
  </ItemGroup>

  <!--
    AG-UI endpoint (Tracon.AGUI). Reason: AG-UI is a protocol that front ends such as
    CopilotKit speak, and its event converter (MEAI stream -> AG-UI events) is carried by
    these two packages; writing the same converter by hand would mean copying the
    protocol's wire format. Publisher "AG-UI Protocol" (not Microsoft), MIT, owner
    verified on nuget.org, author signature valid (`dotnet nuget verify`, 2026-10-23).
    The only dependency is Microsoft.Extensions.AI.Abstractions >= 10.6.0 (Tracon is on
    10.11.0). Enters only Tracon.AGUI; the graphs of Tracon.AspNetCore and the meta
    package do not change. The version is fixed; since it is stable, the whole family
    ships on a single version line.
  -->
  <ItemGroup Label="AG-UI">
    <PackageVersion Include="AGUI.Server" Version="1.0.1" />
    <PackageVersion Include="AGUI.Abstractions" Version="1.0.1" />
  </ItemGroup>

  <!--
    Official .NET client of the AG-UI protocol (same publisher, same 1.0.1 line). Enters
    ONLY the test project (tests/Tracon.AGUI.FunctionalTests): no shipped package depends
    on it. Reason: the server tests read the event with the protocol SDK's serializer;
    this client reads the wire format with its own parser and runs the event sequence
    through its own state machine (RUN_STARTED ... RUN_FINISHED), so it sees what a
    consumer sees. Its dependencies are AGUI.Formatting 1.0.1 and
    Microsoft.Extensions.AI (10.6.0; Tracon is on 10.11.0).
  -->
  <ItemGroup Label="AG-UI client (test only)">
    <PackageVersion Include="AGUI.Client" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup Label="Analyzers (PrivateAssets=all)">
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.303" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>

  <!--
    Tracon.Generators (tool source generator). It is carried inside Tracon.Core as an
    Analyzer, PrivateAssets=all + ReferenceOutputAssembly=false; it does NOT LEAK into
    the consumer's dependency graph (verified with `dotnet list package`).

    🚨 The version is 5.0.0, NOT NEWER. A generator cannot be newer than the Roslyn of
    the compiler that loads it - if it is, it silently fails to load on an older SDK.
    The packages target net10.0 only; the oldest SDK that can compile a net10.0 project
    is 10.0.100 and it carries Roslyn 5.0.0 (measured 2026-10-16:
    10.0.100 -> 5.0.0 · 10.0.402 -> 5.9.0). The floor is therefore 5.0.0; 5.9.0 does
    not load in SDK 10.0.100. While the packages also targeted net8.0 the floor was
    4.8.0 (the Roslyn of the .NET 8 SDK GA, dotnet/roslyn#70919).
  -->
  <ItemGroup Label="Source generator (Tracon.Generators, IsPackable=false)">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

  <!--
    Test stack: xunit.v3 + Microsoft Testing Platform (MTP).
    Microsoft.NET.Test.Sdk and xunit.runner.visualstudio are deliberately ABSENT - they
    are for VSTest, and `dotnet test` does not work when they are used together with
    xunit.v3.
  -->
  <ItemGroup Label="Test">
    <!--
      The library tests use TestHost, NOT Microsoft.AspNetCore.Mvc.Testing:
      WebApplicationFactory<T> needs an entry-point assembly and Tracon is a library.
      TestHost is enough to start the minimal API endpoints in its own host.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    <!--
      Only for testing an actual application ENTRY POINT (samples/Tracon.Embedded),
      not the library: WebApplicationFactory<T> needs one, and Tracon.* itself
      is a library with none — TestHost above stays the pattern for testing it.
      Same 10.0.14 ASP.NET Core line as TestHost/OpenApi.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <!--
      Only the UI package (not SwaggerGen): the document is already produced by
      Microsoft.AspNetCore.OpenApi (AddOpenApi/MapOpenApi); this package only shows
      /openapi/v1.json on an interactive page. Not used outside samples/Tracon.Api.
    -->
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0" />
    <!-- xunit.v3 4.x is built on Microsoft Testing Platform 2.x; TrxReport pulls the same
         platform version. Running with 1.x gives TypeLoadException at run time. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <!--
      Code coverage for the test projects, opt-in: only a build with
      -p:TraconCoverage=true references it (tests/Directory.Build.props), so a plain
      build, restore, and pack never see it. 18.12.0 asks for Microsoft.Testing.Platform
      2.5.0, the line TrxReport above already pins. Test-only; it never reaches a Tracon package.
    -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <!--
      For the Playwright UI E2E tests. The browser binary does not come with the NuGet
      package; the test fixture downloads it itself when it is missing (see
      tests/Tracon.Ui.E2ETests/Infrastructure/BrowserFixture.cs).
    -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <!--
      Property-based testing (CsCheck): generators, shrinking, and a seed printed with every failure.
      Test-only; it never reaches a Tracon package or a consumer.
    -->
    <PackageVersion Include="CsCheck" Version="5.0.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <!--
      The Testcontainers 4.16.0 patch version pulls SSH.NET 2026.0.0 directly
      (GHSA-q939-rpr3-3284 is closed); the old SSH.NET pin is gone.
      If the pin ever has to come back, measure first in an empty project with `NuGetAudit`.
    -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!--
      Tracon.Testing.Contracts.Xunit is a LIBRARY of abstract
      [Fact]/[Theory] fixtures, not a runnable test project: the plain
      "xunit.v3" package's buildTransitive props force
      <OutputType>Exe</OutputType> (Microsoft Testing Platform's entry point)
      and fail the build of a non-executable project. This sub-package ships
      the SAME xunit.v3.core.dll without that requirement: "test authors
      should include xunit.v3 instead" (its own description); this is not a
      test author, it is the library the test author's project references.

      3.2.2 is the SHIPPED FLOOR, not a stale pin. The
      repo's own tests run on xunit.v3 4.x; this package's nuspec keeps
      asking for ">= 3.2.2" so a consumer still on xunit.v3 3.x restores
      without NU1608. Measured: the preview.4 package (built on 3.2.2) runs
      green on xunit.v3 4.0.2 + TrxReport 2.5.1. Raising it forces every
      consumer to xunit.v3 4 and is a compatibility decision, not a bump
      (.github/dependabot.yml ignores both sub-packages for that reason).
    -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="3.2.2" />
    <!--
      ".extensibility.core" above carries [Fact]/[Theory] and
      IAsyncLifetime but NOT the Assert class (that lives in
      xunit.v3.assert.dll) - ToolArgumentValidationContract needs
      Assert.SkipWhen for a schema shape its generator cannot fuzz (a nested
      object parameter). This sub-package is the assertion library
      alone: no buildTransitive props, so it does not force <OutputType>Exe>
      the way plain "xunit.v3" does. Same shipped floor as above.
    -->
    <PackageVersion Include="xunit.v3.assert" Version="3.2.2" />
    <!--
      Tracon.Azure deliberately does NOT depend on Azure.Identity (see the rationale of
      AzureOpenAIProviderOptions.CredentialFactory): the credential type is left to the
      consumer. The shipped `<example>` still names DefaultAzureCredential; the gate that
      proves every example compiles needs the real type - for tests only, Tracon.Azure's
      own dependency graph does not change.
    -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <!--
    bench/ - a repository discipline, not a shipped capability. The
    project is IsPackable=false and no shipped package references it, so its
    22 transitive packages (Roslyn, Iced, Capstone, TraceEvent - BenchmarkDotNet's
    own disassembly/diagnostics stack) never reach a consumer's dependency
    graph. Line never reached 1.0; 0.15.8 is the latest published version.
  -->
  <ItemGroup Label="Performance measurement (bench/, IsPackable=false)">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

</Project>
