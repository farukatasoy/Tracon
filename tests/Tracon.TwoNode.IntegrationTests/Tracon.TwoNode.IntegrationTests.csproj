<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The two-node acceptance set. Two in-process hosts share ONE database - PostgreSQL or SQL
    Server in a container - and the same scenarios run on both. The contract promises two replicas; this project is the
    proof, and it is the reason the project exists apart from the provider integration projects: those reference
    one SQL provider and no HTTP host, while every behaviour here crosses an HTTP request, the job queue, a
    distributed cache and a database in one test.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Tracon.AspNetCore/Tracon.AspNetCore.csproj" />
    <ProjectReference Include="../../src/Tracon.PostgreSql/Tracon.PostgreSql.csproj" />
    <ProjectReference Include="../../src/Tracon.SqlServer/Tracon.SqlServer.csproj" />
    <ProjectReference Include="../../src/Tracon.Mcp/Tracon.Mcp.csproj" />
    <!-- The secret canary registers model providers by their key. -->
    <ProjectReference Include="../../src/Tracon.OpenAI/Tracon.OpenAI.csproj" />
    <ProjectReference Include="../../src/Tracon.Workflows/Tracon.Workflows.csproj" />
    <!-- The secret canary drives the AG-UI endpoint on the two server databases. -->
    <ProjectReference Include="../../src/Tracon.AGUI/Tracon.AGUI.csproj" />
    <!--
      CliConnectedSecretCanaryAcceptanceContract runs the command-line tool as a process of its own against the container. The
      project is built beside this one; its assembly is not referenced (the test starts it, it does not call it).
    -->
    <ProjectReference Include="../../src/Tracon.Cli/Tracon.Cli.csproj" ReferenceOutputAssembly="false" />
    <!-- Fake model provider (FakeModelProvider). -->
    <ProjectReference Include="../../src/Tracon.Testing/Tracon.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.MsSql" />
    <!--
      TestHost, not Microsoft.AspNetCore.Mvc.Testing: Tracon is a library with no entry point (see
      Tracon.AspNetCore.FunctionalTests). OpenApi: the linked TraconTestHost registers the product document when
      a test asks for it; these tests never do, but the file compiles against it.
    -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <!--
    The host and the helpers every scenario uses, LINKED from the functional test project, not copied: one
    copy of the host means a change to how a test host is built reaches both projects.
  -->
  <ItemGroup>
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/TraconTestHost.cs" LinkBase="Shared" />
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/ProductOpenApiDocument.cs" LinkBase="Shared" />
    <!-- ProductOpenApiDocument registers the document corrections of the reference host; they are one file in the sample. -->
    <Compile Include="../../samples/Tracon.Api/OpenApi/PublishedDocumentCorrections.cs" LinkBase="Shared" />
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/HangingModelProvider.cs" LinkBase="Shared" />
    <Compile Include="../Shared/Time/ManualClock.cs" Link="Shared/Time/ManualClock.cs" />
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/TestData.cs" LinkBase="Shared" />
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/RecordingLoggerProvider.cs" LinkBase="Shared" />
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/McpOAuthKit.cs" LinkBase="Shared" />
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/OAuthProtectedMcpServer.cs" LinkBase="Shared" />
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/OAuthFlowClient.cs" LinkBase="Shared" />
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/LookupMcpServer.cs" LinkBase="Shared" />
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/QueuedWorkflowHarness.cs" LinkBase="Shared" />
    <!-- The secret canary: the same drive, wire server and searches that run on SQLite, here on the two server databases. -->
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/CanaryWireServer.cs" LinkBase="Shared" />
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/CanaryDrive.cs" LinkBase="Shared" />
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/StructuredLogProbe.cs" LinkBase="Shared" />
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/SecretHits.cs" LinkBase="Shared" />
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/LeakProbe.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every date and time a caller can send, driven with the instants a date type breaks on. -->
    <Compile Include="../Shared/DateInputs/*.cs" LinkBase="Shared/DateInputs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The workflow cancellation sweep: the driver the unit tests run in memory and on SQLite, with the graphs it sweeps and
      the plan that numbers the awaited calls of a run. Here it runs where a cancel meets a real server.
    -->
    <Compile Include="../Shared/Workflows/*.cs" LinkBase="Shared/Workflows" />
    <Compile Include="../Shared/Recording/TestRunRecording.cs" Link="Shared/Recording/TestRunRecording.cs" />
    <Compile Include="../Shared/Faults/FaultProxy.cs" Link="Shared/Faults/FaultProxy.cs" />
    <!-- The SQL Server container's database for the hosts: not master, and without the log flush on commit. -->
    <Compile Include="../Shared/Infrastructure/NonDurableSqlServerDatabase.cs" Link="Shared/Infrastructure/NonDurableSqlServerDatabase.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
