<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This project is NOT linked to AgentPrism.Templates/AgentPrism.Testing as
    code: the template package's IncludeBuildOutput=false, there is no build
    output to link against, and AgentPrism.Testing is built in this same
    solution - a PackageReference back to it would form a cycle. Tests run
    the `dotnet` CLI as a subprocess (pack, new install, new/write, build,
    restore, list package, and running the generated app).
  -->

  <ItemGroup>
    <None Include="Baselines/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Phase 157 moved ProcessRunner out of this project and into
    tests/Shared/Infrastructure, where the two-process failure proof can use it
    too. It is LINKED, not copied: one source file, compiled into both
    assemblies. A second copy is the synchronization-copy class this repository
    has paid for five times (K-411).
  -->
  <ItemGroup>
    <Compile Include="../Shared/Infrastructure/ProcessResult.cs" Link="Infrastructure/Shared/ProcessResult.cs" />
    <Compile Include="../Shared/Infrastructure/ProcessRunner.cs" Link="Infrastructure/Shared/ProcessRunner.cs" />
    <Compile Include="../Shared/Infrastructure/ManagedProcess.cs" Link="Infrastructure/Shared/ManagedProcess.cs" />
    <Compile Include="../Shared/Infrastructure/RepoRoot.cs" Link="Infrastructure/Shared/RepoRoot.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AgentPrism.Tests.Common" />
  </ItemGroup>

</Project>
