<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing.XUnit is NOT used:
    that package pulls in xunit v2 (xunit.assert 2.3.0), while this repo uses
    xunit.v3 + Microsoft Testing Platform (tests/Directory.Build.props). Referencing
    both in the same project would cause a FactAttribute/TheoryAttribute clash.
    CSharpGeneratorDriver is used directly instead - same coverage, one test
    runner.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/AgentPrism.Generators/AgentPrism.Generators.csproj" />
    <ProjectReference Include="../../src/AgentPrism.Core/AgentPrism.Core.csproj" />
    <!--
      Phase 73: AgentPrismUsageAnalyzer resolves REAL symbols. APG0101 needs
      MapAgentPrism (AspNetCore) and APG0102 needs UseOpenAI (OpenAI); a stub
      declared in the test source would prove only that the analyzer matches a
      name, not that it matches this package's API.
    -->
    <ProjectReference Include="../../src/AgentPrism.AspNetCore/AgentPrism.AspNetCore.csproj" />
    <ProjectReference Include="../../src/AgentPrism.OpenAI/AgentPrism.OpenAI.csproj" />
    <!--
      Phase 79: Examples/ExampleCompilationTests.cs compiles every shipped
      <example> block, and the 49 blocks are spread across 15 packages
      (measured, docs/79-*.md §79.2). AgentPrism.Abstractions comes in
      transitively through Core; these 11 are the rest.
    -->
    <ProjectReference Include="../../src/AgentPrism.Workflows/AgentPrism.Workflows.csproj" />
    <ProjectReference Include="../../src/AgentPrism.Azure/AgentPrism.Azure.csproj" />
    <ProjectReference Include="../../src/AgentPrism.Anthropic/AgentPrism.Anthropic.csproj" />
    <ProjectReference Include="../../src/AgentPrism.Mcp/AgentPrism.Mcp.csproj" />
    <ProjectReference Include="../../src/AgentPrism.Testing/AgentPrism.Testing.csproj" />
    <ProjectReference Include="../../src/AgentPrism.SqlServer/AgentPrism.SqlServer.csproj" />
    <ProjectReference Include="../../src/AgentPrism.UI/AgentPrism.UI.csproj" />
    <ProjectReference Include="../../src/AgentPrism.PostgreSql/AgentPrism.PostgreSql.csproj" />
    <ProjectReference Include="../../src/AgentPrism.Sqlite/AgentPrism.Sqlite.csproj" />
    <ProjectReference Include="../../src/AgentPrism.Google/AgentPrism.Google.csproj" />
    <ProjectReference Include="../../src/AgentPrism.Voice/AgentPrism.Voice.csproj" />
    <!-- Phase 84: AgentPrismClientServiceCollectionExtensions carries an <example> too; missed when Phase 83 added the package. -->
    <ProjectReference Include="../../src/AgentPrism.Client/AgentPrism.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- Test-only: the AzureOpenAIProviderOptions.CredentialFactory <example> names DefaultAzureCredential. -->
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>

</Project>
