<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../../src/Tracon.OpenAI/Tracon.OpenAI.csproj" />
    <ProjectReference Include="../../src/Tracon.Testing.Contracts.Xunit/Tracon.Testing.Contracts.Xunit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-memory configuration provider for tests that read options from configuration. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

  <!--
    Phase 181: the tests of src/Tracon.Providers.Shared are linked into all four
    provider test projects, so each assembly's compiled copy of the shared
    source is tested.
  -->
  <ItemGroup Label="Shared provider source tests (Phase 181)">
    <Compile Include="../Shared/Providers/**/*.cs" LinkBase="Shared/Providers" />
  </ItemGroup>

  <!--
    Phase 245: the tests of src/Tracon.OpenAI.Shared are linked into both OpenAI-client test projects,
    so each assembly's compiled copy of the shared source is tested. Each project supplies its own
    Infrastructure/StrictWireHarness.cs.
  -->
  <ItemGroup Label="Shared OpenAI source tests (Phase 245)">
    <Compile Include="../Shared/OpenAI/**/*.cs" LinkBase="Shared/OpenAI" />
  </ItemGroup>

</Project>
