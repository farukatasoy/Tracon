<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../../src/AgentPrism.Core/AgentPrism.Core.csproj" />
    <ProjectReference Include="../../src/AgentPrism.Testing.Contracts.Xunit/AgentPrism.Testing.Contracts.Xunit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Test-only: verifying that the AgentPrism:ContentGuard section actually
      binds requires an IConfiguration instance. AgentPrism.Core depends only
      on Configuration.Abstractions and must stay that way.
    -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

  <!--
    Store contract suite (Phase 23; packaged in Phase 98 as
    AgentPrism.Testing.Contracts.Xunit), in-memory side only. The same
    abstract classes also run in AgentPrism.PostgreSql.IntegrationTests and
    AgentPrism.SqlServer.IntegrationTests against their real backends;
    running them here too, from a project with no [assembly: AssemblyFixture]
    and no Testcontainers dependency, means the in-memory store — the
    default a consumer gets when they add no persistence package — is
    verified on a machine with no Docker. TenantCoverageTests (now in
    AgentPrism.SqlServer.IntegrationTests) reflects over SqlRunStore, a type
    this project does not reference, and never ran here.
  -->

</Project>
