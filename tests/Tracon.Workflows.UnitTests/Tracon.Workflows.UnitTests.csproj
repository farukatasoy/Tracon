<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../../src/Tracon.Workflows/Tracon.Workflows.csproj" />
    <!-- The cancellation sweep runs the workflow runner over the real SQLite stores a host gets from UseSqlite(). -->
    <ProjectReference Include="../../src/Tracon.Sqlite/Tracon.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-memory configuration provider: the options tests write the configuration the container reads. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

  <!-- The due-time clock of the timeout tests, shared with the job worker's tests: linked, not copied. -->
  <ItemGroup>
    <Compile Include="../Shared/Time/ManualClock.cs" Link="Shared/Time/ManualClock.cs" />
    <!-- Wraps an interface so a test can count, hook, fail or cancel at its Nth call. -->
    <Compile Include="../Shared/Faults/FaultProxy.cs" Link="Shared/Faults/FaultProxy.cs" />
  </ItemGroup>

  <!--
    The cancellation sweep of the workflow runner and what it runs: the driver, the graphs it sweeps, the agents and the
    two-question code workflow. Linked, not copied: the two-node acceptance set runs the same sweep on PostgreSQL and
    SQL Server.
  -->
  <ItemGroup>
    <Compile Include="../Shared/Workflows/*.cs" LinkBase="Shared/Workflows" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real Microsoft Agent Framework Workflows output, captured from a genuine run. See Fixtures/README.md. -->
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
