<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Tracon.AGUI/Tracon.AGUI.csproj" />
    <!-- Fake model provider (FakeModelProvider): it records the requests that reach it, which is how a test sees the tools the model was given. -->
    <ProjectReference Include="../../src/Tracon.Testing/Tracon.Testing.csproj" />
    <!-- AGUIInputRequiredTests: an MCP server's request for user input arrives through a real MCP client. -->
    <ProjectReference Include="../../src/Tracon.Mcp/Tracon.Mcp.csproj" />
    <!-- AguiSecretCanaryTests: the run goes to a real local provider through the OpenAI client, and its records are read from SQLite. -->
    <ProjectReference Include="../../src/Tracon.OpenAI/Tracon.OpenAI.csproj" />
    <ProjectReference Include="../../src/Tracon.Sqlite/Tracon.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A real MCP server whose tools ask the user for input (the same server McpElicitationTests drives). -->
    <Compile Include="../Shared/Infrastructure/ElicitingMcpServer.cs" LinkBase="Shared" />
    <!-- Makes one member of a registered store throw while every other member keeps the real behavior (the management API's tests use it too). -->
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/FaultInjection.cs" LinkBase="Shared" />
    <!-- The secret canary: the same wire server and searches that run through the management API's host, here through the AG-UI endpoint. -->
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/CanaryWireServer.cs" LinkBase="Shared" />
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/SecretHits.cs" LinkBase="Shared" />
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/StructuredLogProbe.cs" LinkBase="Shared" />
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/LeakProbe.cs" LinkBase="Shared" />
    <Compile Include="../Tracon.AspNetCore.FunctionalTests/Infrastructure/TempSqliteDatabase.cs" LinkBase="Shared" />
    <!-- The standard fake clock: the rate limit tests freeze the wall clock and leave the host's timers real. -->
    <Compile Include="../Shared/Time/ManualClock.cs" Link="Shared/Time/ManualClock.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      TestHost, not Microsoft.AspNetCore.Mvc.Testing: Tracon is a library and has no entry point assembly. Each test
      builds its own host (same reasoning as Tracon.AspNetCore.FunctionalTests).
    -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!--
      AGUIClientCompatibilityTests: the protocol's official .NET client reads the stream. It is not a dependency of any
      shipped package.
    -->
    <PackageReference Include="AGUI.Client" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
