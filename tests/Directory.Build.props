<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    A REPRESENTATIVE set of test projects runs on every framework the packages
    ship. Today that is net10.0 alone; the set stays multi-targeted so that a
    framework added to the packages is one entry below. The rest of the tree
    stays on net10.0 only - the whole tree on every framework would multiply CI
    for projects (hosting, E2E, Docker) whose framework-specific behaviour the
    set below already covers.

    🚨 The list lives HERE, not in the csproj files. A csproj body is read AFTER
    this file, so a csproj that writes <TargetFrameworks> must also clear the
    singular <TargetFramework> assigned here; forgetting that builds net10.0
    only, silently (the mirror image of what the project templates do: they clear
    the plural when they set the singular). One list also gives
    `scripts/gate.py` a single place to read the set from.

    TraconTestTargetFrameworks is a build input. Narrow it for one run with an
    ENVIRONMENT VARIABLE (MSBuild reads environment variables as initial
    properties), so restore, build, format, and test all see the same set and
    `scripts/gate.py` - which reads the same variable - looks for the same
    output folders. A `-p:` on one command line would reach MSBuild but not the
    script.
  -->
  <PropertyGroup Label="Target framework">
    <TraconTestTargetFrameworks Condition=" '$(TraconTestTargetFrameworks)' == '' ">net10.0</TraconTestTargetFrameworks>
    <TraconMultiTargetTest Condition=" '$(MSBuildProjectName)' == 'Tracon.Core.UnitTests'
                                      Or '$(MSBuildProjectName)' == 'Tracon.Sql.Shared.UnitTests'
                                      Or '$(MSBuildProjectName)' == 'Tracon.OpenAI.UnitTests'
                                      Or '$(MSBuildProjectName)' == 'Tracon.Anthropic.UnitTests'
                                      Or '$(MSBuildProjectName)' == 'Tracon.Google.UnitTests'
                                      Or '$(MSBuildProjectName)' == 'Tracon.Azure.UnitTests'
                                      Or '$(MSBuildProjectName)' == 'Tracon.Sqlite.IntegrationTests'
                                      Or '$(MSBuildProjectName)' == 'Tracon.Testing.Contracts.Xunit.UnitTests' ">true</TraconMultiTargetTest>
    <TargetFrameworks Condition=" '$(TraconMultiTargetTest)' == 'true' ">$(TraconTestTargetFrameworks)</TargetFrameworks>
    <TargetFramework Condition=" '$(TraconMultiTargetTest)' != 'true' ">net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Suppress the warning NuGet emits for non-packable projects when `dotnet pack` runs on the solution. -->
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
    <!--
      Tracon.WorkerHarness lives under tests/ but is not a test
      project - it is the SUBJECT of the two-process failure proof, the worker
      the test kills. It sets IsTestHarnessProject=true and therefore gets none
      of the xunit/MTP wiring below.
    -->
    <IsTestProject Condition=" '$(IsTestHarnessProject)' != 'true' ">true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- XML documentation is noise in test projects; nothing requires it. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    xunit.v3 no longer runs on VSTest; it runs on the Microsoft Testing Platform (MTP).
    A test project is now a self-contained executable.
    `dotnet test` needs `global.json` `test.runner = Microsoft.Testing.Platform` (the SDK
    runs `dotnet test` with its solution and project switches in this mode) and the properties
    below to use this model; otherwise VSTest takes over and fails with "The argument ... is invalid".
    Microsoft.NET.Test.Sdk and xunit.runner.visualstudio are therefore NOT referenced.
  -->
  <PropertyGroup Label="Microsoft Testing Platform" Condition=" '$(IsTestHarnessProject)' != 'true' ">
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TestingPlatformCaptureOutput>false</TestingPlatformCaptureOutput>
  </PropertyGroup>

  <ItemGroup Condition=" '$(IsTestHarnessProject)' != 'true' ">
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Condition=" '$(TraconCoverage)' == 'true' " />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup Condition=" '$(IsTestHarnessProject)' != 'true' ">
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <!--
    The condition wait a test polls with instead of sleeping a fixed
    time (tests/Shared/Waiting/WaitUntil.cs). Linked into every test project,
    not copied - one copy replaces the private poll loops that used to
    live in each test class. The namespace is a global using so a test reaches
    for WaitUntil as readily as it used to reach for Task.Delay.
  -->
  <ItemGroup Condition=" '$(IsTestHarnessProject)' != 'true' ">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Waiting/*.cs" LinkBase="Shared/Waiting" />
    <Using Include="Tracon.Tests.Common" />
  </ItemGroup>

  <!--
    A faulted task that the host drops without observing vanishes silently
    (tests/Shared/UnobservedTasks). The guard subscribes before the first test and
    fails the assembly at its end, so a lost background failure turns a run red.
  -->
  <ItemGroup Condition=" '$(IsTestHarnessProject)' != 'true' ">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/UnobservedTasks/*.cs" LinkBase="Shared/UnobservedTasks" />
  </ItemGroup>

  <!--
    What a failed test leaves behind (tests/Shared/Evidence): a heartbeat thread that records
    how long the process and the thread pool stood still, and notes that a resource writes
    only when its test does not pass. A red run then answers "was the process stalled, what did
    the host log, where was the page" from the artifact instead of from a guess.
  -->
  <ItemGroup Condition=" '$(IsTestHarnessProject)' != 'true' ">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Evidence/*.cs" LinkBase="Shared/Evidence" />
  </ItemGroup>

  <!--
    Every multi-targeted project proves that each of its legs ran on
    the runtime it was built for. A leg rolled forward onto a newer runtime
    would pass every other test and prove nothing about its own framework.
  -->
  <ItemGroup Condition=" '$(TraconMultiTargetTest)' == 'true' ">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/TargetFramework/*.cs" LinkBase="Shared/TargetFramework" />
  </ItemGroup>

</Project>
