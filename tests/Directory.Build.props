<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Cozum uzerinde `dotnet pack` calistirildiginda paketlenmeyen projeler icin uyari uretilmesin. -->
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- Test projelerinde XML dokumantasyon araniyor olmasi gurultu yaratir. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    xunit.v3 artik VSTest degil, Microsoft Testing Platform (MTP) uzerinde calisir.
    Test projesi kendi basina calistirilabilir bir uygulamadir.
    `dotnet test` komutunun bu modeli kullanmasi icin asagidaki iki ozellik gerekir;
    aksi halde VSTest devreye girer ve "The argument ... is invalid" hatasi verir.
    Bu yuzden Microsoft.NET.Test.Sdk ve xunit.runner.visualstudio REFERANS EDILMEZ.
  -->
  <PropertyGroup Label="Microsoft Testing Platform">
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TestingPlatformCaptureOutput>false</TestingPlatformCaptureOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
