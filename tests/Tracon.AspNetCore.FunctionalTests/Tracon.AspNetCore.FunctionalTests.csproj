<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Tracon.AspNetCore/Tracon.AspNetCore.csproj" />
    <!-- ClientTenantScopeTests: proves the generated client sees the same tenant boundary a raw HTTP caller does. -->
    <ProjectReference Include="../../src/Tracon.Client/Tracon.Client.csproj" />
    <!--
      Tracon.AspNetCore is itself provider-independent (a natural
      consequence of K-008). This project tests the AspNetCore + OpenAI
      combination (real-world usage), so it references the OpenAI package
      directly.
    -->
    <ProjectReference Include="../../src/Tracon.OpenAI/Tracon.OpenAI.csproj" />
    <!--
      Phase 26: this verifies that three providers registered in the SAME
      application appear together in the /api/models output. Name collision
      and registration-order errors only surface when they are set up together.
    -->
    <ProjectReference Include="../../src/Tracon.Anthropic/Tracon.Anthropic.csproj" />
    <ProjectReference Include="../../src/Tracon.Google/Tracon.Google.csproj" />
    <ProjectReference Include="../../src/Tracon.Azure/Tracon.Azure.csproj" />
    <!--
      The workflow endpoints show two different behaviors depending on whether
      the engine is registered (run returns 501, definition management works).
      Testing both paths needs the engine package; Tracon.AspNetCore itself
      does NOT reference this package - that rule is guarded by
      DependencyDirectionTests.
    -->
    <ProjectReference Include="../../src/Tracon.Workflows/Tracon.Workflows.csproj" />
    <!-- Fake model provider (FakeModelProvider): Phase 39, rationale in K-007, section 39.1. -->
    <ProjectReference Include="../../src/Tracon.Testing/Tracon.Testing.csproj" />
    <!--
      Verifying that MapTraconMcpServer/MapTraconA2A do not crash on
      an empty (unmigrated) SQLite database needs an actual SQL provider; all
      other tests run with in-memory stores.
    -->
    <ProjectReference Include="../../src/Tracon.Sqlite/Tracon.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      TestHost is used instead of Microsoft.AspNetCore.Mvc.Testing.
      WebApplicationFactory<T> requires an ENTRY POINT assembly; Tracon is
      a library and has no such assembly. Tying the tests to a sample app would
      make library behavior depend on the sample's configuration. With
      TestHost, each test sets up its own host.
    -->
    <!--
      Phase 155: the calibrated evaluator catalog. Referenced HERE and never by a
      shipped package - a consumer who does not want the catalog carries none of
      it, and this test is what proves the bridge against the real evaluators.
    -->
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Quality" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- To verify that the OpenAPI document is actually generated. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- CVE pin; rationale in Directory.Packages.props. -->
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <!--
    🚨 The run profile, not a single flaky test. Six timing failures across four
    projects were measured in full-solution runs and every one of them passed
    in isolation: a live voice loop that missed a 60-second window, a Playwright
    click that timed out, a Native AOT publish whose compiler crashed, and
    concurrent database writers. `-maxcpucount:1` serializes the test PROJECTS
    (measured: one test process at a time) but says nothing about the threads
    INSIDE one, and xunit defaults to one per processor. This caps them, so a
    project cannot saturate the machine on its own.
  -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
