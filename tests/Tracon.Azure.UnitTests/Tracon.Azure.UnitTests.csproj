<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../../src/Tracon.Azure/Tracon.Azure.csproj" />
    <ProjectReference Include="../../src/Tracon.Testing.Contracts.Xunit/Tracon.Testing.Contracts.Xunit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-memory configuration provider for the options-from-configuration tests. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

  <!--
    The tests of src/Tracon.Providers.Shared are linked into all four
    provider test projects, so each assembly's compiled copy of the shared
    source is tested.
  -->
  <ItemGroup Label="Shared provider source tests">
    <Compile Include="../Shared/Providers/**/*.cs" LinkBase="Shared/Providers" />
  </ItemGroup>

  <!--
    The tests of src/Tracon.OpenAI.Shared are linked into both OpenAI-client test projects,
    so each assembly's compiled copy of the shared source is tested. Each project supplies its own
    Infrastructure/StrictWireHarness.cs.
  -->
  <ItemGroup Label="Shared OpenAI source tests">
    <Compile Include="../Shared/OpenAI/**/*.cs" LinkBase="Shared/OpenAI" />
  </ItemGroup>

</Project>
