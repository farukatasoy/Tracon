<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../../src/Tracon.Sqlite/Tracon.Sqlite.csproj" />
    <!--
      Store contract suite (packaged in as
      Tracon.Testing.Contracts.Xunit). The SAME abstract classes also run
      in Tracon.PostgreSql.IntegrationTests and
      Tracon.SqlServer.IntegrationTests. The third provider (SQL Server)
      passed this test: writing a new contract test was NOT REQUIRED. SQLite
      is the fourth test.
    -->
    <ProjectReference Include="../../src/Tracon.Testing.Contracts.Xunit/Tracon.Testing.Contracts.Xunit.csproj" />
  </ItemGroup>

  <!--
    A container is NOT REQUIRED: a file-based temporary database is enough.
    This shortens CI time compared to the
    PostgreSQL/SQL Server contract runs.
  -->

  <ItemGroup>
    <!-- Test-only: property-based tests (CsCheck) over the text the SQL stores bind. -->
    <PackageReference Include="CsCheck" />
  </ItemGroup>

  <ItemGroup>
    <!-- A vector store that runs the filter it is given, for the conversation memory tests. -->
    <Compile Include="../Shared/VectorStore/*.cs" LinkBase="Shared/VectorStore" />
    <!-- The differential suite: the same generated sequences and model run in every store test project. -->
    <Compile Include="../Shared/Differential/*.cs" LinkBase="Shared/Differential" />
    <!-- A clock the test moves by hand, for the registration test of the lease stores' clock. -->
    <Compile Include="../Shared/Time/ManualClock.cs" Link="Shared/Time/ManualClock.cs" />
    <!-- What a lease store that reads the application's clock does when the wall clock steps, written once. -->
    <Compile Include="../Shared/Infrastructure/LeaseWallStepContract.cs" Link="Infrastructure/Shared/LeaseWallStepContract.cs" />
    <!-- A takeover that races a release and a new reservation is never told a young reservation stands in its way. -->
    <Compile Include="../Shared/Infrastructure/SqlIdempotencyTakeoverRaceContract.cs" Link="Infrastructure/Shared/SqlIdempotencyTakeoverRaceContract.cs" />
  </ItemGroup>

  <!--
    The upgrade gate: the database of the last release, with a row in every table, moved to the migrations of the tree. The
    same source and the same rows run against every SQL provider.
  -->
  <ItemGroup>
    <Compile Include="../Shared/Upgrade/*.cs" LinkBase="Shared/Upgrade" />
    <EmbeddedResource Include="../Shared/Upgrade/UpgradeSeed.json" LogicalName="UpgradeSeed.json" LinkBase="Shared/Upgrade" />
    <EmbeddedResource Include="../Shared/Upgrade/UpgradeBaseline.json" LogicalName="UpgradeBaseline.json" LinkBase="Shared/Upgrade" />
  </ItemGroup>

</Project>
