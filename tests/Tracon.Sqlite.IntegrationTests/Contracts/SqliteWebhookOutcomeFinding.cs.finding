using Tracon.Sqlite.IntegrationTests.Infrastructure;

namespace Tracon.Sqlite.IntegrationTests.Contracts;

// FAILING PROBE, NOT COMMITTED. Rename to .cs to run it; it is red on SQLite today (and on PostgreSQL and SQL Server, which
// use the same statement shape).
// IWebhookStore.RecordSubscriptionOutcomeAsync answers "true if the subscription was disabled during this call". The SQL
// statements answer (NOT enabled) AND (failed), read after the update, so a failure recorded on a subscription that an
// administrator switched off answers true again; WebhookDeliveryJobHandler then logs "was disabled after N consecutive failed
// deliveries" for a subscription this delivery did not disable. The in-memory store answers false.
public sealed class SqliteWebhookOutcomeFindingTests(SqliteSchemaFixture schema) : IClassFixture<SqliteSchemaFixture>
{
    [Fact]
    public async Task A_failure_recorded_on_a_subscription_that_is_already_off_does_not_report_a_disable()
    {
        await schema.ResetAsync();
        var webhooks = schema.Context.Webhooks;
        var now = new DateTimeOffset(2026, 11, 4, 9, 0, 0, TimeSpan.Zero);

        var subscription = await webhooks.SaveSubscriptionAsync(new WebhookSubscription
        {
            Id = Guid.NewGuid(),
            TenantId = "default",
            Name = "orders",
            Url = "https://example.com/hook",
            Events = ["run.completed"],
            Enabled = false,
            CreatedAt = now,
            UpdatedAt = now,
        });

        // The threshold is far away: this call switches nothing off, because the subscription was off before it.
        (await webhooks.RecordSubscriptionOutcomeAsync(subscription.Id, succeeded: false, disableThreshold: 100, now)).ShouldBeFalse();
    }
}
