<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      All three SQL providers, directly, not via Tracon.Sql.Shared (it has
      no csproj of its own). The text-fidelity and completeness checks in
      this project read the SqlQueriesBase-derived types by their concrete
      provider name; no cross-assembly type unification is needed (the earlier decision does
      not apply here). No Docker/Testcontainers dependency: every check here
      builds a query-set object in memory and never opens a connection.
    -->
    <ProjectReference Include="../../src/Tracon.PostgreSql/Tracon.PostgreSql.csproj" />
    <ProjectReference Include="../../src/Tracon.SqlServer/Tracon.SqlServer.csproj" />
    <ProjectReference Include="../../src/Tracon.Sqlite/Tracon.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-memory configuration provider for the unreadable-value tests. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

  <!--
    The upgrade gate's data: the manifest of the last release and the rows its database is filled with. This project reads them
    as text (no database); the three provider projects run the gate itself over the same files.
  -->
  <ItemGroup>
    <Compile Include="../Shared/Upgrade/UpgradeSeed.cs" LinkBase="Shared/Upgrade" />
    <Compile Include="../Shared/Upgrade/UpgradeBaseline.cs" LinkBase="Shared/Upgrade" />
    <EmbeddedResource Include="../Shared/Upgrade/UpgradeSeed.json" LogicalName="UpgradeSeed.json" LinkBase="Shared/Upgrade" />
    <EmbeddedResource Include="../Shared/Upgrade/UpgradeBaseline.json" LogicalName="UpgradeBaseline.json" LinkBase="Shared/Upgrade" />
  </ItemGroup>

</Project>
