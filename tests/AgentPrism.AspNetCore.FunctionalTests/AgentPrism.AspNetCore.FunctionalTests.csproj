<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AgentPrism.AspNetCore/AgentPrism.AspNetCore.csproj" />
    <!-- ClientTenantScopeTests: proves the generated client sees the same tenant boundary a raw HTTP caller does. -->
    <ProjectReference Include="../../src/AgentPrism.Client/AgentPrism.Client.csproj" />
    <!--
      AgentPrism.AspNetCore is itself provider-independent (a natural
      consequence of K-008). This project tests the AspNetCore + OpenAI
      combination (real-world usage), so it references the OpenAI package
      directly.
    -->
    <ProjectReference Include="../../src/AgentPrism.OpenAI/AgentPrism.OpenAI.csproj" />
    <!--
      Phase 26: this verifies that three providers registered in the SAME
      application appear together in the /api/models output. Name collision
      and registration-order errors only surface when they are set up together.
    -->
    <ProjectReference Include="../../src/AgentPrism.Anthropic/AgentPrism.Anthropic.csproj" />
    <ProjectReference Include="../../src/AgentPrism.Google/AgentPrism.Google.csproj" />
    <ProjectReference Include="../../src/AgentPrism.Azure/AgentPrism.Azure.csproj" />
    <!--
      The workflow endpoints show two different behaviors depending on whether
      the engine is registered (run returns 501, definition management works).
      Testing both paths needs the engine package; AgentPrism.AspNetCore itself
      does NOT reference this package - that rule is guarded by
      DependencyDirectionTests.
    -->
    <ProjectReference Include="../../src/AgentPrism.Workflows/AgentPrism.Workflows.csproj" />
    <!-- Fake model provider (FakeModelProvider): Phase 39, rationale in K-007, section 39.1. -->
    <ProjectReference Include="../../src/AgentPrism.Testing/AgentPrism.Testing.csproj" />
    <!--
      Verifying that MapAgentPrismMcpServer/MapAgentPrismA2A do not crash on
      an empty (unmigrated) SQLite database needs an actual SQL provider; all
      other tests run with in-memory stores.
    -->
    <ProjectReference Include="../../src/AgentPrism.Sqlite/AgentPrism.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      TestHost is used instead of Microsoft.AspNetCore.Mvc.Testing.
      WebApplicationFactory<T> requires an ENTRY POINT assembly; AgentPrism is
      a library and has no such assembly. Tying the tests to a sample app would
      make library behavior depend on the sample's configuration. With
      TestHost, each test sets up its own host.
    -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- To verify that the OpenAPI document is actually generated. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- CVE pin; rationale in Directory.Packages.props. -->
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>

</Project>
