      baglamak, kutuphane davranisini ornegin yapilandirmasina bagimli kilardi.
      TestHost ile her test kendi barindiricisini kurar.
    -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- OpenAPI belgesinin gercekten uretildigini dogrulamak icin. -->
