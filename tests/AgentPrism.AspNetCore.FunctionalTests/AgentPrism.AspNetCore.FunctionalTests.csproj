<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AgentPrism.AspNetCore/AgentPrism.AspNetCore.csproj" />
    <!--
      AgentPrism.AspNetCore kendisi saglayicidan bagimsizdir (K-008'in doganal
      sonucu). Bu proje AspNetCore + OpenAI birlesimini (gercek dunya kullanimi)
      test ettigi icin OpenAI paketini dogrudan referans eder.
    -->
    <ProjectReference Include="../../src/AgentPrism.OpenAI/AgentPrism.OpenAI.csproj" />
    <!--
      Faz 26: uc saglayicinin AYNI uygulamada kayitli olmasi ve /api/models
      ciktisinda birlikte gorunmesi burada dogrulanir. Ad cakismasi ve kayit
      sirasi hatalari yalnizca birlikte kurulunca ortaya cikar.
    -->
    <ProjectReference Include="../../src/AgentPrism.Anthropic/AgentPrism.Anthropic.csproj" />
    <ProjectReference Include="../../src/AgentPrism.Google/AgentPrism.Google.csproj" />
    <ProjectReference Include="../../src/AgentPrism.Azure/AgentPrism.Azure.csproj" />
    <!--
      Workflow uclari, motor kayitli VE kayitsizken iki farkli davranis gosterir
      (calistirma 501 doner, tanim yonetimi calisir). Iki yolu da test etmek icin
      motor paketine ihtiyac var; AgentPrism.AspNetCore'un kendisi bu pakete
      referans VERMEZ - kural DependencyDirectionTests ile korunur.
    -->
    <ProjectReference Include="../../src/AgentPrism.Workflows/AgentPrism.Workflows.csproj" />
    <!-- Sahte model saglayicisi (FakeModelProvider): Faz 39, K-007 gerekcesi bolum 39.1. -->
    <ProjectReference Include="../../src/AgentPrism.Testing/AgentPrism.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.AspNetCore.Mvc.Testing yerine TestHost kullaniliyor.
      WebApplicationFactory<T> bir GIRIS NOKTASI derlemesi ister; AgentPrism bir
      kutuphanedir ve boyle bir derlemesi yoktur. Testleri ornek uygulamaya
      baglamak, kutuphane davranisini ornegin yapilandirmasina bagimli kilardi.
      TestHost ile her test kendi barindiricisini kurar.
    -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- OpenAPI belgesinin gercekten uretildigini dogrulamak icin. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- CVE zorlamasi; gerekce Directory.Packages.props icinde. -->
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>

</Project>
