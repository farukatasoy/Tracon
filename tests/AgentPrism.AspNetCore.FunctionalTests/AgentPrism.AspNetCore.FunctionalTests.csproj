  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AgentPrism.AspNetCore/AgentPrism.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.AspNetCore.Mvc.Testing yerine TestHost kullaniliyor.
      WebApplicationFactory<T> bir GIRIS NOKTASI derlemesi ister; AgentPrism bir
