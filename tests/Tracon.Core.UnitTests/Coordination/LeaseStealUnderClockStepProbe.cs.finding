using Tracon.Core.UnitTests.Fakes;

namespace Tracon.Core.UnitTests.Coordination;

/// <summary>
/// PROBE, not a gate: measures what two single-executor guards believe when the clock the lease STORE reads is stepped
/// forward past the lease while the owner's own monotonic clock did not move. A store that reads the application's clock
/// (the in-memory store, and SQLite whose file is used by one process) sees a live lease as expired once that clock steps
/// ahead, and the other guard takes it. The PostgreSQL and SQL Server stores read the database server's clock inside the
/// lease statements, so a step of a node's wall clock no longer reaches their leases (the clock-skew contract has those
/// scenarios); this probe stays for the stores that still read the application's clock.
/// </summary>
public sealed class LeaseStealUnderClockStepProbe
{
    [Fact]
    public async Task A_store_clock_stepped_past_the_lease_lets_a_second_guard_take_it_while_the_owner_still_holds_it()
    {
        var ownerClock = new ManualTimeProvider(new DateTimeOffset(2026, 1, 1, 0, 0, 0, TimeSpan.Zero));
        var storeClock = new ManualTimeProvider(new DateTimeOffset(2026, 1, 1, 0, 0, 0, TimeSpan.Zero));
        var store = new InMemorySingletonLeaseStore(storeClock);
        var options = new StaticOptionsMonitor<SingletonExecutionOptions>(new SingletonExecutionOptions
        {
            Enabled = true,
            LeaseDuration = TimeSpan.FromSeconds(30),
        });

        var owner = new SingletonGuard(store, options, "probe", timeProvider: ownerClock);
        var other = new SingletonGuard(store, options, "probe", timeProvider: new ManualTimeProvider());

        await owner.TickAsync(TestContext.Current.CancellationToken);
        await other.TickAsync(TestContext.Current.CancellationToken);

        owner.IsHeld.ShouldBeTrue();
        other.IsHeld.ShouldBeFalse("the lease is live on every clock");

        // The clock the store reads goes an hour ahead (as a node whose clock runs an hour fast would read it).
        storeClock.StepWallClock(TimeSpan.FromHours(1));
        await other.TickAsync(TestContext.Current.CancellationToken);

        // Measured: both believe they are the executor until the owner's next renewal fails.
        (owner.IsHeld && other.IsHeld).ShouldBeTrue();
    }
}
