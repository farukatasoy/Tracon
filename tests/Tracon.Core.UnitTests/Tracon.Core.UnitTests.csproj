<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../../src/Tracon.Core/Tracon.Core.csproj" />
    <ProjectReference Include="../../src/Tracon.Testing.Contracts.Xunit/Tracon.Testing.Contracts.Xunit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Test-only: verifying that the Tracon:ContentGuard section actually
      binds requires an IConfiguration instance. Tracon.Core depends only
      on Configuration.Abstractions and must stay that way.
    -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Test-only (phase 237): RequiredMemberScanner reads the `required` members out of the C# source, so the
      snapshot the release rehearsal compares with the baseline tag can be checked against the code.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Test-only (phase 233): a REAL vector store connector, so the filters conversation memory builds
      are translated by a connector and not only run by the test double.
    -->
    <PackageReference Include="CommunityToolkit.VectorData.InMemory" />
  </ItemGroup>

  <!--
    The package set, read from src/*/*.csproj by the same helper the release
    artifact facts use (linked, not copied - K-411): the startup alignment check
    carries a fixed list of family assembly names and a test keeps it in step.
  -->
  <ItemGroup>
    <Compile Include="../Shared/Infrastructure/RepoRoot.cs" Link="Infrastructure/Shared/RepoRoot.cs" />
    <Compile Include="../Shared/Infrastructure/PackableProjects.cs" Link="Infrastructure/Shared/PackableProjects.cs" />
    <!-- The due-time clock the job worker's poll and deadline tests advance (phase 196). -->
    <Compile Include="../Shared/Time/ManualClock.cs" Link="Shared/Time/ManualClock.cs" />
    <!-- A vector store that runs the filter it is given, for the conversation memory tests (phase 233). -->
    <Compile Include="../Shared/VectorStore/*.cs" LinkBase="Shared/VectorStore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real Microsoft Agent Framework output, captured from a genuine run (Phase 126). See Fixtures/README.md. -->
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Store contract suite (Phase 23; packaged in Phase 98 as
    Tracon.Testing.Contracts.Xunit), in-memory side only. The same
    abstract classes also run in Tracon.PostgreSql.IntegrationTests and
    Tracon.SqlServer.IntegrationTests against their real backends;
    running them here too, from a project with no [assembly: AssemblyFixture]
    and no Testcontainers dependency, means the in-memory store — the
    default a consumer gets when they add no persistence package — is
    verified on a machine with no Docker. TenantCoverageTests (now in
    Tracon.SqlServer.IntegrationTests) reflects over SqlRunStore, a type
    this project does not reference, and never ran here.
  -->

</Project>
