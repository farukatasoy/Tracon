<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../../src/Tracon.SqlServer/Tracon.SqlServer.csproj" />
    <!--
      Store contract suite (packaged in as
      Tracon.Testing.Contracts.Xunit). The SAME abstract classes also run
      in Tracon.PostgreSql.IntegrationTests. this change's exact test was
      that: adding a third persistence implementation should NOT REQUIRE
      writing a new contract test.
    -->
    <ProjectReference Include="../../src/Tracon.Testing.Contracts.Xunit/Tracon.Testing.Contracts.Xunit.csproj" />
  </ItemGroup>

  <!--
    The two-process failure proof starts tests/Tracon.WorkerHarness as a real, separate host and kills it,
    on SQL Server as it already does on PostgreSQL. ReferenceOutputAssembly=false for the reason the PostgreSQL project
    gives: the harness is a SUBJECT, not a library.
  -->
  <ItemGroup>
    <ProjectReference Include="../Tracon.WorkerHarness/Tracon.WorkerHarness.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Shared process infrastructure. Linked, not copied. -->
  <ItemGroup>
    <Compile Include="../Shared/Infrastructure/ProcessResult.cs" Link="Infrastructure/Shared/ProcessResult.cs" />
    <Compile Include="../Shared/Infrastructure/ProcessRunner.cs" Link="Infrastructure/Shared/ProcessRunner.cs" />
    <Compile Include="../Shared/Infrastructure/ManagedProcess.cs" Link="Infrastructure/Shared/ManagedProcess.cs" />
    <Compile Include="../Shared/Infrastructure/RepoRoot.cs" Link="Infrastructure/Shared/RepoRoot.cs" />
    <Compile Include="../Shared/Infrastructure/WorkerProcessHost.cs" Link="Infrastructure/Shared/WorkerProcessHost.cs" />
    <Compile Include="../Shared/Infrastructure/WorkerHarnessContract.cs" Link="Infrastructure/Shared/WorkerHarnessContract.cs" />
    <Compile Include="../Shared/Infrastructure/HarnessExecutionLog.cs" Link="Infrastructure/Shared/HarnessExecutionLog.cs" />
    <Compile Include="../Shared/Infrastructure/TwoProcessLeaseTakeoverContract.cs" Link="Infrastructure/Shared/TwoProcessLeaseTakeoverContract.cs" />
    <!-- The clock-skew measurement of the lease stores, written once for both SQL providers; it moves a clock by hand. -->
    <Compile Include="../Shared/Infrastructure/SqlLeaseUnderClockSkewContract.cs" Link="Infrastructure/Shared/SqlLeaseUnderClockSkewContract.cs" />
    <!-- Points the lease statements at a clock the differential job sequences can move. -->
    <Compile Include="../Shared/Infrastructure/SqlLeaseClockStandIn.cs" Link="Infrastructure/Shared/SqlLeaseClockStandIn.cs" />
    <!-- How the lease stores write a lease's end on the server's clock, and read what an older version wrote. -->
    <Compile Include="../Shared/Infrastructure/SqlLeaseTimeContract.cs" Link="Infrastructure/Shared/SqlLeaseTimeContract.cs" />
    <!-- A run that keeps its heartbeat is not closed as orphaned by a node whose clock runs ahead. -->
    <Compile Include="../Shared/Infrastructure/RunHeartbeatUnderClockSkewContract.cs" Link="Infrastructure/Shared/RunHeartbeatUnderClockSkewContract.cs" />
    <!-- A takeover that races a release and a new reservation is never told a young reservation stands in its way. -->
    <Compile Include="../Shared/Infrastructure/SqlIdempotencyTakeoverRaceContract.cs" Link="Infrastructure/Shared/SqlIdempotencyTakeoverRaceContract.cs" />
    <Compile Include="../Shared/Infrastructure/SqlUpsertSameNewKeyRaceContract.cs" Link="Infrastructure/Shared/SqlUpsertSameNewKeyRaceContract.cs" />
    <!-- A stream over a connection with a round trip: written one chunk at a time, and in groups. -->
    <Compile Include="../Shared/Infrastructure/DeltaStreamOverLatency.cs" Link="Infrastructure/Shared/DeltaStreamOverLatency.cs" />
    <Compile Include="../Shared/Time/ManualClock.cs" Link="Infrastructure/Shared/ManualClock.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test-only: the differential suite generates its sequences with CsCheck. -->
    <PackageReference Include="CsCheck" />
    <!-- The differential suite: the same generated sequences and model run in every store test project. -->
    <Compile Include="../Shared/Differential/*.cs" LinkBase="Shared/Differential" />
  </ItemGroup>

  <!--
    TenantCoverageTests.cs lives directly in this project, not
    under the contract package: it reflects over Tracon.Sql.Shared's
    linked-source internal types (SqlRunStore and the rest), which are only
    reachable from a provider assembly, never from a published package
    (a linked-source internal type's identity is not stable across
    assemblies).
  -->

  <!--
    The upgrade gate: the database of the last release, with a row in every table, moved to the migrations of the tree. The
    same source and the same rows run against every SQL provider.
  -->
  <ItemGroup>
    <Compile Include="../Shared/Upgrade/*.cs" LinkBase="Shared/Upgrade" />
    <EmbeddedResource Include="../Shared/Upgrade/UpgradeSeed.json" LogicalName="UpgradeSeed.json" LinkBase="Shared/Upgrade" />
    <EmbeddedResource Include="../Shared/Upgrade/UpgradeBaseline.json" LogicalName="UpgradeBaseline.json" LinkBase="Shared/Upgrade" />
  </ItemGroup>

</Project>
