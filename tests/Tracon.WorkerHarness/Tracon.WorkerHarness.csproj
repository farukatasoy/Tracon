<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 157. NOT a test project: it is the SUBJECT of the two-process
    failure proof, the worker that gets killed. `IsTestHarnessProject` opts it
    out of the xunit/MTP wiring in tests/Directory.Build.props; it still lives
    under tests/ because nothing outside the test suite ever runs it and it
    must never be packed or shipped.
  -->
  <PropertyGroup>
    <IsTestHarnessProject>true</IsTestHarnessProject>
    <!--
      🚨 Explicitly false, not merely unset. `dotnet test Tracon.slnx`
      otherwise hands this executable to VSTest, which aborts the WHOLE run
      with "testhost.dll was not found" - measured. The project is built by the
      suite (the integration tests reference it) and started by it, but it is
      never a test host itself.
    -->
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <OutputType>Exe</OutputType>
    <RootNamespace>Tracon.WorkerHarness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Tracon.PostgreSql/Tracon.PostgreSql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <!-- The names this process and the test that starts it agree on. Linked, not copied. -->
  <ItemGroup>
    <Compile Include="../Shared/Infrastructure/WorkerHarnessContract.cs" Link="Shared/WorkerHarnessContract.cs" />
    <Compile Include="../Shared/Infrastructure/HarnessExecutionLog.cs" Link="Shared/HarnessExecutionLog.cs" />
  </ItemGroup>

</Project>
