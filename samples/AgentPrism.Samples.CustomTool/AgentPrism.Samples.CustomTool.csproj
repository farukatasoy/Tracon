<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AgentPrism.Samples.CustomTool</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Package references, not source-project references: this sample is a
      third-party tool author. AgentPrism.Core carries the tool generator in
      its analyzer folder, so this one reference supports both a hand-built
      AIFunction and [AgentPrismTool] source generation.
    -->
    <PackageReference Include="AgentPrism.Core" VersionOverride="$(AgentPrismSamplePackageVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
