<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Scoped to samples/: AgentPrism.Samples.FileRunStore(.Tests) takes
    AgentPrism.* by PackageReference, not ProjectReference (the whole point
    of that sample, see its own csproj), and a preview build is never
    published to nuget.org. `dotnet pack AgentPrism.src.slnf` (or
    `python3 scripts/kapi.py yayin` with the dry-run flag) writes every AgentPrism.*
    package here first; restore then resolves AgentPrism.* from that local
    feed and everything else from nuget.org, same as the root config.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="agentprism-local" value="../artifacts/package/release" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="agentprism-local">
      <package pattern="AgentPrism*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
