<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Scoped to samples/: Tracon.Samples.FileRunStore(.Tests) takes
    Tracon.* by PackageReference, not ProjectReference (the whole point
    of that sample, see its own csproj). Release validation consumes the
    packages built from the current commit instead of a previously published
    version. `dotnet pack Tracon.src.slnf` (or `python3 scripts/kapi.py yayin`
    with the dry-run flag) writes every Tracon.* package here first; restore
    then resolves Tracon.* from that local feed and everything else from
    nuget.org, same as the root config.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="tracon-local" value="../artifacts/package/release" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="tracon-local">
      <package pattern="Tracon*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
