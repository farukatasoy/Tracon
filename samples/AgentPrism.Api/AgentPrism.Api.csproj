<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>AgentPrism.Api</RootNamespace>
    <UserSecretsId>agentprism-sample-api</UserSecretsId>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AgentPrism/AgentPrism.csproj" />
    <!--
      🚨 Yalniz bu REPO icin gerekli. `OutputItemType=Analyzer`, coklu-sicrama
      ProjectReference zincirlerinde (Api -> AgentPrism -> Core -> Generators)
      YAYILMAZ - olculdu, AddGeneratedTools() bu satir olmadan CS1061 verir.
      NuGet'in analyzers/dotnet/cs YAYILIMI yalniz PAKET tuketiminde (PackageReference)
      gecerlidir; gercek bir dis tuketici yalniz `AgentPrism.Core`'u PackageReference
      ile alir ve bu satira ihtiyac duymaz. Bkz. docs/52-KAYNAK-URETECI.md.
    -->
    <ProjectReference Include="../../src/AgentPrism.Generators/AgentPrism.Generators.csproj"
                       PrivateAssets="all"
                       ReferenceOutputAssembly="false"
                       OutputItemType="Analyzer" />
    <!--
      SQL Server ve SQLite meta pakete DAHIL DEGILDIR: her tuketici
      Microsoft.Data.SqlClient/SQLitePCLRaw cekmek zorunda kalmasin diye
      (K-185, aynisi SQLite icin de gecerlidir). Kullanmak isteyen acikca
      referans verir; ornek uygulama uc saglayiciyi da gosterebilmek icin verir.
    -->
    <ProjectReference Include="../../src/AgentPrism.SqlServer/AgentPrism.SqlServer.csproj" />
    <ProjectReference Include="../../src/AgentPrism.Sqlite/AgentPrism.Sqlite.csproj" />
    <!--
      Anthropic ve Google saglayicilari da meta pakete DAHIL DEGILDIR (K-185
      deseni): OpenAI kullanan bir tuketici Anthropic SDK'sini, Gemini kullanmayan
      bir tuketici Google.Apis.Auth zincirini cekmek zorunda kalmamalidir. Ornek
      uygulama uc saglayiciyi birlikte gosterebilmek icin acikca referans verir.
    -->
    <ProjectReference Include="../../src/AgentPrism.Anthropic/AgentPrism.Anthropic.csproj" />
    <ProjectReference Include="../../src/AgentPrism.Google/AgentPrism.Google.csproj" />
    <ProjectReference Include="../../src/AgentPrism.Azure/AgentPrism.Azure.csproj" />
    <!-- Ses tool'lari (Faz 28). Meta pakete dahil DEGILDIR; acikca referans verilir. -->
    <ProjectReference Include="../../src/AgentPrism.Voice/AgentPrism.Voice.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      OpenAPI belgesi TUKETICININ tercihidir. AgentPrism.AspNetCore bu pakete
      bagimli degildir; uclar paylasilan cerceveden gelen ustveriyi tasir ve
      AddOpenApi() cagrildiginda belgede kendiliginden gorunur.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- CVE zorlamasi; gerekce Directory.Packages.props icinde. -->
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>

  <!--
    🚨 F-76 (olculdu 2026-08-08). AgentPrism.Sql.Shared bir PAKET DEGILDIR; ayni
    kaynak uc derlemeye LinkBase ile baglanir (K-185). Uc derlemenin XML dokuman
    dosyasi bu yuzden AYNI kimlikleri tasir - olculdu: SqlServer ile Sqlite
    arasinda 620 ortak <member> kimligi, ilki `T:AgentPrism.MigrationRunner`.

    Microsoft.AspNetCore.OpenApi'nin GenerateAdditionalXmlFilesForOpenApi hedefi
    (build/Microsoft.AspNetCore.OpenApi.targets) her ProjectReference'in .xml
    dosyasini AdditionalFiles'a ekler; XmlCommentGenerator hepsini TEK bir
    sozlukte toplar ve ikinci ayni kimlikte `ArgumentException` firlatir.
    Sonuc: /openapi/v1.json 500 doner.

    🚨 KAPSAM OLCULDU: hedefin kosulu `ReferenceSourceTarget == 'ProjectReference'`.
    Bu ornekte 15 ProjectReference, 368 ResolveAssemblyReference olculdu; NuGet
    paketleriyle gelen derlemelerin XML'i HIC eklenmez. Gercek bir PackageReference
    tuketicisi (AgentPrism + SqlServer + Sqlite + AddOpenApi) ucdan uca denendi ve
    HTTP 200 dondu. Yani hata YALNIZ kaynaktan derleyen (ProjectReference) tuketiciyi
    etkiler - bu ornek uygulama dahil.

    Cozum: cakisan paylasilan kaynagin dokumanini TEK derlemede birak. SQL saglayici
    tiplerinin hicbiri HTTP sozlesmesinde gorunmez, dolayisiyla belgeden hicbir sey
    kaybolmaz. PostgreSql kanonik olarak kalir.
    Gerekce ve olcum: docs/KARARLAR.md K-352, docs/40-OPENAPI-YAYINI.md.
  -->
  <Target Name="AgentPrismRemoveDuplicateSqlXmlDocs"
          AfterTargets="GenerateAdditionalXmlFilesForOpenApi">
    <ItemGroup>
      <AdditionalFiles Remove="@(AdditionalFiles)"
                       Condition="'%(AdditionalFiles.Filename)' == 'AgentPrism.SqlServer' OR
                                  '%(AdditionalFiles.Filename)' == 'AgentPrism.Sqlite'" />
    </ItemGroup>
  </Target>

</Project>
