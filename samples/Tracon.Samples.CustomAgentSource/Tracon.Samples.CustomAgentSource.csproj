<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Tracon.Samples.CustomAgentSource</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      A NuGet PackageReference, not a project-to-project reference: this sample proves
      a definition source is implementable from published packages alone. Tracon.Abstractions
      is enough, because the source only hands back an AgentDefinition: Tracon compiles it, so
      the sample needs neither the compiler nor the compiled-agent cache that live in
      Tracon.Core.
      VersionOverride (not Version): Central Package Management pins every OTHER
      Tracon.* dependency in this repo to an exact source-linkage-implied
      version; this one package instead floats to whatever prerelease the local
      feed holds (the convention) - see../NuGet.config, which points
      Tracon.* resolution at the local feed `dotnet pack` produces
      (artifacts/package/release) instead of nuget.org, where a preview build is
      never published.
    -->
    <PackageReference Include="Tracon.Abstractions" VersionOverride="$(TraconSamplePackageVersion)" />
  </ItemGroup>

</Project>
